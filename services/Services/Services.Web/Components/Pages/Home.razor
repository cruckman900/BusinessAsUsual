@page "/services"
@page "/services/dashboard"
@using global::Services.Application.Services
@using System.Net.Http.Json
@using MudBlazor
@inject NavigationManager Navigation
@inject IServiceService ServiceService

<PageTitle>Services Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Services</MudText>
    </div>

    <MudText Typo="Typo.h4" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.RoomService" Class="mr-2" />
        Services Dashboard
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
        Manage service offerings, appointments, and providers
    </MudText>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
        <MudText Class="mt-2">Loading dashboard data...</MudText>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
            <MudText>@_errorMessage</MudText>
            <MudText Class="mt-2">Please ensure Services.API is running and accessible.</MudText>
        </MudAlert>
    }
    else if (_summary != null)
    {
        <!-- Insight Cards Row -->
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Total Services</MudText>
                                <MudText Typo="Typo.h5">@_summary.TotalServices</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.MiscellaneousServices" Size="Size.Large" Color="Color.Primary" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Active Services</MudText>
                                <MudText Typo="Typo.h5">@_summary.ActiveServices</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Avg. Service Price</MudText>
                                <MudText Typo="Typo.h5">@_summary.AveragePrice.ToString("C")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Large" Color="Color.Info" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Total Revenue Potential</MudText>
                                <MudText Typo="Typo.h5">@_summary.TotalRevenuePotential.ToString("C0")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" Color="Color.Tertiary" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Submodule Navigation Cards -->
        <MudGrid Spacing="3" Class="mb-6 mt-6">
            <MudItem xs="12">
                <MudText Typo="Typo.h5" Class="mb-4">Service Management</MudText>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="mud-card-hover d-flex flex-column" Style="height: 100%;">
                    <MudCardContent Class="text-center pa-6 flex-grow-1">
                        <MudIcon Icon="@Icons.Material.Filled.MiscellaneousServices" Size="Size.Large" Color="Color.Primary" Class="mb-4" />
                        <MudText Typo="Typo.h6" GutterBottom="true">Service Catalog</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                            Manage service offerings, pricing, and availability
                        </MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@(_summary is not null ? _summary.ActiveServices.ToString() : "0") Active</MudChip>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Href="/services/list">
                            Manage Services →
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="d-flex flex-column" Style="height: 100%;" Elevation="1">
                    <MudCardContent Class="text-center pa-6 flex-grow-1">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Large" Color="Color.Default" Class="mb-4" />
                        <MudText Typo="Typo.h6" GutterBottom="true" Color="Color.Secondary">Appointments</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                            Schedule and manage service appointments
                        </MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Coming Soon</MudChip>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Disabled="true">
                            Coming Soon
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="d-flex flex-column" Style="height: 100%;" Elevation="1">
                    <MudCardContent Class="text-center pa-6 flex-grow-1">
                        <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Large" Color="Color.Default" Class="mb-4" />
                        <MudText Typo="Typo.h6" GutterBottom="true" Color="Color.Secondary">Service Providers</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                            Manage the people or teams who deliver your services
                        </MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Coming Soon</MudChip>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Disabled="true">
                            Coming Soon
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Quick Actions + Alerts Grid -->
        <MudGrid Class="mt-6">
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Quick Actions</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudStack Spacing="2">
                            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" Href="/services/create" FullWidth="true" Class="justify-start">
                                Create New Service
                            </MudButton>
                            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.CalendarMonth" Disabled="true" FullWidth="true" Class="justify-start">
                                Schedule Appointment
                            </MudButton>
                            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.PersonAdd" Disabled="true" FullWidth="true" Class="justify-start">
                                Add Service Provider
                            </MudButton>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Alerts & Notifications</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_summary.ActiveServices == 0)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mb-2">
                                <MudText>No active services configured. Start by creating your first service.</MudText>
                            </MudAlert>
                        }
                        else if (_summary.ActiveServices > 0)
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Filled">
                                <MudText>@_summary.ActiveServices active services available for booking</MudText>
                            </MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- About & Module Info Grid -->
        <MudGrid Class="mt-6">
            <MudItem xs="12" md="8">
                <MudPaper Class="pa-4 d-flex flex-column" Elevation="1" Style="height: 100%;">
                    <MudText Typo="Typo.h6" GutterBottom="true">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                        About Services Module
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-4">
                        The Services module provides comprehensive service management capabilities including:
                    </MudText>
                    <MudList T="string" Dense="true">
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                            <strong>Service Catalog</strong> - Manage service offerings, pricing, and availability
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                            <strong>Appointments</strong> - Schedule and track service appointments (Coming Soon)
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                            <strong>Service Providers</strong> - Manage staff and teams who deliver services (Coming Soon)
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                            <strong>Booking Management</strong> - Handle customer bookings and scheduling (Planned)
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                            <strong>Revenue Tracking</strong> - Monitor service revenue and performance (Planned)
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                            <strong>Reporting &amp; Analytics</strong> - Service usage and revenue reporting (Planned)
                        </MudListItem>
                    </MudList>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-auto pt-4">
                        This module is dynamically loaded via the Module Registry Service and provides both web UI and mobile API contracts.
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4 d-flex flex-column" Elevation="1" Style="height: 100%;">
                    <MudText Typo="Typo.h6" GutterBottom="true">
                        <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />
                        Module Info
                    </MudText>
                    <MudStack Spacing="2" Class="flex-grow-1">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Module ID</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">services</MudChip>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Version</MudText>
                            <MudText Typo="Typo.body2">1.0.0</MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">API Port</MudText>
                            <MudText Typo="Typo.body2">7286 (HTTP) / 7285 (HTTPS)</MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Web UI Port</MudText>
                            <MudText Typo="Typo.body2">5009</MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Mobile Support</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Yes</MudChip>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Active</MudChip>
                        </div>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

<style>
    .mud-card-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .mud-card-hover:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15) !important;
    }
</style>

@code {
    private bool _loading = true;
    private string? _errorMessage;
    private ServicesSummaryDto? _summary;

    protected override async Task OnInitializedAsync()
    {
        await LoadSummaryAsync();
    }

    private async Task LoadSummaryAsync()
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(2));
            var servicesResult = await ServiceService.GetAllServicesAsync();
            var services = servicesResult.ToList();

            if (services != null)
            {
                _summary = new ServicesSummaryDto
                {
                    TotalServices = services.Count,
                    ActiveServices = services.Count(s => s.IsActive),
                    AveragePrice = services.Any() ? services.Average(s => s.BasePrice) : 0,
                    TotalRevenuePotential = services.Where(s => s.IsActive).Sum(s => s.BasePrice)
                };
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load dashboard data: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }

    private class ServicesSummaryDto
    {
        public int TotalServices { get; set; }
        public int ActiveServices { get; set; }
        public decimal AveragePrice { get; set; }
        public decimal TotalRevenuePotential { get; set; }
    }

    private class ServiceDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public decimal BasePrice { get; set; }
        public bool IsActive { get; set; }
    }
}
