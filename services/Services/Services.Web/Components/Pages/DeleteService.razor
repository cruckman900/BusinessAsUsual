@page "/services/delete/{Id:guid}"
@using global::Services.Application.DTOs
@using System.Net.Http.Json
@using MudBlazor
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject MudBlazor.ISnackbar Snackbar

<PageTitle>Delete Service</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/services">Services</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/services/list">Service Catalog</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Delete</MudText>
    </div>

    @if (service == null)
    {
        <div class="d-flex justify-center align-center" style="min-height: 400px;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h4" GutterBottom="true" Color="Color.Error">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" />
                Delete Service
            </MudText>

            <MudAlert Severity="Severity.Warning" Class="my-4">
                Are you sure you want to delete this service? This action cannot be undone.
            </MudAlert>

            <MudGrid Class="my-4">
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Service Name</MudText>
                    <MudText Typo="Typo.body1"><strong>@service.Name</strong></MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Description</MudText>
                    <MudText Typo="Typo.body1">@service.Description</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Base Price</MudText>
                    <MudText Typo="Typo.body1">@service.BasePrice.ToString("C")</MudText>
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-end mt-4">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="@Cancel" Class="mr-2">
                    Cancel
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDelete" StartIcon="@Icons.Material.Filled.Delete">
                    Delete Service
                </MudButton>
            </div>
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter] public Guid Id { get; set; }
    private ServiceDto? service;

    protected override async Task OnInitializedAsync()
    {
        var client = HttpClientFactory.CreateClient("ServicesApi");
        service = await client.GetFromJsonAsync<ServiceDto>($"api/services/{Id}");
    }

    private async Task ConfirmDelete()
    {
        var client = HttpClientFactory.CreateClient("ServicesApi");
        var res = await client.DeleteAsync($"api/services/{Id}");
        if (res.IsSuccessStatusCode)
        {
            Snackbar.Add("Service deleted successfully", Severity.Success);
            Navigation.NavigateTo("/services/list");
        }
        else
        {
            Snackbar.Add($"Delete failed: {res.StatusCode}", Severity.Error);
        }
    }

    private void Cancel() => Navigation.NavigateTo("/services/list");
}
