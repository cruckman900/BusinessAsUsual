@page "/services"
@using global::Services.Application.DTOs
@using System.Net.Http.Json
@using MudBlazor
@using BusinessAsUsual.Modules.Services.Web.Shared
@inject System.Net.Http.HttpClient Http
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation

<h3>Services</h3>

<p>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@GoToCreate">New Service</MudButton>
</p>

@if (services is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <CustomDataGrid TItem="ServiceDto" Items="services" RowsPerPage="10" SearchPlaceholder="Search services...">
        <ChildContent>
            <PropertyColumn Property="x => x.Name" Title="Name" T="ServiceDto" TProperty="string" />
            <PropertyColumn Property="x => x.BasePrice" Title="Price" T="ServiceDto" TProperty="decimal">
                <CellTemplate>
                    <MudText Typo="Typo.body2">@context.Item.BasePrice.ToString("C")</MudText>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="Actions" T="ServiceDto">
                <CellTemplate>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => GoToDetails(context.Item.Id))">Details</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => GoToEdit(context.Item.Id))">Edit</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => GoToDelete(context.Item.Id))">Delete</MudButton>
                </CellTemplate>
            </TemplateColumn>
        </ChildContent>
    </CustomDataGrid>
}

@code {
    private List<ServiceDto>? services = null;

    protected override async Task OnInitializedAsync()
    {
        services = await Http.GetFromJsonAsync<List<ServiceDto>>("api/services");
    }

    private void GoToDetails(Guid id) => Navigation.NavigateTo($"/services/details/{id}");
    private void GoToEdit(Guid id) => Navigation.NavigateTo($"/services/edit/{id}");
    private void GoToDelete(Guid id) => Navigation.NavigateTo($"/services/delete/{id}");
    private void GoToCreate() => Navigation.NavigateTo("/services/create");
}
