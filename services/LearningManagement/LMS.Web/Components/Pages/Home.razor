@page "/"

<PageTitle>Home - LMS</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">
    <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Large" Class="mr-2" />
    Welcome to the Learning Management System
</MudText>

<MudGrid Class="mt-6">
    <MudItem xs="12" md="6">
        <MudCard Elevation="4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5">
                        <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Class="mr-2" />
                        Browse Courses
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText>Explore our comprehensive course catalog and enroll in training programs.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/courses">
                    View Courses
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard Elevation="4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
                        Create Content
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText>Build engaging training courses with our intuitive course builder.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/course-builder">
                    Start Building
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>
