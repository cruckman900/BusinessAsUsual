@page "/sales/reports-hub"
@using MudBlazor
@inject NavigationManager Navigation

<PageTitle>Sales Reports</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/sales">Sales</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Reports</MudText>
    </div>

    <MudText Typo="Typo.h4" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-2" />
        Sales Reports & Analytics
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
        Sales analytics, revenue tracking, and performance insights
    </MudText>

    <!-- Main Module Cards Grid -->
    <MudGrid Spacing="3" Class="mb-6">
        <!-- Sales Analytics -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="d-flex flex-column" Style="height: 100%;" Elevation="1">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="Size.Large" Color="Color.Default" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true" Color="Color.Secondary">Sales Analytics</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        View comprehensive sales performance metrics
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Coming Soon</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Disabled="true">
                        Coming Soon
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Revenue Report -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="d-flex flex-column" Style="height: 100%;" Elevation="1">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Large" Color="Color.Default" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true" Color="Color.Secondary">Revenue Report</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Track revenue by period, product, and region
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Coming Soon</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Disabled="true">
                        Coming Soon
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Conversion Metrics -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="d-flex flex-column" Style="height: 100%;" Elevation="1">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" Color="Color.Default" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true" Color="Color.Secondary">Conversion Metrics</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Analyze quote-to-order conversion rates
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Coming Soon</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Disabled="true">
                        Coming Soon
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Customer Lifetime Value -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="d-flex flex-column" Style="height: 100%;" Elevation="1">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Large" Color="Color.Default" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true" Color="Color.Secondary">Customer LTV</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Calculate customer lifetime value metrics
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Coming Soon</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Disabled="true">
                        Coming Soon
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Product Performance -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="d-flex flex-column" Style="height: 100%;" Elevation="1">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" Color="Color.Default" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true" Color="Color.Secondary">Product Performance</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        View best and worst performing products
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Coming Soon</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Disabled="true">
                        Coming Soon
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Sales Forecasting -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="d-flex flex-column" Style="height: 100%;" Elevation="1">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Large" Color="Color.Default" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true" Color="Color.Secondary">Sales Forecasting</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Predict future sales trends and targets
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Coming Soon</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Disabled="true">
                        Coming Soon
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Quick Actions & Insights -->
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" GutterBottom="true">
                    <MudIcon Icon="@Icons.Material.Filled.FlashOn" Class="mr-2" />
                    Quick Actions
                </MudText>
                <MudStack Spacing="2">
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PictureAsPdf" Disabled="true">
                        Export Revenue Report (Coming Soon)
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Email" Disabled="true">
                        Schedule Analytics Email (Coming Soon)
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Dashboard" Disabled="true">
                        Create Custom Dashboard (Coming Soon)
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" GutterBottom="true">
                    <MudIcon Icon="@Icons.Material.Filled.Insights" Class="mr-2" />
                    Reporting Insights
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    View real-time insights on sales trends, revenue patterns, customer behavior, and market opportunities.
                </MudText>
                <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                    Advanced sales analytics and reporting features are currently under development.
                </MudAlert>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {

}
