@page "/sales/quotes"
@using System.Net.Http.Json
@using MudBlazor
@using Sales.Web.Components.Shared
@using Sales.Application.DTOs
@using Sales.Domain.Enums
@inject IHttpClientFactory HttpClientFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Quotes</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/sales">Sales</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Quotes</MudText>
    </div>

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Class="mr-2" />
                Sales Quotes
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Create and manage sales quotes for customers
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            New Quote
        </MudButton>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
    }
    else
    {
        <MudCard>
            <MudCardContent>
                <CustomDataGrid TItem="QuoteDto"
                                Items="@FilteredQuotes"
                                Loading="@_loading"
                                SearchPlaceholder="Search quotes by number, customer name, or email..."
                                RowsPerPage="25"
                                Striped="true"
                                Filterable="true">
                    <ToolbarContent>
                        <MudSelect @bind-Value="_statusFilter"
                                   Label="Status"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   T="string"
                                   Style="min-width: 200px;"
                                   Class="mr-2">
                            <MudSelectItem Value="@("All")">All Statuses</MudSelectItem>
                            <MudSelectItem Value="@("Draft")">Draft</MudSelectItem>
                            <MudSelectItem Value="@("Sent")">Sent</MudSelectItem>
                            <MudSelectItem Value="@("Viewed")">Viewed</MudSelectItem>
                            <MudSelectItem Value="@("Accepted")">Accepted</MudSelectItem>
                            <MudSelectItem Value="@("Rejected")">Rejected</MudSelectItem>
                            <MudSelectItem Value="@("Expired")">Expired</MudSelectItem>
                            <MudSelectItem Value="@("Converted")">Converted</MudSelectItem>
                        </MudSelect>
                    </ToolbarContent>
                    <ChildContent>
                        <PropertyColumn Property="x => x.QuoteNumber" Title="Quote #" T="QuoteDto" TProperty="string">
                            <CellTemplate>
                                <MudText Typo="Typo.body2" Style="font-weight:600">@context.Item.QuoteNumber</MudText>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.CustomerName" Title="Customer" T="QuoteDto" TProperty="string">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@context.Item.CustomerName</MudText>
                                @if (!string.IsNullOrEmpty(context.Item.CustomerEmail))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.CustomerEmail</MudText>
                                }
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.CreatedDate" Title="Created" T="QuoteDto" TProperty="DateTime">
                            <CellTemplate>
                                @context.Item.CreatedDate.ToShortDateString()
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.ExpiryDate" Title="Expires" T="QuoteDto" TProperty="DateTime?">
                            <CellTemplate>
                                @if (context.Item.ExpiryDate.HasValue)
                                {
                                    @if (context.Item.IsExpired)
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Error">@context.Item.ExpiryDate.Value.ToShortDateString()</MudText>
                                    }
                                    else
                                    {
                                        <span>@context.Item.ExpiryDate.Value.ToShortDateString()</span>
                                    }
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Not set</MudText>
                                }
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Status" Title="Status" T="QuoteDto" TProperty="QuoteStatus">
                            <CellTemplate>
                                @{
                                    var status = context.Item.Status;
                                    var statusColor = status switch
                                    {
                                        QuoteStatus.Draft => Color.Default,
                                        QuoteStatus.Sent => Color.Info,
                                        QuoteStatus.Viewed => Color.Primary,
                                        QuoteStatus.Accepted => Color.Success,
                                        QuoteStatus.Rejected => Color.Error,
                                        QuoteStatus.Expired => Color.Warning,
                                        QuoteStatus.Converted => Color.Success,
                                        _ => Color.Default
                                    };
                                }
                                <MudChip T="string" Size="Size.Small" Color="@statusColor">@status.ToString()</MudChip>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Total" Title="Total" Format="C2" T="QuoteDto" TProperty="decimal">
                            <CellTemplate>
                                <MudText Typo="Typo.body2" Style="font-weight:600">@context.Item.Total.ToString("C")</MudText>
                            </CellTemplate>
                        </PropertyColumn>
                        <TemplateColumn T="QuoteDto" Title="Actions" Sortable="false" Filterable="false">
                            <CellTemplate>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               OnClick="@(() => OpenEditDialog(context.Item))"
                                               title="Edit"
                                               Disabled="@(context.Item.Status == QuoteStatus.Converted)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Send"
                                               Size="Size.Small"
                                               Color="Color.Info"
                                               OnClick="@(() => SendQuote(context.Item))"
                                               title="Send to Customer"
                                               Disabled="@(context.Item.Status != QuoteStatus.Draft)" />
                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                               Size="Size.Small"
                                               Color="Color.Success"
                                               OnClick="@(() => AcceptQuote(context.Item))"
                                               title="Accept Quote"
                                               Disabled="@(context.Item.Status != QuoteStatus.Sent && context.Item.Status != QuoteStatus.Viewed)" />
                                <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               OnClick="@(() => ConvertToOrder(context.Item))"
                                               title="Convert to Order"
                                               Disabled="@(context.Item.Status != QuoteStatus.Accepted)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => DeleteQuote(context.Item))"
                                               title="Delete" />
                            </CellTemplate>
                        </TemplateColumn>
                    </ChildContent>
                </CustomDataGrid>

                @if (!FilteredQuotes.Any())
                {
                    <MudAlert Severity="Severity.Info" Class="mt-4">
                        No quotes found matching your search criteria.
                    </MudAlert>
                }
            </MudCardContent>
        </MudCard>

        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                Quick Stats
            </MudText>
            <MudGrid>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Quotes</MudText>
                    <MudText Typo="Typo.h6">@_quotes.Count</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Sent</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Info">@_quotes.Count(q => q.Status == QuoteStatus.Sent || q.Status == QuoteStatus.Viewed)</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Accepted</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Success">@_quotes.Count(q => q.Status == QuoteStatus.Accepted)</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Converted</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Primary">@_quotes.Count(q => q.Status == QuoteStatus.Converted)</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private List<QuoteDto> _quotes = new();
    private string? _errorMessage;
    private string _statusFilter = "All";

    private IEnumerable<QuoteDto> FilteredQuotes
    {
        get
        {
            var filtered = _quotes.AsEnumerable();

            if (_statusFilter != "All")
            {
                if (Enum.TryParse<QuoteStatus>(_statusFilter, out var status))
                {
                    filtered = filtered.Where(q => q.Status == status);
                }
            }

            return filtered.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadQuotes();
    }

    private async Task LoadQuotes()
    {
        _loading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("SalesApi");
            _quotes = await client.GetFromJsonAsync<List<QuoteDto>>("api/sales/quotes") ?? new();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading quotes: {ex.Message}";
            Console.WriteLine(_errorMessage);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            { "IsEdit", false }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<QuoteForm>("Create Quote", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadQuotes();
        }
    }

    private async Task OpenEditDialog(QuoteDto quote)
    {
        var parameters = new DialogParameters
        {
            { "Quote", quote },
            { "IsEdit", true }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<QuoteForm>("Edit Quote", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadQuotes();
        }
    }

    private async Task SendQuote(QuoteDto quote)
    {
        try
        {
            var client = HttpClientFactory.CreateClient("SalesApi");
            var response = await client.PostAsync($"api/sales/quotes/{quote.Id}/send", null);
            response.EnsureSuccessStatusCode();

            Snackbar.Add($"Quote {quote.QuoteNumber} sent successfully", Severity.Success);
            await LoadQuotes();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error sending quote: {ex.Message}", Severity.Error);
        }
    }

    private async Task AcceptQuote(QuoteDto quote)
    {
        try
        {
            var client = HttpClientFactory.CreateClient("SalesApi");
            var response = await client.PostAsync($"api/sales/quotes/{quote.Id}/accept", null);
            response.EnsureSuccessStatusCode();

            Snackbar.Add($"Quote {quote.QuoteNumber} accepted", Severity.Success);
            await LoadQuotes();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error accepting quote: {ex.Message}", Severity.Error);
        }
    }

    private async Task ConvertToOrder(QuoteDto quote)
    {
        var parameters = new DialogParameters
        {
            { "ContentText", $"Convert quote '{quote.QuoteNumber}' to an order? This will create a new sales order with the quote details." },
            { "ButtonText", "Convert" },
            { "Color", Color.Primary }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Convert to Order", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var client = HttpClientFactory.CreateClient("SalesApi");
                var response = await client.PostAsync($"api/sales/quotes/{quote.Id}/convert", null);
                response.EnsureSuccessStatusCode();

                Snackbar.Add($"Quote '{quote.QuoteNumber}' converted to order successfully", Severity.Success);
                await LoadQuotes();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error converting quote: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task DeleteQuote(QuoteDto quote)
    {
        var parameters = new DialogParameters
        {
            { "ContentText", $"Are you sure you want to delete quote '{quote.QuoteNumber}'? This action cannot be undone." },
            { "ButtonText", "Delete" },
            { "Color", Color.Error }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Quote", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var client = HttpClientFactory.CreateClient("SalesApi");
                var response = await client.DeleteAsync($"api/sales/quotes/{quote.Id}");
                response.EnsureSuccessStatusCode();

                Snackbar.Add($"Quote '{quote.QuoteNumber}' deleted successfully", Severity.Success);
                await LoadQuotes();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting quote: {ex.Message}", Severity.Error);
            }
        }
    }
}
