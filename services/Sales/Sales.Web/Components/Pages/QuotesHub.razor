@page "/sales/quotes-hub"
@using MudBlazor
@inject NavigationManager Navigation

<PageTitle>Quotes Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/sales">Sales</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Quotes</MudText>
    </div>

    <MudText Typo="Typo.h4" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Class="mr-2" />
        Quotes Management
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
        Create, track, and manage sales quotes
    </MudText>

    <!-- Main Module Cards Grid -->
    <MudGrid Spacing="3" Class="mb-6">
        <!-- All Quotes -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="mud-card-hover d-flex flex-column" Style="height: 100%;">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Size="Size.Large" Color="Color.Primary" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true">All Quotes</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        View and manage all sales quotes
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">Active</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Href="/sales/quotes">
                        View Quotes →
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Create Quote -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="d-flex flex-column" Style="height: 100%;" Elevation="1">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Large" Color="Color.Default" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true" Color="Color.Secondary">Create Quote</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Create new sales quote for customer
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Coming Soon</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Disabled="true">
                        Coming Soon
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Quote Templates -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="d-flex flex-column" Style="height: 100%;" Elevation="1">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Large" Color="Color.Default" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true" Color="Color.Secondary">Quote Templates</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Manage reusable quote templates
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Coming Soon</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Disabled="true">
                        Coming Soon
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Expired Quotes -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="d-flex flex-column" Style="height: 100%;" Elevation="1">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Color="Color.Default" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true" Color="Color.Secondary">Expired Quotes</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Review and manage expired quotes
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Coming Soon</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Disabled="true">
                        Coming Soon
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Quote Approval Workflow -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="d-flex flex-column" Style="height: 100%;" Elevation="1">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.Approval" Size="Size.Large" Color="Color.Default" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true" Color="Color.Secondary">Approval Workflow</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Configure quote approval process
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Coming Soon</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Disabled="true">
                        Coming Soon
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Quote Analytics -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="d-flex flex-column" Style="height: 100%;" Elevation="1">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Large" Color="Color.Default" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true" Color="Color.Secondary">Quote Analytics</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        View quote conversion and win rates
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Coming Soon</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Disabled="true">
                        Coming Soon
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Quick Actions & Insights -->
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" GutterBottom="true">
                    <MudIcon Icon="@Icons.Material.Filled.FlashOn" Class="mr-2" />
                    Quick Actions
                </MudText>
                <MudStack Spacing="2">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Visibility" Href="/sales/quotes">
                        View All Quotes
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add" Disabled="true">
                        Create New Quote (Coming Soon)
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Email" Disabled="true">
                        Send Quote to Customer (Coming Soon)
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" GutterBottom="true">
                    <MudIcon Icon="@Icons.Material.Filled.Insights" Class="mr-2" />
                    Quote Insights
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    View real-time insights on quote conversion rates, average quote value, win/loss trends, and quote aging.
                </MudText>
                <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                    Quote analytics and tracking features coming soon.
                </MudAlert>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {

}
