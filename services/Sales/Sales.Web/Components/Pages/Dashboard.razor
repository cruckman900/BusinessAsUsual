@page "/sales"
@using System.Net.Http.Json
@using MudBlazor
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Sales Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Sales</MudText>
    </div>

    <MudText Typo="Typo.h4" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Class="mr-2" />
        Sales & Orders Dashboard
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
        Manage quotes, orders, and customer transactions
    </MudText>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
        <MudText Class="mt-2">Loading dashboard...</MudText>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
            @_errorMessage
        </MudAlert>
    }

    <MudGrid>
        <!-- Quick Stats -->
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2" Class="cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/sales/quotes"))">
                <MudCardContent>
                    <div class="d-flex justify-space-between">
                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Active Quotes</MudText>
                            <MudText Typo="Typo.h5">@(_stats?.ActiveQuotes ?? 0)</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Size="Size.Large" Color="Color.Info" />
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2" Class="cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/sales/orders"))">
                <MudCardContent>
                    <div class="d-flex justify-space-between">
                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Open Orders</MudText>
                            <MudText Typo="Typo.h5">@(_stats?.OpenOrders ?? 0)</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Large" Color="Color.Primary" />
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <div class="d-flex justify-space-between">
                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Monthly Revenue</MudText>
                            <MudText Typo="Typo.h5">@(_stats?.MonthlyRevenue.ToString("C") ?? "$0.00")</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Large" Color="Color.Success" />
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <div class="d-flex justify-space-between">
                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Pending Shipments</MudText>
                            <MudText Typo="Typo.h5">@(_stats?.PendingShipments ?? 0)</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Large" Color="Color.Warning" />
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Navigation Cards -->
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="3" Class="cursor-pointer hover-card" @onclick="@(() => Navigation.NavigateTo("/sales/quotes-hub"))">
                <MudCardContent Class="text-center pa-6">
                    <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Size="Size.Large" Color="Color.Info" Class="mb-3" />
                    <MudText Typo="Typo.h6">Quotes</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Create and manage sales quotes</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-2" Href="/sales/quotes-hub">
                        Manage Quotes →
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="3" Class="cursor-pointer hover-card" @onclick="@(() => Navigation.NavigateTo("/sales/orders-hub"))">
                <MudCardContent Class="text-center pa-6">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                    <MudText Typo="Typo.h6">Orders</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Process and fulfill customer orders</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-2" Href="/sales/orders-hub">
                        Manage Orders →
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="3" Class="cursor-pointer hover-card" @onclick="@(() => Navigation.NavigateTo("/sales/reports-hub"))">
                <MudCardContent Class="text-center pa-6">
                    <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                    <MudText Typo="Typo.h6">Reports</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">View sales analytics and reports</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-2" Href="/sales/reports-hub">
                        View Reports →
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- About & Module Info Grid -->
    <MudGrid Class="mt-6">
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4 d-flex flex-column" Elevation="1" Style="height: 100%;">
                <MudText Typo="Typo.h6" GutterBottom="true">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                    About Sales Module
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-4">
                    The Sales module provides comprehensive quote-to-cash capabilities including:
                </MudText>
                <MudList T="string" Dense="true">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                        <strong>Quote Management</strong> - Create, track, and convert sales quotes to orders
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                        <strong>Order Processing</strong> - Manage customer orders from creation to fulfillment
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                        <strong>Customer Management</strong> - Maintain customer records and transaction history
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                        <strong>Product Catalog</strong> - Browse and sell products with real-time pricing
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                        <strong>Payment Tracking</strong> - Record and monitor customer payments
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                        <strong>Shipping Integration</strong> - Track shipments and delivery status
                    </MudListItem>
                </MudList>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-auto pt-4">
                    This module is dynamically loaded via the Module Registry Service and provides both web UI and mobile API contracts.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 d-flex flex-column" Elevation="1" Style="height: 100%;">
                <MudText Typo="Typo.h6" GutterBottom="true">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />
                    Module Info
                </MudText>
                <MudStack Spacing="2" Class="flex-grow-1">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Module ID</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">sales</MudChip>
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Version</MudText>
                        <MudText Typo="Typo.body2">1.0.0</MudText>
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">API Port</MudText>
                        <MudText Typo="Typo.body2">5143 (HTTP) / 7143 (HTTPS)</MudText>
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Web UI Port</MudText>
                        <MudText Typo="Typo.body2">5229</MudText>
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Created</MudText>
                        <MudText Typo="Typo.body2">January 2025</MudText>
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Active</MudChip>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Module Info Footer -->
    <MudDivider Class="my-6" />
    <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">
        Sales Module • Created January 2025 • Version 1.0
    </MudText>
</MudContainer>

<style>
    .cursor-pointer {
        cursor: pointer;
    }
    .hover-card:hover {
        transform: translateY(-4px);
        transition: transform 0.2s ease-in-out;
    }
</style>

@code {
    private DashboardStats? _stats;
    private bool _loading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();
    }

    private async Task LoadStats()
    {
        try
        {
            _loading = true;
            _errorMessage = null;
            var client = HttpClientFactory.CreateClient("SalesApi");
            _stats = await client.GetFromJsonAsync<DashboardStats>("api/sales/dashboard/stats");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading dashboard: {ex.Message}";
            Console.WriteLine($"Dashboard error: {ex}");
        }
        finally
        {
            _loading = false;
        }
    }

    public class DashboardStats
    {
        public int ActiveQuotes { get; set; }
        public int OpenOrders { get; set; }
        public decimal MonthlyRevenue { get; set; }
        public int PendingShipments { get; set; }
        public int TotalQuotes { get; set; }
        public int TotalOrders { get; set; }
        public decimal AverageOrderValue { get; set; }
        public decimal ConversionRate { get; set; }
    }
}
