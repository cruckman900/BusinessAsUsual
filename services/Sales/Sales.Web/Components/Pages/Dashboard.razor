@page "/sales"
@page "/sales/home"
@using System.Net.Http.Json
@using MudBlazor
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Sales Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Sales</MudText>
    </div>

    <MudText Typo="Typo.h4" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Class="mr-2" />
        Sales
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
        Manage quotes, orders, customers, and drive revenue growth
    </MudText>

    <!-- Main Module Cards Grid -->
    <MudGrid Spacing="3" Class="mb-6">
        <!-- Quotes Management -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="mud-card-hover d-flex flex-column" Style="height: 100%;">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Size="Size.Large" Color="Color.Info" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true">Quotes</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Create and manage sales quotes for potential customers
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@(_stats?.ActiveQuotes ?? 0) Active</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Href="/sales/quotes-hub">
                        Manage Quotes →
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Orders Management -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="mud-card-hover d-flex flex-column" Style="height: 100%;">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Large" Color="Color.Primary" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true">Orders</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Process and fulfill customer orders and track deliveries
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@(_stats?.OpenOrders ?? 0) Open</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Href="/sales/orders-hub">
                        Manage Orders →
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Customers -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="mud-card-hover d-flex flex-column" Style="height: 100%;">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Success" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true">Customers</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Manage customer relationships and contact information
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">View All</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Href="/sales/customers">
                        View Customers
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Shipments -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="mud-card-hover d-flex flex-column" Style="height: 100%;">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Large" Color="Color.Warning" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true">Shipments</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Track deliveries, manage shipping, and logistics
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">@(_stats?.PendingShipments ?? 0) Pending</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Href="/sales/shipments">
                        View Shipments
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Products & Pricing -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="mud-card-hover d-flex flex-column" Style="height: 100%;">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" Color="Color.Tertiary" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true">Products & Pricing</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Manage product catalog, pricing, and discounts
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Text">Catalog</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Href="/sales/products">
                        View Products
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Analytics & Reports -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="mud-card-hover d-flex flex-column" Style="height: 100%;">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true">Analytics & Reports</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        View sales performance metrics and detailed reports
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">Reports</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Href="/sales/reports-hub">
                        View Reports
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Payments -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="mud-card-hover d-flex flex-column" Style="height: 100%;">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Large" Color="Color.Info" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true">Payments</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Track payments, invoicing, and payment terms
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">View All</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Href="/sales/payments">
                        View Payments
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Settings -->
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="mud-card-hover d-flex flex-column" Style="height: 100%;">
                <MudCardContent Class="text-center pa-6 flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Large" Color="Color.Dark" Class="mb-4" />
                    <MudText Typo="Typo.h6" GutterBottom="true">Settings</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Configure sales module preferences and options
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Text">Configure</MudChip>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Href="/sales/settings">
                        Settings
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Quick Stats Row -->
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" GutterBottom="true">
            <MudIcon Icon="@Icons.Material.Filled.QueryStats" Class="mr-2" />
            Quick Stats
        </MudText>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <MudText Class="mt-2">Loading stats...</MudText>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true">
                @_errorMessage
            </MudAlert>
        }
        else
        {
            <MudGrid Spacing="2">
                <MudItem xs="6" sm="3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4" Color="Color.Primary">@(_stats?.TotalOrders ?? 0)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Orders</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4" Color="Color.Success">@(_stats?.MonthlyRevenue.ToString("C") ?? "$0")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Monthly Revenue</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4" Color="Color.Info">@(_stats?.AverageOrderValue.ToString("C") ?? "$0")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Avg Order Value</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4" Color="Color.Warning">@(_stats?.ConversionRate.ToString("F1") ?? "0")%</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Conversion Rate</MudText>
                    </MudStack>
                </MudItem>
            </MudGrid>
        }
    </MudPaper>

    <!-- About & Module Info Grid -->
    <MudGrid>
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4 d-flex flex-column" Elevation="1" Style="height: 100%;">
                <MudText Typo="Typo.h6" GutterBottom="true">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                    About Sales Module
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-4">
                    The Sales module provides comprehensive order and quote management capabilities including:
                </MudText>
                <MudList T="string" Dense="true">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                        <strong>Quote Management</strong> - Create, send, and track sales quotes for prospects
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                        <strong>Order Processing</strong> - Manage orders from creation to fulfillment
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                        <strong>Customer Management</strong> - Track customer information and purchase history
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                        <strong>Shipping & Logistics</strong> - Coordinate deliveries and track shipments
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                        <strong>Product Catalog</strong> - Manage products, pricing, and inventory
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                        <strong>Payment Tracking</strong> - Monitor payments, invoices, and payment terms
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check">
                        <strong>Sales Analytics</strong> - Track performance metrics and conversion rates
                    </MudListItem>
                </MudList>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="1" Style="height: 100%;">
                <MudText Typo="Typo.h6" GutterBottom="true">
                    <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Class="mr-2" />
                    Quick Tips
                </MudText>
                <MudList T="string" Dense="true">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.TipsAndUpdates">
                        Use quote templates to speed up quote creation
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.TipsAndUpdates">
                        Track conversion rates to optimize sales process
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.TipsAndUpdates">
                        Set up automated email notifications for order status
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.TipsAndUpdates">
                        Review monthly reports to identify trends
                    </MudListItem>
                </MudList>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private DashboardStats? _stats;
    private bool _loading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();
    }

    private async Task LoadStats()
    {
        try
        {
            _loading = true;
            _errorMessage = null;

            // Try to load from API first
            try
            {
                var client = HttpClientFactory.CreateClient("SalesApi");
                _stats = await client.GetFromJsonAsync<DashboardStats>("api/sales/dashboard/stats");
                return; // Success - exit early
            }
            catch (HttpRequestException)
            {
                // API not available - fall back to mock data
                Console.WriteLine("Sales.API not available, using mock data");
            }

            // Use mock data as fallback
            await Task.Delay(100); // Simulate async call

            _stats = new DashboardStats
            {
                ActiveQuotes = 12,
                OpenOrders = 8,
                MonthlyRevenue = 45750.00m,
                PendingShipments = 5,
                TotalQuotes = 47,
                TotalOrders = 32,
                AverageOrderValue = 1429.69m,
                ConversionRate = 68.09m
            };
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading dashboard: {ex.Message}";
            Console.WriteLine($"Dashboard error: {ex}");
        }
        finally
        {
            _loading = false;
        }
    }

    private class DashboardStats
    {
        public int ActiveQuotes { get; set; }
        public int OpenOrders { get; set; }
        public decimal MonthlyRevenue { get; set; }
        public int PendingShipments { get; set; }
        public int TotalQuotes { get; set; }
        public int TotalOrders { get; set; }
        public decimal AverageOrderValue { get; set; }
        public decimal ConversionRate { get; set; }
    }
}
