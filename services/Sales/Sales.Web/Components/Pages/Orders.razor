@page "/sales/orders"
@using System.Net.Http.Json
@using MudBlazor
@using Sales.Web.Components.Shared
@using Sales.Application.DTOs
@using Sales.Application.Services
@using Sales.Domain.Enums
@inject IOrderService OrderService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Orders</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/sales">Sales</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Orders</MudText>
    </div>

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-2" />
                Sales Orders
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Process and fulfill customer orders
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            New Order
        </MudButton>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
    }
    else
    {
        <MudCard>
            <MudCardContent>
                <CustomDataGrid TItem="OrderDto"
                                Items="@FilteredOrders"
                                Loading="@_loading"
                                SearchPlaceholder="Search orders by number, customer name, or email..."
                                RowsPerPage="25"
                                Striped="true"
                                Filterable="true">
                    <ToolbarContent>
                        <MudSelect @bind-Value="_statusFilter"
                                   Label="Status"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   T="string"
                                   Style="min-width: 200px;"
                                   Class="mr-2">
                            <MudSelectItem Value="@("All")">All Statuses</MudSelectItem>
                            <MudSelectItem Value="@("Draft")">Draft</MudSelectItem>
                            <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
                            <MudSelectItem Value="@("Confirmed")">Confirmed</MudSelectItem>
                            <MudSelectItem Value="@("Processing")">Processing</MudSelectItem>
                            <MudSelectItem Value="@("Shipped")">Shipped</MudSelectItem>
                            <MudSelectItem Value="@("Delivered")">Delivered</MudSelectItem>
                            <MudSelectItem Value="@("Cancelled")">Cancelled</MudSelectItem>
                        </MudSelect>
                    </ToolbarContent>
                    <ChildContent>
                        <PropertyColumn Property="x => x.OrderNumber" Title="Order #" T="OrderDto" TProperty="string">
                            <CellTemplate>
                                <MudText Typo="Typo.body2" Style="font-weight:600">@context.Item.OrderNumber</MudText>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.CustomerName" Title="Customer" T="OrderDto" TProperty="string">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">
                                    @(string.IsNullOrWhiteSpace(context.Item.CustomerName) ? "(No customer name)" : context.Item.CustomerName)
                                </MudText>
                                @if (!string.IsNullOrEmpty(context.Item.CustomerEmail))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.CustomerEmail</MudText>
                                }
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.OrderDate" Title="Order Date" T="OrderDto" TProperty="DateTime">
                            <CellTemplate>
                                @context.Item.OrderDate.ToShortDateString()
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Status" Title="Status" T="OrderDto" TProperty="OrderStatus">
                            <CellTemplate>
                                @{
                                    var status = context.Item.Status;
                                    var statusColor = status switch
                                    {
                                        OrderStatus.Draft => Color.Default,
                                        OrderStatus.Pending => Color.Info,
                                        OrderStatus.Confirmed => Color.Primary,
                                        OrderStatus.Processing => Color.Warning,
                                        OrderStatus.Shipped => Color.Info,
                                        OrderStatus.Delivered => Color.Success,
                                        OrderStatus.Cancelled => Color.Error,
                                        OrderStatus.Refunded => Color.Warning,
                                        _ => Color.Default
                                    };
                                }
                                <MudChip T="string" Size="Size.Small" Color="@statusColor">@status.ToString()</MudChip>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Total" Title="Total" Format="C2" T="OrderDto" TProperty="decimal">
                            <CellTemplate>
                                <MudText Typo="Typo.body2" Style="font-weight:600">@context.Item.Total.ToString("C")</MudText>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.BalanceDue" Title="Balance Due" Format="C2" T="OrderDto" TProperty="decimal">
                            <CellTemplate>
                                @if (context.Item.BalanceDue > 0)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Warning">@context.Item.BalanceDue.ToString("C")</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Success">Paid</MudText>
                                }
                            </CellTemplate>
                        </PropertyColumn>
                        <TemplateColumn T="OrderDto" Title="Actions" Sortable="false" Filterable="false">
                            <CellTemplate>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               OnClick="@(() => OpenEditDialog(context.Item))"
                                               title="Edit" />
                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                               Size="Size.Small"
                                               Color="Color.Success"
                                               OnClick="@(() => ConfirmOrder(context.Item))"
                                               title="Confirm Order"
                                               Disabled="@(context.Item.Status != OrderStatus.Draft && context.Item.Status != OrderStatus.Pending)" />
                                <MudIconButton Icon="@Icons.Material.Filled.LocalShipping"
                                               Size="Size.Small"
                                               Color="Color.Info"
                                               OnClick="@(() => ShipOrder(context.Item))"
                                               title="Mark as Shipped"
                                               Disabled="@(context.Item.Status != OrderStatus.Confirmed && context.Item.Status != OrderStatus.Processing)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => DeleteOrder(context.Item))"
                                               title="Delete" />
                            </CellTemplate>
                        </TemplateColumn>
                    </ChildContent>
                </CustomDataGrid>

                @if (!FilteredOrders.Any())
                {
                    <MudAlert Severity="Severity.Info" Class="mt-4">
                        No orders found matching your search criteria.
                    </MudAlert>
                }
            </MudCardContent>
        </MudCard>

        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                Quick Stats
            </MudText>
            <MudGrid>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Orders</MudText>
                    <MudText Typo="Typo.h6">@_orders.Count</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Pending</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Info">@_orders.Count(o => o.Status == OrderStatus.Pending)</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Processing</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Warning">@_orders.Count(o => o.Status == OrderStatus.Processing || o.Status == OrderStatus.Confirmed)</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Revenue</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Success">@_orders.Where(o => o.Status != OrderStatus.Cancelled).Sum(o => o.Total).ToString("C")</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private List<OrderDto> _orders = new();
    private string? _errorMessage;
    private string _statusFilter = "All";

    private IEnumerable<OrderDto> FilteredOrders
    {
        get
        {
            var filtered = _orders.AsEnumerable();

            if (_statusFilter != "All")
            {
                if (Enum.TryParse<OrderStatus>(_statusFilter, out var status))
                {
                    filtered = filtered.Where(o => o.Status == status);
                }
            }

            return filtered.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        _loading = true;
        try
        {
            var result = await OrderService.GetAllOrdersAsync();
            _orders = result.ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading orders: {ex.Message}";
            Console.WriteLine(_errorMessage);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            { "IsEdit", false }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<OrderForm>("Create Order", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadOrders();
        }
    }

    private async Task OpenEditDialog(OrderDto order)
    {
        var parameters = new DialogParameters
        {
            { "Order", order },
            { "IsEdit", true }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<OrderForm>("Edit Order", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadOrders();
        }
    }

    private async Task ConfirmOrder(OrderDto order)
    {
        try
        {
            await OrderService.ConfirmOrderAsync(order.Id);
            Snackbar.Add($"Order {order.OrderNumber} confirmed successfully", Severity.Success);
            await LoadOrders();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error confirming order: {ex.Message}", Severity.Error);
        }
    }

    private async Task ShipOrder(OrderDto order)
    {
        try
        {
            var trackingNumber = "TRK" + DateTime.UtcNow.Ticks.ToString().Substring(0, 10);
            await OrderService.ShipOrderAsync(order.Id, trackingNumber);
            Snackbar.Add($"Order {order.OrderNumber} marked as shipped", Severity.Success);
            await LoadOrders();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error shipping order: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteOrder(OrderDto order)
    {
        var parameters = new DialogParameters
        {
            { "ContentText", $"Are you sure you want to delete order '{order.OrderNumber}'? This action cannot be undone." },
            { "ButtonText", "Delete" },
            { "Color", Color.Error }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Order", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                await OrderService.DeleteOrderAsync(order.Id);
                Snackbar.Add($"Order '{order.OrderNumber}' deleted successfully", Severity.Success);
                await LoadOrders();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting order: {ex.Message}", Severity.Error);
            }
        }
    }
}
