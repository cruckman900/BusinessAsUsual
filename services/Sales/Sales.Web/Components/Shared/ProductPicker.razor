@using System.Net.Http.Json
@using MudBlazor
@using Inventory.Application.Services
@using ProductDto = Inventory.Application.DTOs.ProductDto
@inject IInventoryService InventoryService

<MudAutocomplete T="ProductDto"
                 Value="@SelectedProduct"
                 ValueChanged="@(async (ProductDto p) => await OnProductSelected(p))"
                 SearchFunc="SearchProducts"
                 ToStringFunc="@(p => p?.Name ?? "")"
                 Label="@Label"
                 Variant="@Variant"
                 Margin="@Margin"
                 Dense="@Dense"
                 Required="@Required"
                 RequiredError="@RequiredError"
                 Disabled="@Disabled"
                 ResetValueOnEmptyText="false"
                 CoerceText="false"
                 CoerceValue="false"
                 AdornmentIcon="@Icons.Material.Filled.Search"
                 AdornmentColor="Color.Primary"
                 Clearable="true"
                 DebounceInterval="300"
                 MinCharacters="0"
                 MaxItems="20"
                 ShowProgressIndicator="true">
    <ItemTemplate Context="product">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%;">
            <MudStack Spacing="0">
                <MudText Typo="Typo.body2"><b>@product.Name</b></MudText>
                @if (!string.IsNullOrWhiteSpace(product.SKU))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">SKU: @product.SKU</MudText>
                }
            </MudStack>
            <MudText Typo="Typo.body2" Color="Color.Primary">@product.Price.ToString("C")</MudText>
        </MudStack>
    </ItemTemplate>
    <NoItemsTemplate>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @if (_productsLoaded && _allProducts.Any())
            {
                <text>Type to search products...</text>
            }
            else if (!_productsLoaded)
            {
                <text>Loading products...</text>
            }
            else
            {
                <text>No products available</text>
            }
        </MudText>
    </NoItemsTemplate>
</MudAutocomplete>

@code {
    [Parameter] public ProductDto? SelectedProduct { get; set; }
    [Parameter] public EventCallback<ProductDto?> SelectedProductChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Select Product";
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.Dense;
    [Parameter] public bool Dense { get; set; } = true;
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public string RequiredError { get; set; } = "Product is required";
    [Parameter] public bool Disabled { get; set; } = false;

    private List<ProductDto> _allProducts = new();
    private bool _productsLoaded = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task OnProductSelected(ProductDto? product)
    {
        SelectedProduct = product;
        await SelectedProductChanged.InvokeAsync(product);
    }

    private async Task LoadProductsAsync()
    {
        if (_productsLoaded) return;

        try
        {
            var response = await InventoryService.GetAllProductsAsync();
            _allProducts = response.ToList();
            _productsLoaded = true;
        }
        catch (Exception)
        {
            _allProducts = new List<ProductDto>();
        }
    }

    private async Task<IEnumerable<ProductDto>> SearchProducts(string? searchText, CancellationToken cancellationToken)
    {
        await LoadProductsAsync();

        // Show top 20 if no search text or just clicked
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return _allProducts
                .OrderBy(p => p.Name)
                .Take(20);
        }

        // Case-insensitive LIKE search across Name, SKU, Description, and Category
        var search = searchText.Trim();
        return _allProducts
            .Where(p => p.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                       (p.SKU?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                       (p.Description?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                       (p.Category?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false))
            .OrderBy(p => p.Name.StartsWith(search, StringComparison.OrdinalIgnoreCase) ? 0 : 1) // Prioritize starts-with matches
            .ThenBy(p => p.Name)
            .Take(20)
            .ToList(); // Materialize to avoid async issues
    }
}
