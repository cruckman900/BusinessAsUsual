@using System.Net.Http.Json
@using MudBlazor
@using Sales.Application.DTOs
@using Sales.Domain.Enums
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
                <MudTabPanel Text="Customer Info" Icon="@Icons.Material.Filled.Person">
                    <MudGrid>
                        <MudItem xs="12">
                            <CustomerPicker SelectedCustomer="_selectedCustomer"
                                          SelectedCustomerChanged="OnCustomerSelectedAsync"
                                          Label="Select Customer from CRM"
                                          Required="true"
                                          RequiredError="Customer is required" />
                        </MudItem>

                        @if (_selectedCustomer != null)
                        {
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    Selected: <strong>@_selectedCustomer.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(_selectedCustomer.Email))
                                    {
                                        <text> • @_selectedCustomer.Email</text>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_selectedCustomer.Phone))
                                    {
                                        <text> • @_selectedCustomer.Phone</text>
                                    }
                                </MudAlert>
                            </MudItem>
                        }

                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_model.CustomerName"
                                          Label="Customer Name"
                                          Required="true"
                                          RequiredError="Customer name is required"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Disabled="@(_selectedCustomer != null)"
                                          HelperText="Auto-filled from CRM or enter manually" />
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_model.CustomerEmail"
                                          Label="Email"
                                          InputType="InputType.Email"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Disabled="@(_selectedCustomer != null)" />
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_model.CustomerPhone"
                                          Label="Phone"
                                          InputType="InputType.Telephone"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Disabled="@(_selectedCustomer != null)" />
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_model.CustomerId"
                                          Label="Customer ID"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Disabled="true"
                                          HelperText="Auto-filled from CRM" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.Notes"
                                          Label="Customer Notes"
                                          Lines="3"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Line Items" Icon="@Icons.Material.Filled.ShoppingCart">
                    @* Product Selection Panel - Inline *@
                    <MudExpansionPanels @bind-Expanded="_showProductPanel" Class="mb-3">
                        <MudExpansionPanel Text="Add Product from Inventory" 
                                          Icon="@Icons.Material.Filled.Inventory"
                                          MaxHeight="400">
                            <MudStack Spacing="3" Class="pa-4">
                                <ProductPicker @bind-SelectedProduct="_selectedProduct"
                                             Label="Search Products (type name, SKU, or description)"
                                             Variant="Variant.Outlined" />

                                @if (_selectedProduct != null)
                                {
                                    <MudPaper Class="pa-3" Outlined="true" Elevation="0">
                                        <MudStack Spacing="2">
                                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.subtitle1"><strong>@_selectedProduct.Name</strong></MudText>
                                                <MudText Typo="Typo.h6" Color="Color.Primary">@_selectedProduct.Price.ToString("C")</MudText>
                                            </MudStack>
                                            @if (!string.IsNullOrWhiteSpace(_selectedProduct.SKU))
                                            {
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">SKU: @_selectedProduct.SKU</MudText>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(_selectedProduct.Description))
                                            {
                                                <MudText Typo="Typo.body2">@_selectedProduct.Description</MudText>
                                            }
                                        </MudStack>
                                    </MudPaper>

                                    <MudNumericField @bind-Value="_productQuantity"
                                                   Label="Quantity"
                                                   Min="0.01m"
                                                   Variant="Variant.Outlined"
                                                   HelperText="How many units?" />

                                    <MudAlert Severity="Severity.Info" Dense="true" NoIcon="true">
                                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                                            <MudText><strong>Line Total:</strong></MudText>
                                            <MudText Typo="Typo.h6" Color="Color.Primary">@((_productQuantity * _selectedProduct.Price).ToString("C"))</MudText>
                                        </MudStack>
                                    </MudAlert>

                                    <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                                        <MudButton Color="Color.Default"
                                                 Variant="Variant.Text"
                                                 OnClick="CancelAddProduct">
                                            Cancel
                                        </MudButton>
                                        <MudButton Color="Color.Primary"
                                                 Variant="Variant.Filled"
                                                 StartIcon="@Icons.Material.Filled.Add"
                                                 OnClick="AddProductToOrder">
                                            Add to Order
                                        </MudButton>
                                    </MudStack>
                                }
                            </MudStack>
                        </MudExpansionPanel>
                    </MudExpansionPanels>

                    @* Quick Add Custom Item Button *@
                    <MudButton StartIcon="@Icons.Material.Filled.Edit"
                               Color="Color.Secondary"
                               Variant="Variant.Outlined"
                               Size="Size.Small"
                               OnClick="AddLineItem"
                               Class="mb-3">
                        Add Custom Item
                    </MudButton>

                    @if (_model.LineItems.Any())
                    {
                        <MudTable Items="@_model.LineItems" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                            <HeaderContent>
                                <MudTh>Product</MudTh>
                                <MudTh>Qty</MudTh>
                                <MudTh>Unit Price</MudTh>
                                <MudTh>Discount %</MudTh>
                                <MudTh>Tax %</MudTh>
                                <MudTh>Total</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Product">
                                    <MudTextField @bind-Value="context.ProductName"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Dense="true" />
                                </MudTd>
                                <MudTd DataLabel="Qty">
                                    <MudNumericField @bind-Value="context.Quantity"
                                                     Min="0.01m"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Dense="true"
                                                     Style="width: 80px;" />
                                </MudTd>
                                <MudTd DataLabel="Price">
                                    <MudNumericField @bind-Value="context.UnitPrice"
                                                     Min="0m"
                                                     Format="C2"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Dense="true"
                                                     Style="width: 100px;" />
                                </MudTd>
                                <MudTd DataLabel="Discount">
                                    <MudNumericField @bind-Value="context.DiscountPercentage"
                                                     Min="0m"
                                                     Max="100m"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Dense="true"
                                                     Style="width: 70px;" />
                                </MudTd>
                                <MudTd DataLabel="Tax">
                                    <MudNumericField @bind-Value="context.TaxPercentage"
                                                     Min="0m"
                                                     Max="100m"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Dense="true"
                                                     Style="width: 70px;" />
                                </MudTd>
                                <MudTd DataLabel="Total">
                                    @CalculateLineTotal(context).ToString("C")
                                </MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => RemoveLineItem(context))" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>

                        <MudPaper Class="pa-3 mt-3">
                            <MudGrid>
                                <MudItem xs="12" Class="d-flex justify-end">
                                    <div style="min-width: 250px;">
                                        <div class="d-flex justify-space-between mb-2">
                                            <MudText Typo="Typo.body2">Subtotal:</MudText>
                                            <MudText Typo="Typo.body2">@CalculateSubtotal().ToString("C")</MudText>
                                        </div>
                                        <div class="d-flex justify-space-between mb-2">
                                            <MudText Typo="Typo.body2">Discount:</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Error">-@CalculateDiscount().ToString("C")</MudText>
                                        </div>
                                        <div class="d-flex justify-space-between mb-2">
                                            <MudText Typo="Typo.body2">Tax:</MudText>
                                            <MudText Typo="Typo.body2">@CalculateTax().ToString("C")</MudText>
                                        </div>
                                        <div class="d-flex justify-space-between mb-2">
                                            <MudText Typo="Typo.body2">Shipping:</MudText>
                                            <MudNumericField @bind-Value="_model.ShippingCost"
                                                           Min="0m"
                                                           Format="C2"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           Dense="true"
                                                           Style="width: 120px;" />
                                        </div>
                                        <MudDivider />
                                        <div class="d-flex justify-space-between mt-2">
                                            <MudText Typo="Typo.h6">Total:</MudText>
                                            <MudText Typo="Typo.h6" Color="Color.Primary">@CalculateTotal().ToString("C")</MudText>
                                        </div>
                                    </div>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">No line items added yet. Click "Add Line Item" to start.</MudAlert>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Shipping" Icon="@Icons.Material.Filled.LocalShipping">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudSelect @bind-Value="_model.ShippingMethod"
                                       Label="Shipping Method"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       T="ShippingMethod?">
                                <MudSelectItem Value="@((ShippingMethod?)null)">None</MudSelectItem>
                                @foreach (ShippingMethod method in Enum.GetValues(typeof(ShippingMethod)))
                                {
                                    <MudSelectItem Value="@((ShippingMethod?)method)">@method.ToString()</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.ShippingAddressLine1"
                                          Label="Address Line 1"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.ShippingAddressLine2"
                                          Label="Address Line 2"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_model.ShippingCity"
                                          Label="City"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField @bind-Value="_model.ShippingState"
                                          Label="State/Province"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField @bind-Value="_model.ShippingPostalCode"
                                          Label="Postal Code"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.ShippingCountry"
                                          Label="Country"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            </MudTabs>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@(!_isValid || _saving)">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(IsEdit ? "Update" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>
    /// The order being edited, or null for a new order.
    /// </summary>
    [Parameter] 
    public OrderDto? Order { get; set; }

    /// <summary>
    /// Whether this is an edit operation.
    /// </summary>
    [Parameter] 
    public bool IsEdit { get; set; } = false;

    private MudForm _form = null!;
    private bool _isValid = false;
    private bool _saving = false;
    private OrderFormModel _model = new();
    private CustomerPicker.CustomerDto? _selectedCustomer;
    private ProductPicker.ProductDto? _selectedProduct;
    private bool _showProductPanel = false;
    private decimal _productQuantity = 1;

    protected override void OnInitialized()
    {
        if (IsEdit && Order != null)
        {
            _model = new OrderFormModel
            {
                Id = Order.Id,
                CustomerId = Order.CustomerId,
                CustomerName = Order.CustomerName,
                CustomerEmail = Order.CustomerEmail,
                CustomerPhone = Order.CustomerPhone,
                ShippingMethod = Order.ShippingMethod,
                ShippingAddressLine1 = Order.ShippingAddressLine1,
                ShippingAddressLine2 = Order.ShippingAddressLine2,
                ShippingCity = Order.ShippingCity,
                ShippingState = Order.ShippingState,
                ShippingPostalCode = Order.ShippingPostalCode,
                ShippingCountry = Order.ShippingCountry,
                Notes = Order.Notes,
                ShippingCost = Order.ShippingCost,
                LineItems = Order.LineItems.Select(li => new OrderLineItemModel
                {
                    ProductId = li.ProductId,
                    ProductName = li.ProductName,
                    SKU = li.SKU,
                    Description = li.Description,
                    Quantity = li.Quantity,
                    UnitPrice = li.UnitPrice,
                    DiscountPercentage = li.DiscountPercentage,
                    TaxPercentage = li.TaxPercentage
                }).ToList()
            };
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _form != null)
        {
            // Initial validation
            await _form.ValidateAsync();
        }
    }

    private async Task OnCustomerSelectedAsync(CustomerPicker.CustomerDto? customer)
    {
        _selectedCustomer = customer;

        // Auto-fill customer fields when customer is selected
        if (customer != null)
        {
            _model.CustomerId = customer.Id;
            // Always use the customer's Name property (works for both individuals and companies)
            _model.CustomerName = !string.IsNullOrWhiteSpace(customer.Name) 
                ? customer.Name 
                : customer.CompanyName ?? "Unknown Customer";
            _model.CustomerEmail = customer.Email;
            _model.CustomerPhone = customer.Phone;

            // Revalidate the form after customer fields are populated
            if (_form != null)
            {
                await _form.ValidateAsync();
            }
        }
        else
        {
            // Customer was cleared
            _model.CustomerId = string.Empty;
            _model.CustomerName = string.Empty;
            _model.CustomerEmail = string.Empty;
            _model.CustomerPhone = string.Empty;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Keep this for initialization when editing an existing order
        if (_selectedCustomer != null)
        {
            _model.CustomerId = _selectedCustomer.Id;
            _model.CustomerName = !string.IsNullOrWhiteSpace(_selectedCustomer.Name) 
                ? _selectedCustomer.Name 
                : _selectedCustomer.CompanyName ?? "Unknown Customer";
            _model.CustomerEmail = _selectedCustomer.Email;
            _model.CustomerPhone = _selectedCustomer.Phone;

            if (_form != null)
            {
                await _form.ValidateAsync();
            }
        }
    }

    private void AddProductToOrder()
    {
        if (_selectedProduct != null)
        {
            _model.LineItems.Add(new OrderLineItemModel
            {
                ProductId = _selectedProduct.Id,
                ProductName = _selectedProduct.Name,
                SKU = _selectedProduct.SKU,
                Description = _selectedProduct.Description,
                Quantity = _productQuantity,
                UnitPrice = _selectedProduct.Price,
                DiscountPercentage = 0,
                TaxPercentage = 0
            });

            // Reset the panel
            _showProductPanel = false;
            _selectedProduct = null;
            _productQuantity = 1;
        }
    }

    private void CancelAddProduct()
    {
        _showProductPanel = false;
        _selectedProduct = null;
        _productQuantity = 1;
    }

    private void AddLineItem()
    {
        _model.LineItems.Add(new OrderLineItemModel
        {
            Quantity = 1,
            UnitPrice = 0,
            DiscountPercentage = 0,
            TaxPercentage = 0
        });
    }

    private void RemoveLineItem(OrderLineItemModel item)
    {
        _model.LineItems.Remove(item);
    }

    private decimal CalculateLineTotal(OrderLineItemModel item)
    {
        var subtotal = item.Quantity * item.UnitPrice;
        var discount = subtotal * (item.DiscountPercentage / 100);
        var taxable = subtotal - discount;
        var tax = taxable * (item.TaxPercentage / 100);
        return taxable + tax;
    }

    private decimal CalculateSubtotal()
    {
        return _model.LineItems.Sum(li => li.Quantity * li.UnitPrice);
    }

    private decimal CalculateDiscount()
    {
        return _model.LineItems.Sum(li =>
        {
            var subtotal = li.Quantity * li.UnitPrice;
            return subtotal * (li.DiscountPercentage / 100);
        });
    }

    private decimal CalculateTax()
    {
        return _model.LineItems.Sum(li =>
        {
            var subtotal = li.Quantity * li.UnitPrice;
            var discount = subtotal * (li.DiscountPercentage / 100);
            var taxable = subtotal - discount;
            return taxable * (li.TaxPercentage / 100);
        });
    }

    private decimal CalculateTotal()
    {
        var itemsTotal = _model.LineItems.Sum(li => CalculateLineTotal(li));
        return itemsTotal + _model.ShippingCost;
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        if (!_model.LineItems.Any())
        {
            Snackbar.Add("Please add at least one line item", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var client = HttpClientFactory.CreateClient("SalesApi");

            if (IsEdit)
            {
                var updateDto = new UpdateOrderDto
                {
                    Id = _model.Id,
                    CustomerId = _model.CustomerId,
                    CustomerName = _model.CustomerName,
                    CustomerEmail = _model.CustomerEmail,
                    CustomerPhone = _model.CustomerPhone,
                    ShippingMethod = _model.ShippingMethod,
                    ShippingAddressLine1 = _model.ShippingAddressLine1,
                    ShippingAddressLine2 = _model.ShippingAddressLine2,
                    ShippingCity = _model.ShippingCity,
                    ShippingState = _model.ShippingState,
                    ShippingPostalCode = _model.ShippingPostalCode,
                    ShippingCountry = _model.ShippingCountry,
                    Notes = _model.Notes,
                    ShippingCost = _model.ShippingCost,
                    LineItems = _model.LineItems.Select((li, idx) => new CreateOrderLineItemDto
                    {
                        ProductId = li.ProductId,
                        ProductName = li.ProductName,
                        SKU = li.SKU,
                        Description = li.Description,
                        Quantity = li.Quantity,
                        UnitPrice = li.UnitPrice,
                        DiscountPercentage = li.DiscountPercentage,
                        TaxPercentage = li.TaxPercentage,
                        SortOrder = idx
                    }).ToList()
                };

                var response = await client.PutAsJsonAsync($"api/sales/orders/{_model.Id}", updateDto);
                response.EnsureSuccessStatusCode();

                Snackbar.Add("Order updated successfully", Severity.Success);
            }
            else
            {
                var createDto = new CreateOrderDto
                {
                    CustomerId = _model.CustomerId,
                    CustomerName = _model.CustomerName,
                    CustomerEmail = _model.CustomerEmail,
                    CustomerPhone = _model.CustomerPhone,
                    ShippingMethod = _model.ShippingMethod,
                    ShippingAddressLine1 = _model.ShippingAddressLine1,
                    ShippingAddressLine2 = _model.ShippingAddressLine2,
                    ShippingCity = _model.ShippingCity,
                    ShippingState = _model.ShippingState,
                    ShippingPostalCode = _model.ShippingPostalCode,
                    ShippingCountry = _model.ShippingCountry,
                    Notes = _model.Notes,
                    ShippingCost = _model.ShippingCost,
                    LineItems = _model.LineItems.Select((li, idx) => new CreateOrderLineItemDto
                    {
                        ProductId = li.ProductId,
                        ProductName = li.ProductName,
                        SKU = li.SKU,
                        Description = li.Description,
                        Quantity = li.Quantity,
                        UnitPrice = li.UnitPrice,
                        DiscountPercentage = li.DiscountPercentage,
                        TaxPercentage = li.TaxPercentage,
                        SortOrder = idx
                    }).ToList()
                };

                var response = await client.PostAsJsonAsync("api/sales/orders", createDto);
                response.EnsureSuccessStatusCode();

                Snackbar.Add("Order created successfully", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving order: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>
    /// Form model for order creation and editing.
    /// </summary>
    public class OrderFormModel
    {
        public string Id { get; set; } = string.Empty;
        public string CustomerId { get; set; } = string.Empty;
        public string CustomerName { get; set; } = string.Empty;
        public string? CustomerEmail { get; set; }
        public string? CustomerPhone { get; set; }
        public ShippingMethod? ShippingMethod { get; set; }
        public string? ShippingAddressLine1 { get; set; }
        public string? ShippingAddressLine2 { get; set; }
        public string? ShippingCity { get; set; }
        public string? ShippingState { get; set; }
        public string? ShippingPostalCode { get; set; }
        public string? ShippingCountry { get; set; }
        public string? Notes { get; set; }
        public decimal ShippingCost { get; set; } = 0m;
        public List<OrderLineItemModel> LineItems { get; set; } = new();
    }

    /// <summary>
    /// Form model for order line items.
    /// </summary>
    public class OrderLineItemModel
    {
        public string? ProductId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public string? SKU { get; set; }
        public string? Description { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal DiscountPercentage { get; set; } = 0;
        public decimal TaxPercentage { get; set; } = 0;
    }
}
