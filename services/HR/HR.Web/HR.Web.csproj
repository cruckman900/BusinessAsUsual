<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\HR.Application\HR.Application.csproj" />
    <ProjectReference Include="..\HR.Infrastructure\HR.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Platform\Platform.Application\Platform.Application.csproj" />
    <ProjectReference Include="..\..\Platform\Platform.Infrastructure\Platform.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Platform\Platform.Web\Platform.Web.csproj">
      <ExcludeAssets>contentfiles</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\..\backend\BusinessAsUsual.Application\BusinessAsUsual.Application.csproj" />
    <ProjectReference Include="..\..\..\shared\BusinessAsUsual.Shared.UI\BusinessAsUsual.Shared.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.10" />
    <PackageReference Include="MudBlazor" Version="9.6.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>_content/HR.Web</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude bootstrap from static web assets to avoid conflicts with parent shell -->
    <Content Remove="wwwroot\lib\bootstrap\**" />
    <None Include="wwwroot\lib\bootstrap\**">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Exclude Platform.Web content files from publish output to prevent conflicts -->
  <Target Name="ExcludePlatformWebContentFromPublish" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'appsettings.json' AND $([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').Contains('Platform.Web'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'appsettings.Development.json' AND $([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').Contains('Platform.Web'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Folder Include="Themes\" />
  </ItemGroup>

</Project>
