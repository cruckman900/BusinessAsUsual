@page "/hr/performance-hub"
@using MudBlazor
@inject NavigationManager NavigationManager

<PageTitle>Performance Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/hr">HR</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Performance Management</MudText>
    </div>

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-2" />
                Performance Management
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Track employee reviews, set goals, and manage performance improvement plans
            </MudText>
        </div>
    </div>

    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="pa-4" Style="cursor: pointer; height: 100%;" @onclick="@(() => Navigate("/hr/reviews"))">
                <MudCardContent>
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.RateReview" Size="Size.Large" Color="Color.Primary" Class="mr-3" />
                        <MudText Typo="Typo.h6">Performance Reviews</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Conduct and track annual, quarterly, and ad-hoc performance evaluations
                    </MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/hr/reviews">
                        View Reviews →
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="pa-4" Style="cursor: pointer; height: 100%;" @onclick="@(() => Navigate("/hr/goals"))">
                <MudCardContent>
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.TrackChanges" Size="Size.Large" Color="Color.Success" Class="mr-3" />
                        <MudText Typo="Typo.h6">Goals & Objectives</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Set, track, and measure individual and team goals aligned with company objectives
                    </MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/hr/goals">
                        View Goals →
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="pa-4" Style="height: 100%;">
                <MudCardContent>
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" Color="Color.Info" Class="mr-3" />
                        <MudText Typo="Typo.h6">360° Feedback</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Gather multi-rater feedback from peers, managers, and direct reports
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">Coming Soon</MudChip>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="pa-4" Style="height: 100%;">
                <MudCardContent>
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Large" Color="Color.Warning" Class="mr-3" />
                        <MudText Typo="Typo.h6">Performance Improvement Plans</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Document and track improvement plans for underperforming employees
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">Coming Soon</MudChip>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="pa-4" Style="height: 100%;">
                <MudCardContent>
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.StarRate" Size="Size.Large" Color="Color.Secondary" Class="mr-3" />
                        <MudText Typo="Typo.h6">Competency Matrix</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Define and assess employee skills, competencies, and development areas
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">Coming Soon</MudChip>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="pa-4" Style="height: 100%;">
                <MudCardContent>
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Large" Color="Color.Tertiary" Class="mr-3" />
                        <MudText Typo="Typo.h6">Performance Analytics</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Analyze performance trends, ratings distribution, and team metrics
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">Coming Soon</MudChip>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Quick Stats & Actions Section -->
    <MudGrid Class="mt-6">
        <MudItem xs="12">
            <MudText Typo="Typo.h6" Class="mb-3">Quick Actions</MudText>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2" GutterBottom="true">Common Tasks</MudText>
                    <MudList T="string" Dense="true">
                        <MudListItem Icon="@Icons.Material.Filled.RateReview" Href="/hr/reviews">
                            View Performance Reviews
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Add">
                            Create New Review
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.TrackChanges">
                            Set Team Goals
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.TrendingUp">
                            Request 360° Feedback
                        </MudListItem>
                    </MudList>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2" GutterBottom="true">Performance Insights</MudText>
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true" Class="my-2">
                        <strong>Overdue Reviews:</strong> 8 reviews need completion
                    </MudAlert>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="my-2">
                        <strong>Goal Progress:</strong> 67% of team goals on track
                    </MudAlert>
                    <MudAlert Severity="Severity.Success" Variant="Variant.Text" Dense="true" Class="my-2">
                        <strong>Top Performers:</strong> 12 employees rated 4.5+
                    </MudAlert>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private void Navigate(string url)
    {
        NavigationManager.NavigateTo(url);
    }
}
