@page "/finance/payables/vendor-payments"
@using Finance.Application.DTOs
@using System.Net.Http.Json
@using Finance.Web.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Vendor Payments</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/finance">Finance</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/finance/payables">Accounts Payable</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Vendor Payments</MudText>
    </div>

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.Payment" Class="mr-2" />
                Vendor Payments
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Schedule and issue payments to vendors</MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => _createDialogVisible = true)">
            Record Vendor Payment
        </MudButton>
    </div>

    <CustomDataGrid TItem="VendorPaymentDto"
                    Items="@_payments"
                    Loading="@_loading"
                    Hover="true"
                    Dense="true"
                    Striped="true"
                    ShowToolbar="false"
                    ShowSearch="false">
        <ChildContent>
            <PropertyColumn Property="x => x.VendorName" Title="Vendor" T="VendorPaymentDto" TProperty="string">
                <CellTemplate>
                    @(context.Item.VendorName ?? "-")
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.BillNumber" Title="Bill #" T="VendorPaymentDto" TProperty="string">
                <CellTemplate>
                    @(context.Item.BillNumber ?? "-")
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Amount" Title="Amount" Format="C2" T="VendorPaymentDto" TProperty="decimal" />
            <PropertyColumn Property="x => x.Method" Title="Method" T="VendorPaymentDto" TProperty="string" />
            <PropertyColumn Property="x => x.Status" Title="Status" T="VendorPaymentDto" TProperty="string">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">
                        @context.Item.Status
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.PaymentDate" Title="Date" Format="d" T="VendorPaymentDto" TProperty="DateTime" />
            <PropertyColumn Property="x => x.TransactionReference" Title="Reference" T="VendorPaymentDto" TProperty="string">
                <CellTemplate>
                    @(context.Item.TransactionReference ?? "-")
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="Actions" Sortable="false" Filterable="false" T="VendorPaymentDto">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(() => DeletePaymentAsync(context.Item.Id))" />
                </CellTemplate>
            </TemplateColumn>
        </ChildContent>
    </CustomDataGrid>

    @if (!_payments.Any() && !_loading)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mt-4">
            No vendor payments recorded yet. Record your first payment to get started.
        </MudAlert>
    }
</MudContainer>

<MudDialog @bind-Visible="_createDialogVisible" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">Record Vendor Payment</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudTextField @bind-Value="_billId" Label="Bill ID (optional)" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="_amount" Label="Amount" Min="0m" Variant="Variant.Outlined" Format="C2" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_method" Label="Payment Method" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("CreditCard")">Credit Card</MudSelectItem>
                    <MudSelectItem Value="@("BankTransfer")">Bank Transfer</MudSelectItem>
                    <MudSelectItem Value="@("Cash")">Cash</MudSelectItem>
                    <MudSelectItem Value="@("Check")">Check</MudSelectItem>
                    <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_status" Label="Status" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
                    <MudSelectItem Value="@("Completed")">Completed</MudSelectItem>
                    <MudSelectItem Value="@("Failed")">Failed</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="_paymentDate" Label="Payment Date" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_transactionReference" Label="Transaction Reference" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_notes" Label="Notes" Lines="2" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _createDialogVisible = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RecordPaymentAsync" Disabled="_submitting">
            @(_submitting ? "Recording..." : "Record Payment")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _loading = true;
    private List<VendorPaymentDto> _payments = new();

    private bool _createDialogVisible;
    private string _billId = "";
    private decimal _amount = 0m;
    private string _method = "BankTransfer";
    private string _status = "Completed";
    private DateTime? _paymentDate = DateTime.Today;
    private string _transactionReference = "";
    private string _notes = "";
    private bool _submitting;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var http = HttpClientFactory.CreateClient("FinanceApi");
            var result = await http.GetFromJsonAsync<List<VendorPaymentDto>>("api/vendorpayments");
            _payments = result ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load vendor payments: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RecordPaymentAsync()
    {
        _error = null;
        if (_amount <= 0) { _error = "Amount must be greater than zero."; return; }

        _submitting = true;
        try
        {
            var http = HttpClientFactory.CreateClient("FinanceApi");
            var request = new
            {
                BillId = string.IsNullOrWhiteSpace(_billId) ? null : _billId,
                Amount = _amount,
                Currency = 0,
                Method = _method switch { "CreditCard" => 1, "BankTransfer" => 2, "Cash" => 3, "Check" => 4, _ => 6 },
                Status = _status switch { "Pending" => 0, "Completed" => 1, "Failed" => 2, _ => 1 },
                PaymentDate = _paymentDate,
                TransactionReference = _transactionReference,
                Notes = _notes
            };

            var response = await http.PostAsJsonAsync("api/vendorpayments", request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Vendor payment recorded successfully", Severity.Success);
                _createDialogVisible = false;
                ResetForm();
                await LoadAsync();
            }
            else _error = $"Failed to record payment: {response.StatusCode}";
        }
        catch (Exception ex) { _error = $"Error recording payment: {ex.Message}"; }
        finally { _submitting = false; }
    }

    private async Task DeletePaymentAsync(string id)
    {
        try
        {
            var http = HttpClientFactory.CreateClient("FinanceApi");
            var response = await http.DeleteAsync($"api/vendorpayments/{id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Vendor payment deleted", Severity.Success);
                await LoadAsync();
            }
            else Snackbar.Add($"Failed to delete payment", Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
    }

    private void ResetForm()
    {
        _billId = "";
        _amount = 0m;
        _method = "BankTransfer";
        _status = "Completed";
        _paymentDate = DateTime.Today;
        _transactionReference = "";
        _notes = "";
    }

    private static Color StatusColor(string status) => status switch
    {
        "Pending" => Color.Warning,
        "Completed" => Color.Success,
        "Failed" => Color.Error,
        _ => Color.Default
    };
}

