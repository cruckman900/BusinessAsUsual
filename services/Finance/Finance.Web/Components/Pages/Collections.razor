@page "/finance/receivables/collections"
@using Finance.Application.DTOs
@using System.Net.Http.Json
@using Finance.Web.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Collections</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/finance">Finance</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/finance/receivables">Accounts Receivable</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Collections</MudText>
    </div>

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Class="mr-2" />
                Collections
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Follow up on overdue receivables</MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => _createActivityDialogVisible = true)">
            Log Activity
        </MudButton>
    </div>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
        <!-- Aging Report Tab -->
        <MudTabPanel Text="Aging Report" Icon="@Icons.Material.Filled.Assessment">
            @if (_loadingReport)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else if (_agingReport != null)
            {
                <MudPaper Class="pa-4 mb-4">
                    <MudText Typo="Typo.h6" Class="mb-2">AR Aging Summary as of @_agingReport.ReportDate.ToString("MMM dd, yyyy")</MudText>
                    <MudGrid>
                        <MudItem xs="6" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Current</MudText>
                            <MudText Typo="Typo.h6">@_agingReport.TotalCurrent.ToString("C0")</MudText>
                        </MudItem>
                        <MudItem xs="6" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">1-30 Days</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Info">@_agingReport.Total30Days.ToString("C0")</MudText>
                        </MudItem>
                        <MudItem xs="6" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">31-60 Days</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Warning">@_agingReport.Total60Days.ToString("C0")</MudText>
                        </MudItem>
                        <MudItem xs="6" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">61-90 Days</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Error">@_agingReport.Total90Days.ToString("C0")</MudText>
                        </MudItem>
                        <MudItem xs="6" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">90+ Days</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Error">@_agingReport.Total120Plus.ToString("C0")</MudText>
                        </MudItem>
                        <MudItem xs="6" md="2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Total</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Primary">@_agingReport.GrandTotal.ToString("C0")</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <CustomDataGrid TItem="AgingBucketDto"
                                Items="_agingReport.Buckets"
                                Hover="true"
                                Dense="true"
                                Striped="true"
                                ShowToolbar="false"
                                ShowSearch="false">
                    <ChildContent>
                        <PropertyColumn Property="x => x.CustomerName" Title="Customer" T="AgingBucketDto" TProperty="string" />
                        <PropertyColumn Property="x => x.Current" Title="Current" Format="C0" T="AgingBucketDto" TProperty="decimal" />
                        <PropertyColumn Property="x => x.Days30" Title="1-30" T="AgingBucketDto" TProperty="decimal">
                            <CellTemplate>
                                <MudText Color="@(context.Item.Days30 > 0 ? Color.Info : Color.Default)">
                                    @context.Item.Days30.ToString("C0")
                                </MudText>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Days60" Title="31-60" T="AgingBucketDto" TProperty="decimal">
                            <CellTemplate>
                                <MudText Color="@(context.Item.Days60 > 0 ? Color.Warning : Color.Default)">
                                    @context.Item.Days60.ToString("C0")
                                </MudText>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Days90" Title="61-90" T="AgingBucketDto" TProperty="decimal">
                            <CellTemplate>
                                <MudText Color="@(context.Item.Days90 > 0 ? Color.Error : Color.Default)">
                                    @context.Item.Days90.ToString("C0")
                                </MudText>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Days120Plus" Title="90+" T="AgingBucketDto" TProperty="decimal">
                            <CellTemplate>
                                <MudText Color="@(context.Item.Days120Plus > 0 ? Color.Error : Color.Default)">
                                    @context.Item.Days120Plus.ToString("C0")
                                </MudText>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.TotalOverdue" Title="Total" T="AgingBucketDto" TProperty="decimal">
                            <CellTemplate>
                                <MudText Typo="Typo.body2" Style="font-weight: bold">
                                    @context.Item.TotalOverdue.ToString("C0")
                                </MudText>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.OverdueInvoiceCount" Title="Invoices" T="AgingBucketDto" TProperty="int" />
                    </ChildContent>
                </CustomDataGrid>
            }
        </MudTabPanel>

        <!-- Activities Tab -->
        <MudTabPanel Text="Activities" Icon="@Icons.Material.Filled.ListAlt">
            @if (_loadingActivities)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else if (_activities.Any())
            {
                <CustomDataGrid TItem="CollectionActivityDto"
                                Items="_activities"
                                Hover="true"
                                Dense="true"
                                Striped="true"
                                ShowToolbar="false"
                                ShowSearch="false">
                    <ChildContent>
                        <PropertyColumn Property="x => x.ActivityDate" Title="Date" Format="MMM dd, yyyy" T="CollectionActivityDto" TProperty="DateTime" />
                        <PropertyColumn Property="x => x.InvoiceNumber" Title="Invoice" T="CollectionActivityDto" TProperty="string" />
                        <PropertyColumn Property="x => x.CustomerName" Title="Customer" T="CollectionActivityDto" TProperty="string" />
                        <PropertyColumn Property="x => x.ActivityType" Title="Type" T="CollectionActivityDto" TProperty="string" />
                        <TemplateColumn Title="Contact" Sortable="false" Filterable="false" T="CollectionActivityDto">
                            <CellTemplate>
                                @(context.Item.ContactPerson ?? context.Item.ContactMethod ?? "-")
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.Outcome" Title="Outcome" T="CollectionActivityDto" TProperty="string">
                            <CellTemplate>
                                @(context.Item.Outcome ?? "-")
                            </CellTemplate>
                        </PropertyColumn>
                        <TemplateColumn Title="Promised" Sortable="false" Filterable="false" T="CollectionActivityDto">
                            <CellTemplate>
                                @if (context.Item.PromisedPaymentDate.HasValue)
                                {
                                    <span>@context.Item.PromisedPaymentDate.Value.ToString("MMM dd") - @context.Item.PromisedAmount?.ToString("C0")</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.Status" Title="Status" T="CollectionActivityDto" TProperty="string">
                            <CellTemplate>
                                <MudChip T="string" Size="Size.Small" Color="@(context.Item.Status == "Open" ? Color.Warning : Color.Success)">
                                    @context.Item.Status
                                </MudChip>
                            </CellTemplate>
                        </PropertyColumn>
                        <TemplateColumn Title="Actions" Sortable="false" Filterable="false" T="CollectionActivityDto">
                            <CellTemplate>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenEditActivityDialog(context.Item))"
                                               Title="Edit Activity" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteActivityAsync(context.Item.Id))"
                                               Title="Delete Activity" />
                            </CellTemplate>
                        </TemplateColumn>
                    </ChildContent>
                </CustomDataGrid>
            }
            else
            {
                <MudAlert Severity="Severity.Info">No collection activities logged yet.</MudAlert>
            }
        </MudTabPanel>
    </MudTabs>
</MudContainer>

<!-- Create Activity Dialog -->
<MudDialog @bind-Visible="_createActivityDialogVisible" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">Log Collection Activity</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudTextField @bind-Value="_invoiceId" Label="Invoice ID" Required="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_activityType" Label="Activity Type" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Phone Call")">Phone Call</MudSelectItem>
                    <MudSelectItem Value="@("Email")">Email</MudSelectItem>
                    <MudSelectItem Value="@("Letter")">Letter</MudSelectItem>
                    <MudSelectItem Value="@("Meeting")">Meeting</MudSelectItem>
                    <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_contactPerson" Label="Contact Person" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_notes" Label="Notes" Lines="3" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_outcome" Label="Outcome" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Payment Promised")">Payment Promised</MudSelectItem>
                    <MudSelectItem Value="@("Dispute Raised")">Dispute Raised</MudSelectItem>
                    <MudSelectItem Value="@("No Response")">No Response</MudSelectItem>
                    <MudSelectItem Value="@("Payment Plan Agreed")">Payment Plan Agreed</MudSelectItem>
                    <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="_promisedPaymentDate" Label="Promised Payment Date" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudNumericField @bind-Value="_promisedAmount" Label="Promised Amount" Min="0m" Variant="Variant.Outlined" Format="C2" />
            </MudItem>
        </MudGrid>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _createActivityDialogVisible = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateActivityAsync" Disabled="_submitting">
            @(_submitting ? "Logging..." : "Log Activity")
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Edit Activity Dialog -->
<MudDialog @bind-Visible="_editActivityDialogVisible" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">Edit Collection Activity</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_editOutcome" Label="Outcome" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Payment Promised")">Payment Promised</MudSelectItem>
                    <MudSelectItem Value="@("Dispute Raised")">Dispute Raised</MudSelectItem>
                    <MudSelectItem Value="@("No Response")">No Response</MudSelectItem>
                    <MudSelectItem Value="@("Payment Plan Agreed")">Payment Plan Agreed</MudSelectItem>
                    <MudSelectItem Value="@("Paid")">Paid</MudSelectItem>
                    <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_editStatus" Label="Status" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Open")">Open</MudSelectItem>
                    <MudSelectItem Value="@("Closed")">Closed</MudSelectItem>
                    <MudSelectItem Value="@("Follow-up Required")">Follow-up Required</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_editNotes" Label="Notes" Lines="3" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="_editPromisedPaymentDate" Label="Promised Payment Date" Variant="Variant.Outlined" Clearable="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="_editPromisedAmount" Label="Promised Amount" Min="0m" Variant="Variant.Outlined" Format="C2" />
            </MudItem>
        </MudGrid>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _editActivityDialogVisible = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UpdateActivityAsync" Disabled="_submitting">
            @(_submitting ? "Updating..." : "Update Activity")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _loadingReport = true;
    private bool _loadingActivities = true;
    private AgingReportDto? _agingReport;
    private List<CollectionActivityDto> _activities = new();

    private bool _createActivityDialogVisible;
    private string _invoiceId = "";
    private string _activityType = "Phone Call";
    private string _contactPerson = "";
    private string _notes = "";
    private string _outcome = "Payment Promised";
    private DateTime? _promisedPaymentDate;
    private decimal? _promisedAmount;
    private bool _submitting;
    private string? _error;

    // Edit dialog state
    private bool _editActivityDialogVisible;
    private string _editActivityId = "";
    private string _editOutcome = "";
    private string _editStatus = "Open";
    private string _editNotes = "";
    private DateTime? _editPromisedPaymentDate;
    private decimal? _editPromisedAmount;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadAgingReportAsync(), LoadActivitiesAsync());
    }

    private async Task LoadAgingReportAsync()
    {
        _loadingReport = true;
        try
        {
            var http = HttpClientFactory.CreateClient("FinanceApi");
            _agingReport = await http.GetFromJsonAsync<AgingReportDto>("api/collections/aging-report");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load aging report: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingReport = false;
        }
    }

    private async Task LoadActivitiesAsync()
    {
        _loadingActivities = true;
        try
        {
            var http = HttpClientFactory.CreateClient("FinanceApi");
            var result = await http.GetFromJsonAsync<List<CollectionActivityDto>>("api/collections/activities");
            _activities = result ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load activities: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingActivities = false;
        }
    }

    private async Task CreateActivityAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_invoiceId))
        {
            _error = "Invoice ID is required.";
            return;
        }

        _submitting = true;
        try
        {
            var http = HttpClientFactory.CreateClient("FinanceApi");
            var request = new
            {
                InvoiceId = _invoiceId,
                ActivityType = _activityType,
                ContactPerson = _contactPerson,
                ContactMethod = _activityType,
                Notes = _notes,
                Outcome = _outcome,
                PromisedPaymentDate = _promisedPaymentDate,
                PromisedAmount = _promisedAmount
            };

            var response = await http.PostAsJsonAsync("api/collections/activities", request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Activity logged successfully", Severity.Success);
                _createActivityDialogVisible = false;
                ResetForm();
                await LoadActivitiesAsync();
            }
            else
            {
                _error = $"Failed to log activity: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _error = $"Error: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task DeleteActivityAsync(string id)
    {
        try
        {
            var http = HttpClientFactory.CreateClient("FinanceApi");
            var response = await http.DeleteAsync($"api/collections/activities/{id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Activity deleted", Severity.Success);
                await LoadActivitiesAsync();
            }
            else
            {
                Snackbar.Add("Failed to delete activity", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void OpenEditActivityDialog(CollectionActivityDto activity)
    {
        _editActivityId = activity.Id;
        _editOutcome = activity.Outcome ?? "";
        _editStatus = activity.Status;
        _editNotes = activity.Notes ?? "";
        _editPromisedPaymentDate = activity.PromisedPaymentDate;
        _editPromisedAmount = activity.PromisedAmount;
        _editActivityDialogVisible = true;
        _error = null;
    }

    private async Task UpdateActivityAsync()
    {
        _error = null;
        _submitting = true;
        try
        {
            var http = HttpClientFactory.CreateClient("FinanceApi");
            var request = new
            {
                Outcome = _editOutcome,
                Status = _editStatus,
                Notes = _editNotes,
                PromisedPaymentDate = _editPromisedPaymentDate,
                PromisedAmount = _editPromisedAmount
            };

            var response = await http.PutAsJsonAsync($"api/collections/activities/{_editActivityId}", request);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Activity updated successfully", Severity.Success);
                _editActivityDialogVisible = false;
                await LoadActivitiesAsync();
            }
            else
            {
                _error = $"Failed to update activity: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _error = $"Error: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void ResetForm()
    {
        _invoiceId = "";
        _activityType = "Phone Call";
        _contactPerson = "";
        _notes = "";
        _outcome = "Payment Promised";
        _promisedPaymentDate = null;
        _promisedAmount = null;
    }
}

