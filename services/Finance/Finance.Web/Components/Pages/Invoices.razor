@page "/finance/invoices"
@using Finance.Web.Components.Shared
@inject IInvoiceService InvoiceService
@inject ISnackbar Snackbar

<PageTitle>Invoices</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/finance">Finance</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Invoices</MudText>
    </div>

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" />
                Invoices
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Create and manage customer invoices</MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/finance/invoices/create">
            Create Invoice
        </MudButton>
    </div>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <CustomDataGrid TItem="InvoiceDto" Items="@_invoices" Title="Invoices" 
                        ShowSearch="true" SearchPlaceholder="Search invoices..." 
                        Filterable="true" Hideable="true" SortMode="SortMode.Multiple"
                        RowsPerPage="25" Elevation="2">
            <ChildContent>
                <PropertyColumn T="InvoiceDto" TProperty="string" Property="@(x => x.InvoiceNumber)" Title="Invoice #" />
                <PropertyColumn T="InvoiceDto" TProperty="string" Property="@(x => x.CustomerName)" Title="Customer" />
                <PropertyColumn T="InvoiceDto" TProperty="decimal" Property="@(x => x.Total)" Title="Total" Format="C2" />
                <PropertyColumn T="InvoiceDto" TProperty="decimal" Property="@(x => x.BalanceDue)" Title="Balance" Format="C2" />
                <TemplateColumn T="InvoiceDto" Title="Status">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">@context.Item.Status</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="InvoiceDto" Title="Due">
                    <CellTemplate>
                        @(context.Item.DueDate?.ToString("d") ?? "-")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="InvoiceDto" Title="Actions" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudButtonGroup Variant="Variant.Text" Size="Size.Small">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Href="@($"/finance/invoices/edit/{context.Item.Id}")"
                                           Title="Edit" />
                            @if (context.Item.Status == "Draft")
                            {
                                <MudButton Color="Color.Info" OnClick="@(() => SendAsync(context.Item.Id))">Send</MudButton>
                            }
                        </MudButtonGroup>
                    </CellTemplate>
                </TemplateColumn>
            </ChildContent>
        </CustomDataGrid>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private List<InvoiceDto> _invoices = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _invoices = (await InvoiceService.GetAllInvoicesAsync()).ToList();
        _loading = false;
    }

    private async Task SendAsync(string id)
    {
        await InvoiceService.SendInvoiceAsync(id);
        Snackbar.Add("Invoice sent", Severity.Success);
        await LoadAsync();
    }

    private static Color StatusColor(string status) => status switch
    {
        "Draft" => Color.Default,
        "Sent" => Color.Info,
        "PartiallyPaid" => Color.Warning,
        "Paid" => Color.Success,
        "Overdue" => Color.Error,
        _ => Color.Default
    };
}
