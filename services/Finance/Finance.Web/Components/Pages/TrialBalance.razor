@page "/finance/gl/trial-balance"
@using Finance.Application.DTOs
@using System.Net.Http.Json
@using Finance.Web.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar

<PageTitle>Trial Balance - Finance</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/finance">Finance</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/finance/gl">General Ledger</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Trial Balance</MudText>
    </div>

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="mr-2" />
                Trial Balance
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Verify ledger balance integrity</MudText>
        </div>
        <MudDatePicker @bind-Date="_asOfDate" Label="As Of Date" Variant="Variant.Outlined" />
    </div>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_trialBalance != null)
    {
        <!-- Balance Summary -->
        <MudPaper Class="pa-4 mb-4">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">As Of Date</MudText>
                    <MudText Typo="Typo.h6">@_trialBalance.AsOfDate.ToString("MMM dd, yyyy")</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Debits</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Success">@_trialBalance.TotalDebits.ToString("C2")</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Credits</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Error">@_trialBalance.TotalCredits.ToString("C2")</MudText>
                </MudItem>
            </MudGrid>

            @if (_trialBalance.IsBalanced)
            {
                <MudAlert Severity="Severity.Success" Class="mt-4" Icon="@Icons.Material.Filled.CheckCircle">
                    Trial balance is in balance! Debits equal Credits.
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Icon="@Icons.Material.Filled.Error">
                    <strong>Out of Balance!</strong> Difference: @Math.Abs(_trialBalance.TotalDebits - _trialBalance.TotalCredits).ToString("C2")
                </MudAlert>
            }
        </MudPaper>

        <!-- Trial Balance Table -->
        <CustomDataGrid TItem="TrialBalanceLineDto"
                        Items="@_trialBalance.Lines"
                        Hover="true"
                        Dense="true"
                        Striped="true"
                        Elevation="2"
                        ShowToolbar="false"
                        ShowSearch="false">
            <ChildContent>
                <PropertyColumn Property="x => x.AccountNumber" Title="Account Number" T="TrialBalanceLineDto" TProperty="string">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Style="font-weight: bold">@context.Item.AccountNumber</MudText>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.AccountName" Title="Account Name" T="TrialBalanceLineDto" TProperty="string" />
                <PropertyColumn Property="x => x.AccountType" Title="Type" T="TrialBalanceLineDto" TProperty="AccountType">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@GetTypeColor(context.Item.AccountType)">@context.Item.AccountType</MudChip>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.DebitBalance" Title="Debit" T="TrialBalanceLineDto" TProperty="decimal">
                    <CellTemplate>
                        <div style="text-align: right">
                            @if (context.Item.DebitBalance > 0)
                            {
                                <MudText Typo="Typo.body2">@context.Item.DebitBalance.ToString("C2")</MudText>
                            }
                        </div>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.CreditBalance" Title="Credit" T="TrialBalanceLineDto" TProperty="decimal">
                    <CellTemplate>
                        <div style="text-align: right">
                            @if (context.Item.CreditBalance > 0)
                            {
                                <MudText Typo="Typo.body2">@context.Item.CreditBalance.ToString("C2")</MudText>
                            }
                        </div>
                    </CellTemplate>
                </PropertyColumn>
            </ChildContent>
        </CustomDataGrid>

        <!-- Summary Footer -->
        <MudPaper Class="pa-4 mt-2" Elevation="2">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6" Color="Color.Success">Total Debits: @_trialBalance.TotalDebits.ToString("C2")</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6" Color="Color.Error">Total Credits: @_trialBalance.TotalCredits.ToString("C2")</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- Account Type Breakdown -->
        <MudGrid Class="mt-4">
            @foreach (AccountType type in Enum.GetValues(typeof(AccountType)))
            {
                var typeLines = _trialBalance.Lines.Where(l => l.AccountType == type).ToList();
                if (typeLines.Any())
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard>
                            <MudCardContent>
                                <MudText Typo="Typo.h6" Color="@GetTypeColor(type)">@type</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@typeLines.Count account(s)</MudText>
                                <MudDivider Class="my-2" />
                                <MudText Typo="Typo.body2">
                                    Debit: @typeLines.Sum(l => l.DebitBalance).ToString("C2")
                                </MudText>
                                <MudText Typo="Typo.body2">
                                    Credit: @typeLines.Sum(l => l.CreditBalance).ToString("C2")
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private HttpClient _httpClient = default!;
    private TrialBalanceDto? _trialBalance;
    private bool _loading = true;
    private DateTime? _asOfDate = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        _httpClient = HttpClientFactory.CreateClient("FinanceApi");
        await LoadTrialBalanceAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_asOfDate.HasValue)
            await LoadTrialBalanceAsync();
    }

    private async Task LoadTrialBalanceAsync()
    {
        _loading = true;
        try
        {
            var date = _asOfDate ?? DateTime.Now;
            _trialBalance = await _httpClient.GetFromJsonAsync<TrialBalanceDto>(
                $"api/generalledger/trial-balance?asOfDate={date:yyyy-MM-dd}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load trial balance: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static Color GetTypeColor(AccountType type) => type switch
    {
        AccountType.Asset => Color.Success,
        AccountType.Liability => Color.Error,
        AccountType.Equity => Color.Info,
        AccountType.Revenue => Color.Primary,
        AccountType.Expense => Color.Warning,
        _ => Color.Default
    };
}
