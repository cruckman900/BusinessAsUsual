@page "/inventory/stock"
@using MudBlazor
@inject NavigationManager NavigationManager

<PageTitle>Stock Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/inventory">Inventory</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Stock Management</MudText>
    </div>

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="mr-2" />
                Stock Management
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                View stock levels, adjustments, and transfers across all warehouses
            </MudText>
        </div>
    </div>

    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="pa-4" Style="cursor: pointer; height: 100%;" @onclick="@(() => Navigate("/inventory/stock/items"))">
                <MudCardContent>
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Large" Color="Color.Primary" Class="mr-3" />
                        <MudText Typo="Typo.h6">Stock Items</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        View detailed stock levels by product, warehouse, and bin location with real-time availability
                    </MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/inventory/stock/items">
                        View Items →
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudCardContent>
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Large" Color="Color.Default" Class="mr-3" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary">Stock Adjustments</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Record inventory count adjustments, corrections, and manual stock changes with full audit trail
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" Class="mb-2">Coming Soon</MudChip>
                    <MudButton Variant="Variant.Text" Color="Color.Default" Disabled="true">
                        Coming Soon
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudCardContent>
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Large" Color="Color.Default" Class="mr-3" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary">Stock Transfers</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Move inventory between warehouses and bin locations with complete transfer history
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" Class="mb-2">Coming Soon</MudChip>
                    <MudButton Variant="Variant.Text" Color="Color.Default" Disabled="true">
                        Coming Soon
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudCardContent>
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Large" Color="Color.Default" Class="mr-3" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary">Cycle Counts</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Schedule and perform regular inventory counts to ensure stock accuracy
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" Class="mb-2">Coming Soon</MudChip>
                    <MudButton Variant="Variant.Text" Color="Color.Default" Disabled="true">
                        Coming Soon
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="pa-4" Style="height: 100%;">
                <MudCardContent>
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Large" Color="Color.Secondary" Class="mr-3" />
                        <MudText Typo="Typo.h6">Transaction History</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        View complete audit trail of all inventory movements and changes
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">Coming Soon</MudChip>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="pa-4" Style="height: 100%;">
                <MudCardContent>
                    <div class="d-flex align-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Large" Color="Color.Error" Class="mr-3" />
                        <MudText Typo="Typo.h6">Low Stock Alerts</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Monitor products below reorder point and receive automated notifications
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">Coming Soon</MudChip>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudCard Class="mt-6">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                    Stock Management Overview
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudText Typo="Typo.body1" GutterBottom="true">
                The Stock Management module provides comprehensive tools for tracking and managing inventory across multiple locations:
            </MudText>
            <MudList T="string" Dense="true">
                <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle">
                    <MudText><strong>Real-time visibility</strong> - Track stock levels, allocations, and availability across all warehouses</MudText>
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle">
                    <MudText><strong>Stock adjustments</strong> - Record inventory corrections with reasons and approval workflows</MudText>
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle">
                    <MudText><strong>Inter-warehouse transfers</strong> - Move stock between locations with automated tracking</MudText>
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle">
                    <MudText><strong>Cycle counting</strong> - Schedule regular counts to maintain inventory accuracy</MudText>
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle">
                    <MudText><strong>Complete audit trail</strong> - Track all inventory movements with timestamps and user attribution</MudText>
                </MudListItem>
            </MudList>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private void Navigate(string url)
    {
        NavigationManager.NavigateTo(url);
    }
}
