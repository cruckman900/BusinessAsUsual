@page "/inventory/stock/cycle-counts"
@using MudBlazor

<PageTitle>Cycle Counts</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/inventory">Inventory</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/inventory/stock">Stock Management</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Cycle Counts</MudText>
    </div>

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.FactCheck" Class="mr-2" />
                Cycle Counts
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Schedule and perform regular inventory counts to ensure accuracy
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="true">
            Schedule Count
        </MudButton>
    </div>

    <MudCard Class="mb-4">
        <MudCardContent>
            <MudAlert Severity="Severity.Info" Class="mb-4">
                <strong>Cycle Counting Best Practices:</strong>
                <ul class="mt-2">
                    <li>Count high-value items more frequently (A-items)</li>
                    <li>Establish regular counting schedules based on ABC classification</li>
                    <li>Assign dedicated personnel with proper training</li>
                    <li>Investigate and resolve variances immediately</li>
                    <li>Track count accuracy over time to identify problem areas</li>
                </ul>
            </MudAlert>

            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4" Elevation="2">
                        <div class="d-flex align-center mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Large" Color="Color.Primary" Class="mr-3" />
                            <div>
                                <MudText Typo="Typo.h6">Scheduled Counts</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Upcoming cycle counts</MudText>
                            </div>
                        </div>
                        <MudText Typo="Typo.h4" Color="Color.Primary">0</MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2" Disabled="true">
                            View Schedule
                        </MudButton>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4" Elevation="2">
                        <div class="d-flex align-center mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Pending" Size="Size.Large" Color="Color.Warning" Class="mr-3" />
                            <div>
                                <MudText Typo="Typo.h6">In Progress</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Active counting sessions</MudText>
                            </div>
                        </div>
                        <MudText Typo="Typo.h4" Color="Color.Warning">0</MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2" Disabled="true">
                            View Active
                        </MudButton>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4" Elevation="2">
                        <div class="d-flex align-center mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" Class="mr-3" />
                            <div>
                                <MudText Typo="Typo.h6">Completed</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">This month</MudText>
                            </div>
                        </div>
                        <MudText Typo="Typo.h4" Color="Color.Success">0</MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2" Disabled="true">
                            View History
                        </MudButton>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                    About Cycle Counting
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudText Typo="Typo.body1" GutterBottom="true">
                <strong>Cycle counting</strong> is a continuous inventory auditing procedure where a small subset of inventory 
                is counted on a specific day, with different items counted on different days in a systematic cycle.
            </MudText>

            <MudText Typo="Typo.h6" Class="mt-4 mb-2">Key Features (Coming Soon):</MudText>
            <MudList T="string" Dense="true">
                <MudListItem T="string" Icon="@Icons.Material.Filled.CalendarToday">
                    <strong>Automated Scheduling:</strong> Set up recurring count schedules based on ABC classification
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Assignment">
                    <strong>Count Assignment:</strong> Assign counts to specific users or teams with mobile support
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Compare">
                    <strong>Variance Detection:</strong> Automatically flag discrepancies between counted and system quantities
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Tune">
                    <strong>Auto-Adjustment:</strong> Generate stock adjustments from approved count results
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Assessment">
                    <strong>Accuracy Tracking:</strong> Monitor counting accuracy and identify problem products/locations
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.NotificationsActive">
                    <strong>Alerts & Reminders:</strong> Receive notifications for overdue counts and large variances
                </MudListItem>
            </MudList>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-2">ABC Classification Guide:</MudText>
            <MudSimpleTable Dense="true" Hover="true" Class="mt-2">
                <thead>
                    <tr>
                        <th>Class</th>
                        <th>Criteria</th>
                        <th>% of Items</th>
                        <th>% of Value</th>
                        <th>Count Frequency</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><MudChip T="string" Size="Size.Small" Color="Color.Error">A</MudChip></td>
                        <td>High-value, fast-moving items</td>
                        <td>~20%</td>
                        <td>~80%</td>
                        <td>Monthly or more frequent</td>
                    </tr>
                    <tr>
                        <td><MudChip T="string" Size="Size.Small" Color="Color.Warning">B</MudChip></td>
                        <td>Medium-value, moderate movement</td>
                        <td>~30%</td>
                        <td>~15%</td>
                        <td>Quarterly</td>
                    </tr>
                    <tr>
                        <td><MudChip T="string" Size="Size.Small" Color="Color.Success">C</MudChip></td>
                        <td>Low-value, slow-moving items</td>
                        <td>~50%</td>
                        <td>~5%</td>
                        <td>Semi-annually or annually</td>
                    </tr>
                </tbody>
            </MudSimpleTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

