@page "/inventory/products"
@using System.Net.Http.Json
@using MudBlazor
@using Inventory.Web.Components.Shared
@using Inventory.Application.Services
@using ProductDto = Inventory.Application.DTOs.ProductDto
@using CreateProductDto = Inventory.Application.DTOs.CreateProductDto
@using UpdateProductDto = Inventory.Application.DTOs.UpdateProductDto
@inject IInventoryService InventoryService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Products</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/inventory">Inventory</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Products</MudText>
    </div>

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.Inventory" Class="mr-2" />
                Products
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Manage your product catalog, SKUs, and pricing
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Add Product
        </MudButton>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
    }
    else
    {
        <MudCard>
            <MudCardContent>
                <CustomDataGrid TItem="ProductDto"
                                Items="@FilteredProducts"
                                Loading="@_loading"
                                SearchPlaceholder="Search products by name, SKU, or barcode..."
                                RowsPerPage="25"
                                Striped="true"
                                Filterable="true">
                    <ToolbarContent>
                        <MudSelect @bind-Value="_categoryFilter"
                                   Label="Category"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true"
                                   T="string"
                                   Style="min-width: 200px;"
                                   Class="mr-2">
                            @foreach (var category in _categories)
                            {
                                <MudSelectItem Value="@category">@category</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect @bind-Value="_statusFilter"
                                   Label="Status"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   T="string"
                                   Style="min-width: 180px;">
                            <MudSelectItem Value="@("All")">All</MudSelectItem>
                            <MudSelectItem Value="@("Active")">Active Only</MudSelectItem>
                            <MudSelectItem Value="@("Inactive")">Inactive Only</MudSelectItem>
                            <MudSelectItem Value="@("LowStock")">Low Stock</MudSelectItem>
                        </MudSelect>
                    </ToolbarContent>
                    <ChildContent>
                        <PropertyColumn Property="x => x.SKU" Title="SKU" T="ProductDto" TProperty="string" />
                        <PropertyColumn Property="x => x.Name" Title="Product Name" T="ProductDto" TProperty="string">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@context.Item.Name</MudText>
                                @if (!string.IsNullOrEmpty(context.Item.Barcode))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.Barcode</MudText>
                                }
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Category" Title="Category" T="ProductDto" TProperty="string">
                            <CellTemplate>
                                @if (!string.IsNullOrEmpty(context.Item.Category))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.Item.Category</MudChip>
                                }
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Cost" Title="Cost" Format="C2" T="ProductDto" TProperty="decimal" />
                        <PropertyColumn Property="x => x.Price" Title="Price" Format="C2" T="ProductDto" TProperty="decimal">
                            <CellTemplate>
                                <MudText Typo="Typo.body2" Style="font-weight:600">@context.Item.Price.ToString("C")</MudText>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.TotalStock" Title="Stock" T="ProductDto" TProperty="int">
                            <CellTemplate>
                                @if (context.Item.TotalStock <= context.Item.ReorderPoint)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">@context.Item.TotalStock</MudChip>
                                }
                                else
                                {
                                    <span>@context.Item.TotalStock</span>
                                }
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.ReorderPoint" Title="Reorder Point" T="ProductDto" TProperty="int" />
                        <PropertyColumn Property="x => x.IsActive" Title="Status" Sortable="false" Filterable="false" T="ProductDto" TProperty="bool">
                            <CellTemplate>
                                @if (context.Item.IsActive)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Active</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default">Inactive</MudChip>
                                }
                            </CellTemplate>
                        </PropertyColumn>
                        <TemplateColumn Title="Actions" Sortable="false" Filterable="false" T="ProductDto">
                            <CellTemplate>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               OnClick="@(() => OpenEditDialog(context.Item))"
                                               title="Edit" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => DeleteProduct(context.Item))"
                                               title="Delete" />
                            </CellTemplate>
                        </TemplateColumn>
                    </ChildContent>
                </CustomDataGrid>

                @if (!FilteredProducts.Any())
                {
                    <MudAlert Severity="Severity.Info" Class="mt-4">
                        No products found matching your search criteria.
                    </MudAlert>
                }
            </MudCardContent>
        </MudCard>

        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                Quick Stats
            </MudText>
            <MudGrid>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Products</MudText>
                    <MudText Typo="Typo.h6">@_products.Count</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Active</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Success">@_products.Count(p => p.IsActive)</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Low Stock</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Warning">@_products.Count(p => p.TotalStock <= p.ReorderPoint)</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Categories</MudText>
                    <MudText Typo="Typo.h6">@_categories.Count()</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private List<ProductDto> _products = new();
    private string? _errorMessage;
    private string? _categoryFilter = null;
    private string _statusFilter = "All";

    private IEnumerable<string> _categories => _products
        .Where(p => !string.IsNullOrEmpty(p.Category))
        .Select(p => p.Category!)
        .Distinct()
        .OrderBy(c => c);

    private IEnumerable<ProductDto> FilteredProducts
    {
        get
        {
            var filtered = _products.AsEnumerable();

            // Category filter
            if (!string.IsNullOrWhiteSpace(_categoryFilter))
            {
                filtered = filtered.Where(p => p.Category == _categoryFilter);
            }

            // Status filter
            filtered = _statusFilter switch
            {
                "Active" => filtered.Where(p => p.IsActive),
                "Inactive" => filtered.Where(p => !p.IsActive),
                "LowStock" => filtered.Where(p => p.TotalStock <= p.ReorderPoint),
                _ => filtered
            };

            return filtered.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        _loading = true;
        try
        {
            var result = await InventoryService.GetAllProductsAsync();
            _products = result.ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading products: {ex.Message}";
            Console.WriteLine(_errorMessage);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            { "Product", new ProductForm.ProductFormModel() },
            { "IsEdit", false }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<ProductForm>("Create Product", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadProducts();
        }
    }

    private async Task OpenEditDialog(ProductDto product)
    {
        var model = new ProductForm.ProductFormModel
        {
            Id = product.Id,
            Name = product.Name,
            Description = product.Description,
            SKU = product.SKU,
            Barcode = product.Barcode,
            Cost = product.Cost,
            Price = product.Price,
            ReorderPoint = product.ReorderPoint,
            ReorderQuantity = product.ReorderQuantity,
            Category = product.Category,
            UnitOfMeasure = product.UnitOfMeasure,
            IsActive = product.IsActive,
            IsTrackedInventory = product.IsTrackedInventory,
            ImageUrl = product.ImageUrl
        };

        var parameters = new DialogParameters
        {
            { "Product", model },
            { "IsEdit", true }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<ProductForm>("Edit Product", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadProducts();
        }
    }

    private async Task DeleteProduct(ProductDto product)
    {
        var parameters = new DialogParameters
        {
            { "ContentText", $"Are you sure you want to delete '{product.Name}'? This action cannot be undone." },
            { "ButtonText", "Delete" },
            { "Color", Color.Error }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Product", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var success = await InventoryService.DeleteProductAsync(product.Id);
                if (success)
                {
                    Snackbar.Add($"Product '{product.Name}' deleted successfully", Severity.Success);
                    await LoadProducts();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting product: {ex.Message}", Severity.Error);
            }
        }
    }
}
