@page "/inventory/purchase-orders"
@using System.Net.Http.Json
@using MudBlazor
@using Inventory.Web.Components.Shared
@inject IHttpClientFactory HttpClientFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Purchase Orders</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/inventory">Inventory</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Purchase Orders</MudText>
    </div>

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-2" />
                Purchase Orders
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Create and track purchase orders to suppliers
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
            Create Purchase Order
        </MudButton>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
    }
    else
    {
        <CustomDataGrid TItem="PurchaseOrderDto" Items="@FilteredOrders" Title="Purchase Orders" 
                        ShowSearch="true" SearchPlaceholder="Search purchase orders..." 
                        Filterable="true" FilterMode="DataGridFilterMode.ColumnFilterRow"
                        Hideable="true" SortMode="SortMode.Multiple"
                        ColumnResizeMode="ResizeMode.Container"
                        RowsPerPage="25">
            <ToolbarContent>
                <MudSpacer />
                <MudSelect @bind-Value="_statusFilter" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" T="string" Clearable="true" Class="mr-2" Style="min-width: 200px;">
                    <MudSelectItem Value="@("Draft")">Draft</MudSelectItem>
                    <MudSelectItem Value="@("Submitted")">Submitted</MudSelectItem>
                    <MudSelectItem Value="@("Approved")">Approved</MudSelectItem>
                    <MudSelectItem Value="@("Sent")">Sent</MudSelectItem>
                    <MudSelectItem Value="@("PartiallyReceived")">Partially Received</MudSelectItem>
                    <MudSelectItem Value="@("Received")">Received</MudSelectItem>
                    <MudSelectItem Value="@("Cancelled")">Cancelled</MudSelectItem>
                </MudSelect>
                <MudSelect @bind-Value="_supplierFilter" Label="Supplier" Variant="Variant.Outlined" Margin="Margin.Dense" T="Guid?" Clearable="true" Class="mr-2" Style="min-width: 200px;">
                    @foreach (var supplier in _suppliers)
                    {
                        <MudSelectItem Value="@((Guid?)supplier.Id)">@supplier.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ClearFilters">Clear Filters</MudButton>
            </ToolbarContent>
            <ChildContent>
                <PropertyColumn T="PurchaseOrderDto" TProperty="string" Property="@(x => x.OrderNumber)" Title="PO Number">
                    <CellTemplate>
                        <MudText Typo="Typo.body2"><strong>@context.Item.OrderNumber</strong></MudText>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn T="PurchaseOrderDto" TProperty="string" Property="@(x => x.SupplierName)" Title="Supplier" />
                <PropertyColumn T="PurchaseOrderDto" TProperty="string" Property="@(x => x.WarehouseName)" Title="Warehouse" />
                <PropertyColumn T="PurchaseOrderDto" TProperty="DateTimeOffset" Property="@(x => x.OrderDate)" Title="Order Date" Format="MMM dd, yyyy">
                    <CellTemplate>
                        <MudText Typo="Typo.caption">@context.Item.OrderDate.ToString("MMM dd, yyyy")</MudText>
                    </CellTemplate>
                </PropertyColumn>
                <TemplateColumn T="PurchaseOrderDto" Title="Expected Delivery">
                    <CellTemplate>
                        @if (context.Item.ExpectedDeliveryDate.HasValue)
                        {
                            <MudText Typo="Typo.caption">@context.Item.ExpectedDeliveryDate.Value.ToString("MMM dd, yyyy")</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Not set</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PurchaseOrderDto" Title="Status">
                    <CellTemplate>
                        @{
                            var statusColor = context.Item.Status switch
                            {
                                "Draft" => Color.Default,
                                "Submitted" => Color.Info,
                                "Approved" => Color.Primary,
                                "Sent" => Color.Warning,
                                "PartiallyReceived" => Color.Warning,
                                "Received" => Color.Success,
                                "Cancelled" => Color.Error,
                                _ => Color.Default
                            };
                        }
                        <MudChip T="string" Size="Size.Small" Color="@statusColor">@FormatStatus(context.Item.Status)</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="PurchaseOrderDto" Title="Items" HeaderStyle="text-align:right" CellStyle="text-align:right">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small">@context.Item.Lines.Count</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn T="PurchaseOrderDto" TProperty="decimal" Property="@(x => x.Total)" Title="Total" Format="C" HeaderStyle="text-align:right" CellStyle="text-align:right">
                    <CellTemplate>
                        <strong>@context.Item.Total.ToString("C")</strong>
                    </CellTemplate>
                </PropertyColumn>
                <TemplateColumn T="PurchaseOrderDto" Title="Actions" HeaderStyle="text-align:right" CellStyle="text-align:right" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true">
                            <MudMenuItem Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => ViewOrder(context.Item))">View Details</MudMenuItem>
                            @if (context.Item.Status == "Draft")
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Send" OnClick="@(() => UpdateStatus(context.Item.Id, "Submitted"))">Submit</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteOrder(context.Item))">Delete</MudMenuItem>
                            }
                            @if (context.Item.Status == "Submitted")
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Check" OnClick="@(() => UpdateStatus(context.Item.Id, "Approved"))">Approve</MudMenuItem>
                            }
                            @if (context.Item.Status == "Approved" || context.Item.Status == "Sent" || context.Item.Status == "PartiallyReceived")
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.LocalShipping" OnClick="@(() => OpenReceiveDialog(context.Item))">Receive Items</MudMenuItem>
                            }
                        </MudMenu>
                    </CellTemplate>
                </TemplateColumn>
            </ChildContent>
        </CustomDataGrid>

        @if (!FilteredOrders.Any())
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">No purchase orders found.</MudAlert>
        }

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.Analytics" Class="mr-2" />
                Purchase Order Summary
            </MudText>
            <MudGrid>
                <MudItem xs="6" sm="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total POs</MudText>
                    <MudText Typo="Typo.h6">@_orders.Count</MudText>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Draft</MudText>
                    <MudText Typo="Typo.h6">@_orders.Count(o => o.Status == "Draft")</MudText>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Pending</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Warning">@_orders.Count(o => o.Status == "Submitted" || o.Status == "Approved" || o.Status == "Sent")</MudText>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">In Transit</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Info">@_orders.Count(o => o.Status == "PartiallyReceived")</MudText>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Completed</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Success">@_orders.Count(o => o.Status == "Received")</MudText>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Value</MudText>
                    <MudText Typo="Typo.h6">@_orders.Sum(o => o.Total).ToString("C")</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private List<PurchaseOrderDto> _orders = new();
    private List<SupplierDto> _suppliers = new();
    private string? _statusFilter = null;
    private Guid? _supplierFilter = null;
    private string? _errorMessage;

    private IEnumerable<PurchaseOrderDto> FilteredOrders
    {
        get
        {
            var items = _orders.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_statusFilter))
            {
                items = items.Where(o => o.Status == _statusFilter);
            }

            if (_supplierFilter.HasValue)
            {
                items = items.Where(o => o.SupplierId == _supplierFilter.Value);
            }

            return items.OrderByDescending(o => o.OrderDate);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("InventoryApi");
            _orders = await client.GetFromJsonAsync<List<PurchaseOrderDto>>("api/inventory/purchaseorders") ?? new();
            _suppliers = await client.GetFromJsonAsync<List<SupplierDto>>("api/inventory/suppliers") ?? new();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading purchase orders: {ex.Message}";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ClearFilters()
    {
        _statusFilter = null;
        _supplierFilter = null;
    }

    private string FormatStatus(string status) => status switch
    {
        "PartiallyReceived" => "Partially Received",
        _ => status
    };

    private async Task OpenCreateDialog()
    {
        Snackbar.Add("Purchase order creation dialog coming soon!", Severity.Info);
        // TODO: Implement full PO creation dialog
    }

    private async Task ViewOrder(PurchaseOrderDto order)
    {
        // TODO: Open order detail dialog or navigate to detail page
        Snackbar.Add($"Viewing PO {order.OrderNumber}", Severity.Info);
    }

    private async Task OpenReceiveDialog(PurchaseOrderDto order)
    {
        // TODO: Open receive dialog
        Snackbar.Add($"Receive dialog for PO {order.OrderNumber} coming soon!", Severity.Info);
    }

    private async Task UpdateStatus(Guid orderId, string newStatus)
    {
        try
        {
            var client = HttpClientFactory.CreateClient("InventoryApi");
            var dto = new { Status = newStatus, ApprovedBy = "System" };
            var response = await client.PutAsJsonAsync($"api/inventory/purchaseorders/{orderId}/status", dto);
            response.EnsureSuccessStatusCode();
            Snackbar.Add($"Purchase order status updated to {newStatus}", Severity.Success);
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating status: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteOrder(PurchaseOrderDto order)
    {
        var parameters = new DialogParameters 
        { 
            { "ContentText", $"Are you sure you want to delete PO {order.OrderNumber}? This action cannot be undone." }, 
            { "ButtonText", "Delete" }, 
            { "Color", Color.Error } 
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Purchase Order", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            try
            {
                var client = HttpClientFactory.CreateClient("InventoryApi");
                var response = await client.DeleteAsync($"api/inventory/purchaseorders/{order.Id}");
                response.EnsureSuccessStatusCode();
                Snackbar.Add($"PO {order.OrderNumber} deleted successfully", Severity.Success);
                await LoadData();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting PO: {ex.Message}", Severity.Error);
            }
        }
    }

    public class PurchaseOrderDto
    {
        public Guid Id { get; set; }
        public string OrderNumber { get; set; } = string.Empty;
        public Guid SupplierId { get; set; }
        public string SupplierName { get; set; } = string.Empty;
        public Guid WarehouseId { get; set; }
        public string WarehouseName { get; set; } = string.Empty;
        public DateTime OrderDate { get; set; }
        public DateTime? ExpectedDeliveryDate { get; set; }
        public DateTime? ActualDeliveryDate { get; set; }
        public string Status { get; set; } = string.Empty;
        public decimal SubTotal { get; set; }
        public decimal TaxAmount { get; set; }
        public decimal ShippingCost { get; set; }
        public decimal Total { get; set; }
        public string? Notes { get; set; }
        public List<PurchaseOrderLineDto> Lines { get; set; } = new();
    }

    public class PurchaseOrderLineDto
    {
        public Guid Id { get; set; }
        public Guid ProductId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public string ProductSKU { get; set; } = string.Empty;
        public int QuantityOrdered { get; set; }
        public int QuantityReceived { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal TaxRate { get; set; }
        public decimal LineTotal { get; set; }
        public string? Notes { get; set; }
    }

    public class SupplierDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}

