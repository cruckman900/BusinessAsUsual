@page "/inventory/stock/transfers"
@using System.Net.Http.Json
@using MudBlazor
@using Inventory.Web.Components.Shared
@using Inventory.Application.Services
@using InventoryTransactionDto = Inventory.Application.DTOs.InventoryTransactionDto
@using WarehouseDto = Inventory.Application.DTOs.WarehouseDto
@using ProductDto = Inventory.Application.DTOs.ProductDto
@inject IInventoryService InventoryService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Stock Transfers</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/inventory">Inventory</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/inventory/stock">Stock Management</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Stock Transfers</MudText>
    </div>

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Class="mr-2" />
                Stock Transfers
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Move inventory between warehouses and track transfer history
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenTransferDialog">
            New Transfer
        </MudButton>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
    }
    else
    {
        <MudCard Class="mb-4">
            <MudCardContent>
                <CustomDataGrid TItem="InventoryTransactionDto"
                                Items="@FilteredTransfers"
                                Loading="@_loading"
                                SearchPlaceholder="Search by product name or SKU..."
                                RowsPerPage="25"
                                Striped="true"
                                Filterable="true">
                    <ToolbarContent>
                        <MudSelect @bind-Value="_warehouseFilter" Label="Filter by Warehouse" Variant="Variant.Outlined" Margin="Margin.Dense" T="Guid?" Clearable="true" Style="min-width: 200px;" Class="mr-2">
                            @foreach (var warehouse in _warehouses)
                            {
                                <MudSelectItem Value="@((Guid?)warehouse.Id)">@warehouse.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect @bind-Value="_directionFilter" Label="Direction" Variant="Variant.Outlined" Margin="Margin.Dense" T="string" Clearable="true" Style="min-width: 180px;">
                            <MudSelectItem Value="@("in")">Transfers In</MudSelectItem>
                            <MudSelectItem Value="@("out")">Transfers Out</MudSelectItem>
                        </MudSelect>
                    </ToolbarContent>
                    <ChildContent>
                        <PropertyColumn Property="x => x.TransactionDate" Title="Date" T="InventoryTransactionDto" TProperty="DateTime">
                            <CellTemplate>
                                <MudText Typo="Typo.caption">@context.Item.TransactionDate.ToString("MMM dd, yyyy")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.TransactionDate.ToString("hh:mm tt")</MudText>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.ProductName" Title="Product" T="InventoryTransactionDto" TProperty="string">
                            <CellTemplate>
                                <MudText Typo="Typo.body2"><strong>@context.Item.ProductName</strong></MudText>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.ProductSKU" Title="SKU" T="InventoryTransactionDto" TProperty="string">
                            <CellTemplate>
                                <MudChip T="string" Size="Size.Small">@context.Item.ProductSKU</MudChip>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.WarehouseName" Title="From → To" T="InventoryTransactionDto" TProperty="string" />
                        <PropertyColumn Property="x => x.Quantity" Title="Direction" T="InventoryTransactionDto" TProperty="int">
                            <CellTemplate>
                                @if (context.Item.Quantity < 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.CallMade">Out</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CallReceived">In</MudChip>
                                }
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Quantity" Title="Quantity" T="InventoryTransactionDto" TProperty="int">
                            <CellTemplate>
                                <strong>@Math.Abs(context.Item.Quantity)</strong>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.UnitCost" Title="Unit Cost" Format="C2" T="InventoryTransactionDto" TProperty="decimal" />
                        <TemplateColumn Title="Total Value" T="InventoryTransactionDto">
                            <CellTemplate>
                                <strong>@(Math.Abs(context.Item.TotalCost)).ToString("C")</strong>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.CreatedBy" Title="Created By" T="InventoryTransactionDto" TProperty="string">
                            <CellTemplate>
                                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Person">@context.Item.CreatedBy</MudChip>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Notes" Title="Notes" T="InventoryTransactionDto" TProperty="string">
                            <CellTemplate>
                                @if (!string.IsNullOrEmpty(context.Item.Notes))
                                {
                                    <MudTooltip Text="@context.Item.Notes">
                                        <MudIcon Icon="@Icons.Material.Filled.Notes" Size="Size.Small" Color="Color.Info" />
                                    </MudTooltip>
                                }
                            </CellTemplate>
                        </PropertyColumn>
                    </ChildContent>
                </CustomDataGrid>

                @if (!FilteredTransfers.Any())
                {
                    <MudAlert Severity="Severity.Info" Class="mt-4">No stock transfers found.</MudAlert>
                }
            </MudCardContent>
        </MudCard>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.Analytics" Class="mr-2" />
                Transfer Summary
            </MudText>
            <MudGrid>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Transfers</MudText>
                    <MudText Typo="Typo.h6">@(_transfers.Count / 2)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">(paired in/out)</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Units Transferred</MudText>
                    <MudText Typo="Typo.h6">@_transfers.Where(t => t.Quantity < 0).Sum(t => Math.Abs(t.Quantity))</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Value Moved</MudText>
                    <MudText Typo="Typo.h6">@_transfers.Where(t => t.Quantity < 0).Sum(t => Math.Abs(t.TotalCost)).ToString("C")</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">This Month</MudText>
                    <MudText Typo="Typo.h6">@_transfers.Count(t => t.TransactionDate.Month == DateTime.Now.Month && t.TransactionDate.Year == DateTime.Now.Year)</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private List<InventoryTransactionDto> _transfers = new();
    private List<WarehouseDto> _warehouses = new();
    private List<ProductOption> _products = new();
    private Guid? _warehouseFilter = null;
    private string? _directionFilter = null;
    private string? _errorMessage;

    private IEnumerable<InventoryTransactionDto> FilteredTransfers
    {
        get
        {
            var items = _transfers.AsEnumerable();

            if (_warehouseFilter.HasValue)
            {
                items = items.Where(t => t.WarehouseId == _warehouseFilter.Value);
            }

            if (!string.IsNullOrWhiteSpace(_directionFilter))
            {
                items = _directionFilter switch
                {
                    "in" => items.Where(t => t.Quantity >= 0),
                    "out" => items.Where(t => t.Quantity < 0),
                    _ => items
                };
            }

            return items.OrderByDescending(t => t.TransactionDate);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var transactions = await InventoryService.GetAllInventoryTransactionsAsync();
            _transfers = transactions.Where(t => t.TransactionType == "Transfer").ToList();
            var warehouseResult = await InventoryService.GetAllWarehousesAsync();
            _warehouses = warehouseResult.ToList();
            var products = await InventoryService.GetAllProductsAsync();
            _products = products.Select(p => new ProductOption { Id = p.Id, Name = p.Name, SKU = p.SKU }).ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading transfers: {ex.Message}";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenTransferDialog()
    {
        var warehouseOptions = _warehouses.Select(w => new StockTransferDialog.WarehouseOption { Id = w.Id, Name = w.Name }).ToList();
        var parameters = new DialogParameters 
        { 
            { "Products", _products }, 
            { "Warehouses", warehouseOptions } 
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<StockTransferDialog>("Create Stock Transfer", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await LoadData();
    }

    public class ProductOption
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string SKU { get; set; } = string.Empty;
    }
}
