@page "/platform/settings"
@rendermode InteractiveServer
@using MudBlazor
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Settings - Platform</PageTitle>

<!-- Keyboard Shortcuts -->
<KeyboardShortcutHandler OnShortcut="HandleKeyboardShortcut" />

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <!-- Breadcrumb with Actions -->
    <PageBreadcrumb Items="_breadcrumbItems">
        <Actions>
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Default" 
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       Size="Size.Small"
                       OnClick="ResetDefaults">
                Reset to Defaults
            </MudButton>
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveAllSettings">
                Save Changes
            </MudButton>
        </Actions>
    </PageBreadcrumb>

    <!-- Page Header -->
    <div class="mb-4">
        <MudText Typo="Typo.h4" GutterBottom="true">
            Platform Settings
        </MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            Configure global system settings and preferences
        </MudText>
    </div>

    <!-- Contextual Help -->
    <ContextualHint Title="Important" 
                   Message="Changes to system settings affect all users. Test critical settings in a staging environment first."
                   Dismissible="true" />

    <!-- Settings Tabs -->
    <MudPaper Elevation="2">
        <div style="background-color: var(--mud-palette-surface); border-bottom: 1px solid var(--mud-palette-divider);">
            <MudTabs Elevation="0" Rounded="false" style="background-color: var(--mud-palette-background);" @bind-ActivePanelIndex="_activeTab" PanelClass="pa-4"
                     Class="px-3 pt-2">

            <!-- General Settings -->
            <MudTabPanel Text="General" Icon="@Icons.Material.Filled.Tune">
                <MudText Typo="Typo.h6" Class="mb-4">General Settings</MudText>

                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_settings.CompanyName" Label="Company Name" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_settings.SystemEmail" Label="System Email" Variant="Variant.Outlined" InputType="InputType.Email" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect @bind-Value="_settings.DefaultLanguage" Label="Default Language" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("en-US")">English (US)</MudSelectItem>
                            <MudSelectItem Value="@("en-GB")">English (UK)</MudSelectItem>
                            <MudSelectItem Value="@("es-ES")">Spanish</MudSelectItem>
                            <MudSelectItem Value="@("fr-FR")">French</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect @bind-Value="_settings.DefaultTimeZone" Label="Default Time Zone" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("America/New_York")">Eastern Time (US)</MudSelectItem>
                            <MudSelectItem Value="@("America/Chicago")">Central Time (US)</MudSelectItem>
                            <MudSelectItem Value="@("America/Denver")">Mountain Time (US)</MudSelectItem>
                            <MudSelectItem Value="@("America/Los_Angeles")">Pacific Time (US)</MudSelectItem>
                            <MudSelectItem Value="@("UTC")">UTC</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_settings.CompanyAddress" Label="Company Address" Variant="Variant.Outlined" Lines="2" />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <!-- Security Settings -->
            <MudTabPanel Text="Security" Icon="@Icons.Material.Filled.Security">
                <MudText Typo="Typo.h6" Class="mb-4">Security Settings</MudText>

                <!-- Basic Security -->
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="_settings.PasswordMinLength" Label="Minimum Password Length" Variant="Variant.Outlined" Min="6" Max="20" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="_settings.SessionTimeoutMinutes" Label="Session Timeout (minutes)" Variant="Variant.Outlined" Min="5" Max="1440" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="_settings.MaxLoginAttempts" Label="Max Login Attempts" Variant="Variant.Outlined" Min="3" Max="10" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="_settings.AccountLockoutMinutes" Label="Account Lockout Duration (minutes)" Variant="Variant.Outlined" Min="5" Max="60" />
                    </MudItem>
                </MudGrid>

                <!-- Progressive Disclosure: Advanced Security -->
                <MudExpansionPanels Class="mt-4" Elevation="0">
                    <MudExpansionPanel Style="border: 1px solid var(--mud-palette-divider);">
                        <TitleContent>
                            <div class="d-flex align-center" style="gap: 8px;">
                                <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" />
                                <MudText>Advanced Security Options</MudText>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudGrid Spacing="3" Class="pa-2">
                                <MudItem xs="12">
                                    <MudSwitch @bind-Value="_settings.RequireTwoFactorAuth" Label="Require Two-Factor Authentication" Color="Color.Primary" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudSwitch @bind-Value="_settings.AllowPasswordReset" Label="Allow Password Reset via Email" Color="Color.Primary" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudSwitch @bind-Value="_settings.EnableAuditLogging" Label="Enable Audit Logging" Color="Color.Primary" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <HelpTooltip HelpText="Enforce HTTPS for all connections (recommended for production)">
                                        <MudSwitch @bind-Value="_settings.EnforceHttps" Label="Enforce HTTPS" Color="Color.Primary" />
                                    </HelpTooltip>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <HelpTooltip HelpText="Block requests from known malicious IP addresses">
                                        <MudSwitch @bind-Value="_settings.EnableIpBlocking" Label="Enable IP Blocking" Color="Color.Primary" />
                                    </HelpTooltip>
                                </MudItem>
                            </MudGrid>
                        </ChildContent>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudTabPanel>

            <!-- Email Settings -->
            <MudTabPanel Text="Email" Icon="@Icons.Material.Filled.Email">
                <MudText Typo="Typo.h6" Class="mb-4">Email Configuration</MudText>

                <!-- Basic SMTP -->
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_settings.SmtpServer" Label="SMTP Server" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="_settings.SmtpPort" Label="SMTP Port" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_settings.SmtpUsername" Label="SMTP Username" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_settings.SmtpPassword" Label="SMTP Password" Variant="Variant.Outlined" InputType="InputType.Password" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudSwitch @bind-Value="_settings.SmtpEnableSsl" Label="Enable SSL/TLS" Color="Color.Primary" />
                    </MudItem>
                </MudGrid>

                <!-- Progressive Disclosure: Advanced Email -->
                <MudExpansionPanels Class="mt-4" Elevation="0">
                    <MudExpansionPanel Style="border: 1px solid var(--mud-palette-divider);">
                        <TitleContent>
                            <div class="d-flex align-center" style="gap: 8px;">
                                <MudIcon Icon="@Icons.Material.Filled.Settings" />
                                <MudText>Advanced Email Settings</MudText>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudGrid Spacing="3" Class="pa-2">
                                <MudItem xs="12" md="6">
                                    <HelpTooltip HelpText="Email address shown in the From field">
                                        <MudTextField @bind-Value="_settings.FromEmail" Label="From Email" Variant="Variant.Outlined" />
                                    </HelpTooltip>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <HelpTooltip HelpText="Display name shown alongside the from email">
                                        <MudTextField @bind-Value="_settings.FromName" Label="From Name" Variant="Variant.Outlined" />
                                    </HelpTooltip>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <HelpTooltip HelpText="BCC this address on all outgoing emails (useful for compliance)">
                                        <MudTextField @bind-Value="_settings.BccEmail" Label="BCC Email (Optional)" Variant="Variant.Outlined" />
                                    </HelpTooltip>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <HelpTooltip HelpText="Maximum emails sent per hour to prevent spam filters">
                                        <MudNumericField @bind-Value="_settings.EmailRateLimit" Label="Rate Limit (per hour)" Variant="Variant.Outlined" Min="10" Max="1000" />
                                    </HelpTooltip>
                                </MudItem>
                            </MudGrid>
                        </ChildContent>
                    </MudExpansionPanel>
                </MudExpansionPanels>

                <!-- Test Email -->
                <MudDivider Class="my-4" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" OnClick="SendTestEmail">
                    Send Test Email
                </MudButton>
            </MudTabPanel>

            <!-- Notifications Settings -->
            <MudTabPanel Text="Notifications" Icon="@Icons.Material.Filled.Notifications">
                <MudText Typo="Typo.h6" Class="mb-4">Notification Preferences</MudText>

                <MudGrid Spacing="3">
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Email Notifications</MudText>
                        <MudSwitch @bind-Value="_settings.EnableEmailNotifications" Label="Enable Email Notifications" Color="Color.Primary" Class="mb-2" />
                        <MudSwitch @bind-Value="_settings.NotifyOnUserRegistration" Label="Notify on New User Registration" Color="Color.Primary" Disabled="@(!_settings.EnableEmailNotifications)" Class="mb-2" />
                        <MudSwitch @bind-Value="_settings.NotifyOnSecurityEvents" Label="Notify on Security Events" Color="Color.Primary" Disabled="@(!_settings.EnableEmailNotifications)" Class="mb-2" />
                        <MudSwitch @bind-Value="_settings.NotifyOnSystemErrors" Label="Notify on System Errors" Color="Color.Primary" Disabled="@(!_settings.EnableEmailNotifications)" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudDivider Class="my-2" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">In-App Notifications</MudText>
                        <MudSwitch @bind-Value="_settings.EnableInAppNotifications" Label="Enable In-App Notifications" Color="Color.Primary" Class="mb-2" />
                        <MudSwitch @bind-Value="_settings.ShowNotificationBadge" Label="Show Notification Badge" Color="Color.Primary" Disabled="@(!_settings.EnableInAppNotifications)" />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <!-- Backup & Maintenance -->
            <MudTabPanel Text="Backup" Icon="@Icons.Material.Filled.Backup">
                <MudText Typo="Typo.h6" Class="mb-4">Backup & Maintenance</MudText>

                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudSwitch @bind-Value="_settings.EnableAutomaticBackups" Label="Enable Automatic Backups" Color="Color.Primary" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect @bind-Value="_settings.BackupFrequency" Label="Backup Frequency" Variant="Variant.Outlined" Disabled="@(!_settings.EnableAutomaticBackups)">
                            <MudSelectItem Value="@("Daily")">Daily</MudSelectItem>
                            <MudSelectItem Value="@("Weekly")">Weekly</MudSelectItem>
                            <MudSelectItem Value="@("Monthly")">Monthly</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="_settings.BackupRetentionDays" Label="Backup Retention (days)" Variant="Variant.Outlined" Min="7" Max="365" Disabled="@(!_settings.EnableAutomaticBackups)" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_settings.BackupLocation" Label="Backup Location" Variant="Variant.Outlined" Disabled="@(!_settings.EnableAutomaticBackups)" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudDivider Class="my-2" />
                        <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Backup" OnClick="CreateBackup">
                                Create Backup Now
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Restore" OnClick="RestoreBackup">
                                Restore from Backup
                            </MudButton>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <!-- Advanced Settings -->
            <MudTabPanel Text="Advanced" Icon="@Icons.Material.Filled.Code">
                <MudText Typo="Typo.h6" Class="mb-4">Advanced Settings</MudText>

                <MudGrid Spacing="3">
                    <MudItem xs="12">
                        <MudSwitch @bind-Value="_settings.EnableDebugMode" Label="Enable Debug Mode" Color="Color.Warning" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Warning: Debug mode will log detailed system information and may impact performance
                        </MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudSwitch @bind-Value="_settings.EnableApiRateLimiting" Label="Enable API Rate Limiting" Color="Color.Primary" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="_settings.ApiRequestsPerMinute" Label="API Requests Per Minute" Variant="Variant.Outlined" Min="10" Max="1000" Disabled="@(!_settings.EnableApiRateLimiting)" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="_settings.MaxUploadSizeMB" Label="Max Upload Size (MB)" Variant="Variant.Outlined" Min="1" Max="100" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.subtitle2" Class="mb-2 mt-2" Color="Color.Error">Danger Zone</MudText>
                        <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ResetToDefaults">
                                Reset to Defaults
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever" OnClick="ClearCache">
                                Clear System Cache
                            </MudButton>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

        </MudTabs>
        </div>
    </MudPaper>
</MudContainer>

@code {
    private int _activeTab = 0;
    private SettingsModel _settings = new();

    private List<PageBreadcrumb.BreadcrumbItem> _breadcrumbItems = new()
    {
        new() { Text = "Dashboard", Href = "/dashboard" },
        new() { Text = "Platform", Href = "/platform" },
        new() { Text = "Settings", Href = "/platform/settings", Icon = Icons.Material.Filled.Settings }
    };

    protected override void OnInitialized()
    {
        // Initialize with default/mock settings
        _settings = new SettingsModel
        {
            CompanyName = "BusinessAsUsual Corp",
            SystemEmail = "system@businessasusual.com",
            CompanyAddress = "123 Business St, Suite 100, New York, NY 10001",
            DefaultLanguage = "en-US",
            DefaultTimeZone = "America/New_York",

            PasswordMinLength = 8,
            SessionTimeoutMinutes = 30,
            MaxLoginAttempts = 5,
            AccountLockoutMinutes = 15,
            RequireTwoFactorAuth = false,
            AllowPasswordReset = true,
            EnableAuditLogging = true,

            SmtpServer = "smtp.businessasusual.com",
            SmtpPort = 587,
            SmtpUsername = "noreply@businessasusual.com",
            SmtpPassword = "********",
            SmtpEnableSsl = true,

            EnableEmailNotifications = true,
            NotifyOnUserRegistration = true,
            NotifyOnSecurityEvents = true,
            NotifyOnSystemErrors = true,
            EnableInAppNotifications = true,
            ShowNotificationBadge = true,

            EnableAutomaticBackups = true,
            BackupFrequency = "Daily",
            BackupRetentionDays = 30,
            BackupLocation = "/backups/platform",

            EnableDebugMode = false,
            EnableApiRateLimiting = true,
            ApiRequestsPerMinute = 100,
            MaxUploadSizeMB = 10
        };
    }

    private void SaveAllSettings()
    {
        // In production, this would save to database/API
        Toast.Saved("Platform settings");
    }

    private void SendTestEmail()
    {
        Toast.Info($"Test email sent to {_settings.SystemEmail}");
    }

    private void CreateBackup()
    {
        Toast.Success("Backup created successfully");
    }

    private void RestoreBackup()
    {
        Toast.Info("Select a backup to restore");
    }

    private void ResetToDefaults()
    {
        Toast.Warning("Settings reset to defaults");
    }

    private void ResetDefaults() => ResetToDefaults();

    private void ClearCache()
    {
        Toast.Info("System cache cleared");
    }

    private async Task HandleKeyboardShortcut(string shortcut)
    {
        Console.WriteLine($"📥 Settings page received shortcut: {shortcut}");

        switch (shortcut)
        {
            case "alt-s":
                SaveAllSettings();
                break;
            case "question":
                await DialogService.ShowAsync<KeyboardShortcutsDialog>("Keyboard Shortcuts");
                break;
            case "g-d":
                Navigation.NavigateTo("/dashboard");
                break;
            case "g-u":
                Navigation.NavigateTo("/platform/users");
                break;
            case "g-r":
                Navigation.NavigateTo("/platform/roles");
                break;
            case "g-n":
                Navigation.NavigateTo("/platform/notifications");
                break;
            case "g-s":
                Navigation.NavigateTo("/platform/settings");
                break;
            case "g-h":
                Navigation.NavigateTo("/platform");
                break;
        }
    }

    // Settings Model
    public class SettingsModel
    {
        // General
        public string CompanyName { get; set; } = "";
        public string SystemEmail { get; set; } = "";
        public string CompanyAddress { get; set; } = "";
        public string DefaultLanguage { get; set; } = "en-US";
        public string DefaultTimeZone { get; set; } = "UTC";

        // Security
        public int PasswordMinLength { get; set; } = 8;
        public int SessionTimeoutMinutes { get; set; } = 30;
        public int MaxLoginAttempts { get; set; } = 5;
        public int AccountLockoutMinutes { get; set; } = 15;
        public bool RequireTwoFactorAuth { get; set; }
        public bool AllowPasswordReset { get; set; }
        public bool EnableAuditLogging { get; set; }
        public bool EnforceHttps { get; set; } = true;
        public bool EnableIpBlocking { get; set; }

        // Email
        public string SmtpServer { get; set; } = "";
        public int SmtpPort { get; set; } = 587;
        public string SmtpUsername { get; set; } = "";
        public string SmtpPassword { get; set; } = "";
        public bool SmtpEnableSsl { get; set; }
        public string FromEmail { get; set; } = "";
        public string FromName { get; set; } = "";
        public string BccEmail { get; set; } = "";
        public int EmailRateLimit { get; set; } = 100;

        // Notifications
        public bool EnableEmailNotifications { get; set; }
        public bool NotifyOnUserRegistration { get; set; }
        public bool NotifyOnSecurityEvents { get; set; }
        public bool NotifyOnSystemErrors { get; set; }
        public bool EnableInAppNotifications { get; set; }
        public bool ShowNotificationBadge { get; set; }

        // Backup
        public bool EnableAutomaticBackups { get; set; }
        public string BackupFrequency { get; set; } = "Daily";
        public int BackupRetentionDays { get; set; } = 30;
        public string BackupLocation { get; set; } = "";

        // Advanced
        public bool EnableDebugMode { get; set; }
        public bool EnableApiRateLimiting { get; set; }
        public int ApiRequestsPerMinute { get; set; } = 100;
        public int MaxUploadSizeMB { get; set; } = 10;
    }
}
