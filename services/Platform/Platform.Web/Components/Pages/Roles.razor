@page "/platform/roles"
@rendermode InteractiveServer
@using MudBlazor
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ToastService Toast
@inject SmartDefaultsService Defaults

<PageTitle>Roles & Permissions - Platform</PageTitle>

<!-- Keyboard Shortcuts -->
<KeyboardShortcutHandler OnShortcut="HandleKeyboardShortcut" />

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <!-- Breadcrumb with Actions -->
    <PageBreadcrumb Items="_breadcrumbItems">
        <Actions>
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Default" 
                       StartIcon="@Icons.Material.Filled.Security"
                       Size="Size.Small">
                Audit Log
            </MudButton>
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateRoleDialog">
                Add Role
            </MudButton>
        </Actions>
    </PageBreadcrumb>

    <!-- Page Header -->
    <div class="mb-4">
        <MudText Typo="Typo.h4" GutterBottom="true">
            Roles & Permissions
        </MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            Configure access control and permission assignments
        </MudText>
    </div>

    <!-- Contextual Help -->
    @if (_roles.Count(r => !r.IsSystemRole) == 0 && !_isLoading)
    {
        <ContextualHint Title="Getting Started" 
                       Message="System roles (Admin, Manager, User) cannot be deleted. Create custom roles for specific team needs."
                       Dismissible="true" />
    }
    else if (!_isLoading)
    {
        <ContextualHint Title="Security Tip" 
                       Message="Grant minimum permissions required for each role. Review permissions regularly and use the Audit Log to track changes."
                       Dismissible="true" />
    }

    <!-- Stats Cards -->
    <MudGrid Spacing="3" Class="mb-4">
        @if (_isLoading)
        {
            <MudItem xs="12" sm="4">
                <SkeletonLoader Type="SkeletonLoader.SkeletonType.StatsCard" Rows="1" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <SkeletonLoader Type="SkeletonLoader.SkeletonType.StatsCard" Rows="1" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <SkeletonLoader Type="SkeletonLoader.SkeletonType.StatsCard" Rows="1" />
            </MudItem>
        }
        else
        {
            <MudItem xs="12" sm="4">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex align-center justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Total Roles</MudText>
                                <MudText Typo="Typo.h5">@_roles.Count</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Info" Size="Size.Large" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex align-center justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Total Permissions</MudText>
                                <MudText Typo="Typo.h5">@_availablePermissions.Count</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Warning" Size="Size.Large" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex align-center justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Custom Roles</MudText>
                                <MudText Typo="Typo.h5">@_roles.Count(r => !r.IsSystemRole)</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Build" Color="Color.Primary" Size="Size.Large" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    <!-- Roles Grid -->
    <MudPaper Elevation="2" Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-4">Roles</MudText>

        @if (_isLoading)
        {
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6" lg="4">
                    <SkeletonLoader Type="SkeletonLoader.SkeletonType.Card" Rows="1" />
                </MudItem>
                <MudItem xs="12" md="6" lg="4">
                    <SkeletonLoader Type="SkeletonLoader.SkeletonType.Card" Rows="1" />
                </MudItem>
                <MudItem xs="12" md="6" lg="4">
                    <SkeletonLoader Type="SkeletonLoader.SkeletonType.Card" Rows="1" />
                </MudItem>
            </MudGrid>
        }
        else if (!_roles.Any())
        {
            <!-- Smart Empty State -->
            <div class="text-center pa-12">
                <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Large" 
                         Style="font-size: 96px; opacity: 0.3;" Color="Color.Info" Class="mb-4" />
                <MudText Typo="Typo.h4" GutterBottom="true">No custom roles defined</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4" Style="max-width: 500px; margin: 0 auto;">
                    Create custom roles to organize permissions and control access across your platform. Perfect for teams with specific responsibilities!
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" 
                           StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateRoleDialog" Class="mt-2">
                    Create Your First Role
                </MudButton>
                <div class="mt-6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        💡 Tip: System roles (Administrator, Manager, User) are always available
                    </MudText>
                </div>
            </div>
        }
        else
        {
            <MudGrid Spacing="3">
                @foreach (var role in _roles)
                {
                    <MudItem xs="12" md="6" lg="4">
                        <MudCard Elevation="1" Class="d-flex flex-column" Style="height: 100%;">
                            <MudCardContent Class="flex-grow-1">
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <MudText Typo="Typo.h6">@role.Name</MudText>
                                    @if (role.IsSystemRole)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">System</MudChip>
                                    }
                                </div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                    @role.Description
                                </MudText>
                                <MudDivider Class="mb-2" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                                    <strong>Permissions:</strong> @role.Permissions.Count
                                </MudText>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var permission in role.Permissions.Take(4))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@permission</MudChip>
                                }
                                @if (role.Permissions.Count > 4)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">+@(role.Permissions.Count - 4) more</MudChip>
                                }
                            </div>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditRoleDialog(role))">
                                Edit
                            </MudButton>
                            @if (!role.IsSystemRole)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteRole(role))">
                                    Delete
                                </MudButton>
                            }
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
            </MudGrid>
        }
    </MudPaper>
</MudContainer>

<!-- Create/Edit Role Dialog -->
<MudDialog @bind-Visible="_roleDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(_isEditingRole ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-2" />
            @(_isEditingRole ? "Edit Role" : "Add New Role")
        </MudText>
    </TitleContent>
    <DialogContent>
        <HelpTooltip HelpText="Choose a clear, descriptive name for this role (e.g., 'Sales Manager', 'Customer Support')">
            <MudTextField @bind-Value="_currentRole.Name" Label="Role Name" Variant="Variant.Outlined" Required="true" Class="mb-3" 
                          Disabled="@_currentRole.IsSystemRole" />
        </HelpTooltip>

        <HelpTooltip HelpText="Describe what this role is for and who should be assigned to it">
            <MudTextField @bind-Value="_currentRole.Description" Label="Description" Variant="Variant.Outlined" Lines="2" Class="mb-3" />
        </HelpTooltip>

        <div class="d-flex align-center mb-2" style="gap: 8px;">
            <MudText Typo="Typo.subtitle2">Permissions</MudText>
            <MudTooltip Text="Select all permissions this role needs. Follow the principle of least privilege." Placement="Placement.Right" Arrow="true">
                <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" 
                               Size="Size.Small" 
                               Color="Color.Default"
                               Style="opacity: 0.6; padding: 4px;" />
            </MudTooltip>
        </div>
        <MudPaper Elevation="0" Class="pa-3 mb-3" Style="border: 1px solid var(--mud-palette-divider); max-height: 300px; overflow-y: auto;">
            @foreach (var permission in _availablePermissions)
            {
                <MudCheckBox T="bool" 
                             Value="@_currentRole.Permissions.Contains(permission)"
                             ValueChanged="@((bool isChecked) => TogglePermission(permission, isChecked))"
                             Label="@permission" 
                             Color="Color.Primary" 
                             Dense="true" />
            }
        </MudPaper>

        @if (!_currentRole.IsSystemRole)
        {
            <MudSwitch @bind-Value="_currentRole.IsSystemRole" Label="System Role (cannot be deleted)" Color="Color.Warning" Disabled="true" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseRoleDialog">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveRole">
            @(_isEditingRole ? "Update" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<RoleModel> _roles = new();
    private List<string> _availablePermissions = new();
    private bool _roleDialogVisible = false;
    private bool _isEditingRole = false;
    private RoleModel _currentRole = new();
    private bool _isLoading = false;

    private List<PageBreadcrumb.BreadcrumbItem> _breadcrumbItems = new()
    {
        new() { Text = "Dashboard", Href = "/dashboard" },
        new() { Text = "Platform", Href = "/platform" },
        new() { Text = "Roles & Permissions", Href = "/platform/roles", Icon = Icons.Material.Filled.AdminPanelSettings }
    };

    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        StateHasChanged();

        // Simulate API call delay
        await Task.Delay(800);

        // Seed available permissions
        _availablePermissions = new List<string>
        {
            "users.read",
            "users.write",
            "users.delete",
            "roles.read",
            "roles.write",
            "roles.delete",
            "audit.read",
            "settings.read",
            "settings.write",
            "notifications.read",
            "notifications.write",
            "reports.read",
            "reports.write",
            "finance.read",
            "finance.write",
            "inventory.read",
            "inventory.write"
        };

        // Seed mock roles
        _roles = new List<RoleModel>
        {
            new RoleModel 
            { 
                Id = 1, 
                Name = "Administrator", 
                Description = "Full system access with all permissions", 
                IsSystemRole = true,
                Permissions = new List<string>(_availablePermissions)
            },
            new RoleModel 
            { 
                Id = 2, 
                Name = "Manager", 
                Description = "Manage users and view reports", 
                IsSystemRole = true,
                Permissions = new List<string> { "users.read", "users.write", "roles.read", "reports.read", "audit.read" }
            },
            new RoleModel 
            { 
                Id = 3, 
                Name = "User", 
                Description = "Basic user access with limited permissions", 
                IsSystemRole = true,
                Permissions = new List<string> { "users.read", "notifications.read", "reports.read" }
            },
            new RoleModel 
            { 
                Id = 4, 
                Name = "Finance Manager", 
                Description = "Manage financial operations and reports", 
                IsSystemRole = false,
                Permissions = new List<string> { "finance.read", "finance.write", "reports.read", "reports.write" }
            }
        };

        _isLoading = false;
    }

    private void OpenCreateRoleDialog()
    {
        _isEditingRole = false;
        _currentRole = new RoleModel();
        _roleDialogVisible = true;
    }

    private void OpenEditRoleDialog(RoleModel role)
    {
        _isEditingRole = true;
        _currentRole = new RoleModel
        {
            Id = role.Id,
            Name = role.Name,
            Description = role.Description,
            IsSystemRole = role.IsSystemRole,
            Permissions = new List<string>(role.Permissions)
        };
        _roleDialogVisible = true;
    }

    private void CloseRoleDialog()
    {
        _roleDialogVisible = false;
        _currentRole = new();
    }

    private void TogglePermission(string permission, bool isChecked)
    {
        if (isChecked && !_currentRole.Permissions.Contains(permission))
        {
            _currentRole.Permissions.Add(permission);
        }
        else if (!isChecked && _currentRole.Permissions.Contains(permission))
        {
            _currentRole.Permissions.Remove(permission);
        }
    }

    private void SaveRole()
    {
        if (_isEditingRole)
        {
            var existing = _roles.FirstOrDefault(r => r.Id == _currentRole.Id);
            if (existing != null)
            {
                existing.Name = _currentRole.Name;
                existing.Description = _currentRole.Description;
                existing.Permissions = new List<string>(_currentRole.Permissions);
                Toast.Saved(_currentRole.Name);
            }
        }
        else
        {
            _currentRole.Id = _roles.Max(r => r.Id) + 1;
            _roles.Add(_currentRole);
            Toast.Created(_currentRole.Name);
        }

        CloseRoleDialog();
    }

    private async Task DeleteRole(RoleModel role)
    {
        if (role.IsSystemRole)
        {
            Toast.Warning("System roles cannot be deleted");
            return;
        }

        var deletedRole = role;
        _roles.Remove(role);

        Toast.Deleted($"Role '{role.Name}'", () =>
        {
            // Undo delete
            _roles.Add(deletedRole);
            StateHasChanged();
        });

        await Task.CompletedTask;
    }

    private async Task HandleKeyboardShortcut(string shortcut)
    {
        switch (shortcut)
        {
            case "cmd-n":
                OpenCreateRoleDialog();
                break;
            case "escape":
                if (_roleDialogVisible)
                    CloseRoleDialog();
                break;
            case "question":
                await DialogService.ShowAsync<KeyboardShortcutsDialog>("Keyboard Shortcuts");
                break;
            case "g-d":
                Navigation.NavigateTo("/dashboard");
                break;
            case "g-u":
                Navigation.NavigateTo("/platform/users");
                break;
            case "g-r":
                Navigation.NavigateTo("/platform/roles");
                break;
            case "g-n":
                Navigation.NavigateTo("/platform/notifications");
                break;
            case "g-s":
                Navigation.NavigateTo("/platform/settings");
                break;
        }
    }

    // Model class
    public class RoleModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsSystemRole { get; set; }
        public List<string> Permissions { get; set; } = new();
    }
}
