@page "/platform/notifications"
@using MudBlazor
@inject ISnackbar Snackbar

<PageTitle>Notifications - Platform</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <!-- Breadcrumb -->
    <div class="mb-3">
        <MudLink Href="/dashboard">Dashboard</MudLink>
        <span class="mx-2">/</span>
        <MudLink Href="/platform">Platform</MudLink>
        <span class="mx-2">/</span>
        <MudText Typo="Typo.body2" Inline="true" Color="Color.Primary">Notifications</MudText>
    </div>

    <!-- Page Header -->
    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.Notifications" Class="mr-2" />
                Notification Center
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                View and manage system notifications
            </MudText>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="MarkAllAsRead">
                Mark All as Read
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Settings" Href="/platform/settings">
                Settings
            </MudButton>
        </div>
    </div>

    <!-- Stats Cards -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudCard Elevation="2">
                <MudCardContent>
                    <div class="d-flex align-center justify-space-between">
                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Total Notifications</MudText>
                            <MudText Typo="Typo.h5">@_notifications.Count</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Notifications" Color="Color.Info" Size="Size.Large" />
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Elevation="2">
                <MudCardContent>
                    <div class="d-flex align-center justify-space-between">
                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Unread</MudText>
                            <MudText Typo="Typo.h5">@_notifications.Count(n => !n.IsRead)</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.MarkEmailUnread" Color="Color.Warning" Size="Size.Large" />
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Elevation="2">
                <MudCardContent>
                    <div class="d-flex align-center justify-space-between">
                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Today</MudText>
                            <MudText Typo="Typo.h5">@_notifications.Count(n => n.CreatedAt.Date == DateTime.Today)</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Today" Color="Color.Success" Size="Size.Large" />
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Filter Tabs -->
    <MudPaper Elevation="2" Class="pa-4">
        <MudTabs Elevation="0" Rounded="true" Color="Color.Primary" @bind-ActivePanelIndex="_activeTabIndex">
            <MudTabPanel Text="All" Icon="@Icons.Material.Filled.Inbox" BadgeData="@_notifications.Count" />
            <MudTabPanel Text="Unread" Icon="@Icons.Material.Filled.MarkEmailUnread" BadgeData="@_notifications.Count(n => !n.IsRead)" BadgeColor="Color.Warning" />
            <MudTabPanel Text="System" Icon="@Icons.Material.Filled.Settings" BadgeData="@_notifications.Count(n => n.Type == NotificationType.System)" />
            <MudTabPanel Text="Security" Icon="@Icons.Material.Filled.Security" BadgeData="@_notifications.Count(n => n.Type == NotificationType.Security)" />
        </MudTabs>

        <MudDivider Class="my-4" />

        <!-- Notifications List -->
        <div style="max-height: 600px; overflow-y: auto;">
            @if (!GetFilteredNotifications().Any())
            {
                <div class="text-center pa-8">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" Class="mb-2" />
                    <MudText Typo="Typo.h6" Color="Color.Secondary">No notifications</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">You're all caught up!</MudText>
                </div>
            }
            else
            {
                @foreach (var notification in GetFilteredNotifications().OrderByDescending(n => n.CreatedAt))
                {
                    var currentNotification = notification; // Capture for closures
                    <MudPaper Elevation="0" Class="pa-3 mb-2 d-flex align-center" 
                              Style="@($"border-left: 4px solid {GetNotificationColor(notification)}; background-color: {(notification.IsRead ? "transparent" : "var(--mud-palette-action-default-hover)")}")"
                              @onclick="@(() => MarkAsRead(currentNotification))">
                        <MudIcon Icon="@GetNotificationIcon(notification.Type)" 
                                 Color="@GetNotificationMudColor(notification)" 
                                 Size="Size.Large" 
                                 Class="mr-3" />
                        <div class="flex-grow-1" @onclick="@(() => MarkAsRead(currentNotification))">
                            <div class="d-flex justify-space-between align-center mb-1">
                                <MudText Typo="Typo.body1" Style="@(!notification.IsRead ? "font-weight: 600;" : "")">
                                    @notification.Title
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @GetRelativeTime(notification.CreatedAt)
                                </MudText>
                            </div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @notification.Message
                            </MudText>
                            <div class="mt-2">
                                <MudChip T="string" Size="Size.Small" Color="@GetNotificationMudColor(notification)" Variant="Variant.Text">
                                    @notification.Type.ToString()
                                </MudChip>
                            </div>
                        </div>
                        <div @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                           Size="Size.Small" 
                                           Color="Color.Default"
                                           OnClick="@(() => DeleteNotification(currentNotification))" />
                        </div>
                    </MudPaper>
                }
            }
        </div>
    </MudPaper>
</MudContainer>

@code {
    private List<NotificationModel> _notifications = new();
    private int _activeTabIndex = 0;

    protected override void OnInitialized()
    {
        // Seed mock notifications
        _notifications = new List<NotificationModel>
        {
            new NotificationModel 
            { 
                Id = 1, 
                Type = NotificationType.System,
                Title = "System Update Available",
                Message = "A new system update is available. Please schedule maintenance window.",
                CreatedAt = DateTime.Now.AddMinutes(-15),
                IsRead = false
            },
            new NotificationModel 
            { 
                Id = 2, 
                Type = NotificationType.Security,
                Title = "New Login Detected",
                Message = "New login from IP 192.168.1.100 on Chrome browser.",
                CreatedAt = DateTime.Now.AddHours(-2),
                IsRead = false
            },
            new NotificationModel 
            { 
                Id = 3, 
                Type = NotificationType.User,
                Title = "New User Registered",
                Message = "Jane Doe has registered and is pending approval.",
                CreatedAt = DateTime.Now.AddHours(-4),
                IsRead = true
            },
            new NotificationModel 
            { 
                Id = 4, 
                Type = NotificationType.System,
                Title = "Database Backup Completed",
                Message = "Scheduled database backup completed successfully at 2:00 AM.",
                CreatedAt = DateTime.Now.AddDays(-1),
                IsRead = true
            },
            new NotificationModel 
            { 
                Id = 5, 
                Type = NotificationType.Security,
                Title = "Failed Login Attempts",
                Message = "Multiple failed login attempts detected for user admin@businessasusual.com",
                CreatedAt = DateTime.Now.AddDays(-1).AddHours(-3),
                IsRead = false
            },
            new NotificationModel 
            { 
                Id = 6, 
                Type = NotificationType.Alert,
                Title = "High Memory Usage",
                Message = "Server memory usage has exceeded 85% threshold.",
                CreatedAt = DateTime.Now.AddDays(-2),
                IsRead = true
            },
            new NotificationModel 
            { 
                Id = 7, 
                Type = NotificationType.User,
                Title = "User Role Changed",
                Message = "Bob Johnson's role was changed from User to Manager.",
                CreatedAt = DateTime.Now.AddDays(-3),
                IsRead = true
            }
        };
    }

    private IEnumerable<NotificationModel> GetFilteredNotifications()
    {
        return _activeTabIndex switch
        {
            1 => _notifications.Where(n => !n.IsRead),
            2 => _notifications.Where(n => n.Type == NotificationType.System),
            3 => _notifications.Where(n => n.Type == NotificationType.Security),
            _ => _notifications
        };
    }

    private void MarkAsRead(NotificationModel notification)
    {
        if (!notification.IsRead)
        {
            notification.IsRead = true;
            StateHasChanged();
        }
    }

    private void MarkAllAsRead()
    {
        foreach (var notification in _notifications.Where(n => !n.IsRead))
        {
            notification.IsRead = true;
        }
        Snackbar.Add("All notifications marked as read", Severity.Success);
    }

    private void DeleteNotification(NotificationModel notification)
    {
        _notifications.Remove(notification);
        Snackbar.Add("Notification deleted", Severity.Info);
    }

    private string GetNotificationIcon(NotificationType type) => type switch
    {
        NotificationType.System => Icons.Material.Filled.Settings,
        NotificationType.Security => Icons.Material.Filled.Security,
        NotificationType.User => Icons.Material.Filled.Person,
        NotificationType.Alert => Icons.Material.Filled.Warning,
        _ => Icons.Material.Filled.Info
    };

    private Color GetNotificationMudColor(NotificationModel notification) => notification.Type switch
    {
        NotificationType.System => Color.Info,
        NotificationType.Security => Color.Error,
        NotificationType.User => Color.Primary,
        NotificationType.Alert => Color.Warning,
        _ => Color.Default
    };

    private string GetNotificationColor(NotificationModel notification) => notification.Type switch
    {
        NotificationType.System => "var(--mud-palette-info)",
        NotificationType.Security => "var(--mud-palette-error)",
        NotificationType.User => "var(--mud-palette-primary)",
        NotificationType.Alert => "var(--mud-palette-warning)",
        _ => "var(--mud-palette-divider)"
    };

    private string GetRelativeTime(DateTime dateTime)
    {
        var timeSpan = DateTime.Now - dateTime;

        if (timeSpan.TotalMinutes < 1)
            return "Just now";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7)
            return $"{(int)timeSpan.TotalDays}d ago";

        return dateTime.ToString("MMM dd, yyyy");
    }

    // Model classes
    public class NotificationModel
    {
        public int Id { get; set; }
        public NotificationType Type { get; set; }
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public DateTime CreatedAt { get; set; }
        public bool IsRead { get; set; }
    }

    public enum NotificationType
    {
        System,
        Security,
        User,
        Alert
    }
}
