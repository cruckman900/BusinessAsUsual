@using MudBlazor

<div class="d-inline-flex align-center" style="gap: 4px;">
    @ChildContent
    <MudTooltip Text="@HelpText" Placement="@Placement" Arrow="true" Color="@Color">
        <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" 
                       Size="Size.Small" 
                       Color="Color.Default"
                       Style="opacity: 0.6; padding: 4px;"
                       aria-label="Help" />
    </MudTooltip>
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter, EditorRequired]
    public string HelpText { get; set; } = "";

    [Parameter]
    public Placement Placement { get; set; } = Placement.Top;

    [Parameter]
    public Color Color { get; set; } = Color.Dark;
}
