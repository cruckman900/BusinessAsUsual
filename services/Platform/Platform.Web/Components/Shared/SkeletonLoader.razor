@* Reusable Skeleton Loader Component *@

@if (Type == SkeletonType.DataGrid)
{
    @for (var i = 0; i < Rows; i++)
    {
        <MudPaper Elevation="0" Class="pa-3 mb-2">
            <div class="d-flex align-center gap-3">
                <MudSkeleton SkeletonType="MudBlazor.SkeletonType.Circle" Width="40px" Height="40px" />
                <div class="flex-grow-1">
                    <MudSkeleton SkeletonType="MudBlazor.SkeletonType.Text" Width="40%" />
                    <MudSkeleton SkeletonType="MudBlazor.SkeletonType.Text" Width="60%" Class="mt-1" />
                </div>
                <MudSkeleton SkeletonType="MudBlazor.SkeletonType.Text" Width="80px" />
                <MudSkeleton SkeletonType="MudBlazor.SkeletonType.Text" Width="100px" />
            </div>
        </MudPaper>
    }
}
else if (Type == SkeletonType.Card)
{
    @for (var i = 0; i < Rows; i++)
    {
        <MudPaper Elevation="1" Class="pa-4 mb-3">
            <MudSkeleton SkeletonType="MudBlazor.SkeletonType.Text" Width="60%" Height="24px" Class="mb-2" />
            <MudSkeleton SkeletonType="MudBlazor.SkeletonType.Text" Width="100%" Height="16px" Class="mb-1" />
            <MudSkeleton SkeletonType="MudBlazor.SkeletonType.Text" Width="80%" Height="16px" Class="mb-3" />
            <div class="d-flex gap-2">
                <MudSkeleton SkeletonType="MudBlazor.SkeletonType.Rectangle" Width="60px" Height="24px" />
                <MudSkeleton SkeletonType="MudBlazor.SkeletonType.Rectangle" Width="60px" Height="24px" />
            </div>
        </MudPaper>
    }
}
else if (Type == SkeletonType.StatsCard)
{
    @for (var i = 0; i < Rows; i++)
    {
        <MudPaper Elevation="2" Class="pa-4">
            <div class="d-flex justify-space-between align-center">
                <div class="flex-grow-1">
                    <MudSkeleton SkeletonType="MudBlazor.SkeletonType.Text" Width="60%" Height="14px" Class="mb-2" />
                    <MudSkeleton SkeletonType="MudBlazor.SkeletonType.Text" Width="40%" Height="32px" />
                </div>
                <MudSkeleton SkeletonType="MudBlazor.SkeletonType.Circle" Width="48px" Height="48px" />
            </div>
        </MudPaper>
    }
}
else if (Type == SkeletonType.List)
{
    @for (var i = 0; i < Rows; i++)
    {
        <div class="d-flex align-center gap-3 pa-3">
            <MudSkeleton SkeletonType="MudBlazor.SkeletonType.Circle" Width="32px" Height="32px" />
            <div class="flex-grow-1">
                <MudSkeleton SkeletonType="MudBlazor.SkeletonType.Text" Width="70%" />
                <MudSkeleton SkeletonType="MudBlazor.SkeletonType.Text" Width="50%" Class="mt-1" />
            </div>
            <MudSkeleton SkeletonType="MudBlazor.SkeletonType.Text" Width="60px" />
        </div>
    }
}

@code {
    [Parameter] public SkeletonType Type { get; set; } = SkeletonType.DataGrid;
    [Parameter] public int Rows { get; set; } = 5;

    public enum SkeletonType
    {
        DataGrid,
        Card,
        StatsCard,
        List
    }
}
