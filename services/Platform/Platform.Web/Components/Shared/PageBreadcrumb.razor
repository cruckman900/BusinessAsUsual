@using MudBlazor

<div class="d-flex justify-space-between align-center mb-4">
    <div class="d-flex align-center" style="gap: 8px;">
        @foreach (var item in Items.Select((value, index) => new { value, index }))
        {
            @if (item.index > 0)
            {
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Style="opacity: 0.5;" />
            }

            @if (item.index == Items.Count - 1)
            {
                <div class="d-flex align-center" style="gap: 8px;">
                    @if (!string.IsNullOrEmpty(item.value.Icon))
                    {
                        <MudIcon Icon="@item.value.Icon" Size="Size.Small" Color="Color.Primary" />
                    }
                    <MudText Typo="Typo.body1" Style="font-weight: 600;" Color="Color.Primary">
                        @item.value.Text
                    </MudText>
                </div>
            }
            else
            {
                <MudLink Href="@item.value.Href" Typo="Typo.body2" Style="opacity: 0.7;">
                    @item.value.Text
                </MudLink>
            }
        }
    </div>

    @if (Actions != null)
    {
        <div class="d-flex" style="gap: 8px;">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter]
    public List<BreadcrumbItem> Items { get; set; } = new();

    [Parameter]
    public RenderFragment? Actions { get; set; }

    public class BreadcrumbItem
    {
        public string Text { get; set; } = "";
        public string Href { get; set; } = "";
        public string Icon { get; set; } = "";
    }
}
