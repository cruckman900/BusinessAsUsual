@using MudBlazor
@inject IJSRuntime JS
@implements IAsyncDisposable

@code {
    [Parameter]
    public EventCallback<string> OnShortcut { get; set; }

    private DotNetObjectReference<KeyboardShortcutHandler>? _objRef;
    private IJSObjectReference? _module;
    private IJSObjectReference? _instance;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Platform.Web/js/keyboardShortcuts.js");
            _instance = await _module.InvokeAsync<IJSObjectReference>("initialize", _objRef);
        }
    }

    [JSInvokable]
    public async Task HandleShortcut(string shortcut)
    {
        await OnShortcut.InvokeAsync(shortcut);
    }

    public async ValueTask DisposeAsync()
    {
        if (_instance != null)
        {
            await _instance.InvokeVoidAsync("dispose");
            await _instance.DisposeAsync();
        }

        if (_module != null)
        {
            await _module.DisposeAsync();
        }

        _objRef?.Dispose();
    }
}
