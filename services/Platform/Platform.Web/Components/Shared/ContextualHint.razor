@using MudBlazor

@if (Visible)
{
    <MudPaper Elevation="0" Class="pa-3 mb-4" 
              Style="background-color: var(--mud-palette-info-lighten); border-left: 4px solid var(--mud-palette-info);"
              role="alert"
              aria-live="polite">
        <div class="d-flex align-center" style="gap: 12px;">
            <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Color="Color.Info" aria-hidden="true" />
            <div style="flex: 1;">
                <MudText Typo="Typo.body2" Style="color: var(--mud-palette-info-darken);">
                    @if (!string.IsNullOrEmpty(Title))
                    {
                        <strong>@Title:</strong>
                        <span> </span>
                    }
                    @Message
                </MudText>
            </div>
            @if (Dismissible)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Close" 
                              Size="Size.Small" 
                              Color="Color.Default"
                              OnClick="@(() => Visible = false)"
                              aria-label="Dismiss hint" />
            }
        </div>
    </MudPaper>
}

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter, EditorRequired]
    public string Message { get; set; } = "";

    [Parameter]
    public bool Dismissible { get; set; } = true;

    private bool Visible { get; set; } = true;

    protected override void OnInitialized()
    {
        Visible = true;
    }
}
