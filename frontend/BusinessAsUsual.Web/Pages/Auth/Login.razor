@page "/login"
@using BusinessAsUsual.Web.Components.Layout
@using BusinessAsUsual.Web.Services
@using BusinessAsUsual.Application.Services
@layout LoginLayout
@inject NavigationManager NavigationManager
@inject AuthenticationService AuthService
@inject TenantDatabaseResetService TenantResetService
@inject ITenantContext TenantContext
@inject IHttpClientFactory HttpClientFactory


<div class="login-wrapper">
    <MudPaper Class="login-card" Elevation="4">

        <div class="login-header">
            <img src="images/logo.png" class="login-logo" alt="BAU Logo" />

            <div class="login-header-text">
                <MudText Typo="Typo.h5" Class="login-title">
                    Business As Usual
                </MudText>

                <MudText Typo="Typo.subtitle2" Class="login-subtitle">
                    Sign in to continue
                </MudText>
            </div>
        </div>

        <MudForm @ref="LoginForm">
            @if (Companies.Count > 0)
            {
                <MudSelect T="string" Label="Tenant"
                           @bind-Value="SelectedCompanyDbName"
                           Variant="Variant.Outlined"
                           FullWidth="true"
                           Class="login-input">
                    @foreach (var company in Companies)
                    {
                        <MudSelectItem Value="@company.DbName">@company.Name</MudSelectItem>
                    }
                </MudSelect>
            }

            <MudTextField Label="Username"
                          @bind-Value="Username"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Class="login-input"
                          @onkeydown="HandleKeyDown" />

            <MudTextField Label="Password"
                          @bind-Value="Password"
                          Immediate="true"
                          InputType="@PasswordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@PasswordToggleIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Class="login-input"
                          @onkeydown="HandleKeyDown" />
        </MudForm>

        @if (ShowError)
        {
            <MudText Color="Color.Error" Typo="Typo.caption" Class="login-error">
                Invalid username or password
            </MudText>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="login-button"
                   OnClick="LoginUser"
                   Disabled="@_isLoggingIn">
            @if (_isLoggingIn)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Preparing tenant data...</span>
            }
            else
            {
                <span>Sign In</span>
            }
        </MudButton>

    </MudPaper>

</div>

@code {
    string Username = "";
    string Password = "";
    bool ShowError = false;
    bool _isLoggingIn = false;

    MudForm? LoginForm;
    InputType PasswordInputType = InputType.Password;

    List<CompanyOption> Companies = new();
    string SelectedCompanyDbName = "";

    static readonly Guid DefaultCompanyId = Guid.Parse("11111111-1111-1111-1111-111111111111");
    const string DefaultTenantDb = "TestTenant";

    record CompanyOption(Guid CompanyId, string Name, string DbName);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("ProvisioningApi");
            var response = await client.GetFromJsonAsync<List<CompanyDto>>("api/provisioning/companies");

            if (response is not null && response.Count > 0)
            {
                Companies = response
                    .Select(c => new CompanyOption(c.CompanyId, c.Name, c.DbName))
                    .ToList();
                SelectedCompanyDbName = Companies[0].DbName;
                return;
            }
        }
        catch
        {
            // Backend provisioning API unreachable; fall back to the default demo tenant below.
        }

        Companies = new List<CompanyOption>
        {
            new(DefaultCompanyId, "Demo Tenant", DefaultTenantDb)
        };
        SelectedCompanyDbName = DefaultTenantDb;
    }

    class CompanyDto
    {
        public Guid CompanyId { get; set; }
        public string Name { get; set; } = "";
        public string DbName { get; set; } = "";
    }

    string PasswordToggleIcon => PasswordInputType == InputType.Password
        ? Icons.Material.Filled.Visibility
        : Icons.Material.Filled.VisibilityOff;

    void TogglePasswordVisibility()
    {
        PasswordInputType = PasswordInputType == InputType.Password
            ? InputType.Text
            : InputType.Password;
    }

    async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await LoginUser();
        }
    }

    async Task LoginUser()
    {
        if (Username == "admin" && Password == "password")
        {
            _isLoggingIn = true;
            StateHasChanged();

            var selected = Companies.FirstOrDefault(c => c.DbName == SelectedCompanyDbName)
                ?? new CompanyOption(DefaultCompanyId, "Demo Tenant", DefaultTenantDb);

            // Apply the selected tenant to this circuit before resetting/reseeding data so
            // subsequent module calls resolve the chosen tenant instead of the default.
            TenantContext.SetContext(selected.CompanyId, selected.DbName);

            // Refresh all correlating module "tenant" databases so the demo always
            // starts from a clean, fully-populated dataset (no stale/empty tables).
            await TenantResetService.ResetAllAsync(selected.CompanyId, selected.DbName);

            // Login the user with the AuthenticationService
            AuthService.Login(
                username: Username,
                email: "admin@businessasusual.com",
                fullName: "Admin User",
                role: "Administrator"
            );

            _isLoggingIn = false;
            NavigationManager.NavigateTo("/dashboard");
        }
        else
        {
            ShowError = true;
        }
    }
}