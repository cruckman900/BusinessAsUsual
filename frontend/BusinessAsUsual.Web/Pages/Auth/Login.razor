@page "/login"
@using BusinessAsUsual.Web.Components.Layout
@using BusinessAsUsual.Web.Components
@using BusinessAsUsual.Web.Services
@using BusinessAsUsual.Application.Services
@layout LoginLayout
@inject NavigationManager NavigationManager
@inject AuthenticationService AuthService
@inject TenantDatabaseResetService TenantResetService
@inject ITenantContext TenantContext


<div class="login-wrapper">
    <MudPaper Class="login-card" Elevation="4">

        <div class="login-header">
            <img src="images/logo.png" class="login-logo" alt="BAU Logo" />

            <div class="login-header-text">
                <MudText Typo="Typo.h5" Class="login-title">
                    Business As Usual
                </MudText>

                <MudText Typo="Typo.subtitle2" Class="login-subtitle">
                    Sign in to continue
                </MudText>
            </div>
        </div>

        <MudForm @ref="LoginForm">
            <CompanyPicker @bind-SelectedCompany="SelectedCompany" Class="login-input" />

            <MudTextField Label="Username"
                          @bind-Value="Username"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Class="login-input"
                          @onkeydown="HandleKeyDown" />

            <MudTextField Label="Password"
                          @bind-Value="Password"
                          Immediate="true"
                          InputType="@PasswordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@PasswordToggleIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Class="login-input"
                          @onkeydown="HandleKeyDown" />
        </MudForm>

        @if (ShowError)
        {
            <MudText Color="Color.Error" Typo="Typo.caption" Class="login-error">
                Invalid username or password
            </MudText>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="login-button"
                   OnClick="LoginUser"
                   Disabled="@(_isLoggingIn || SelectedCompany is null)">
            @if (_isLoggingIn)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Preparing tenant data...</span>
            }
            else
            {
                <span>Sign In</span>
            }
        </MudButton>

    </MudPaper>

</div>

@code {
    string Username = "";
    string Password = "";
    bool ShowError = false;
    bool _isLoggingIn = false;

    MudForm? LoginForm;
    InputType PasswordInputType = InputType.Password;

    CompanyOption? SelectedCompany;

    string PasswordToggleIcon => PasswordInputType == InputType.Password
        ? Icons.Material.Filled.Visibility
        : Icons.Material.Filled.VisibilityOff;

    void TogglePasswordVisibility()
    {
        PasswordInputType = PasswordInputType == InputType.Password
            ? InputType.Text
            : InputType.Password;
    }

    async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await LoginUser();
        }
    }

    async Task LoginUser()
    {
        if (SelectedCompany is null)
        {
            ShowError = true;
            return;
        }

        if (Username == "admin" && Password == "password")
        {
            _isLoggingIn = true;
            StateHasChanged();

            var selected = SelectedCompany;

            // Apply the selected tenant to this circuit before resetting/reseeding data so
            // subsequent module calls resolve the chosen tenant instead of the default.
            TenantContext.SetContext(selected.CompanyId, selected.DbName);

            // Refresh all correlating module "tenant" databases so the demo always
            // starts from a clean, fully-populated dataset (no stale/empty tables).
            await TenantResetService.ResetAllAsync(selected.CompanyId, selected.DbName);

            // Login the user with the AuthenticationService, persisting the selected company
            // as part of the session identity.
            AuthService.Login(
                username: Username,
                email: "admin@businessasusual.com",
                fullName: "Admin User",
                role: "Administrator",
                companyId: selected.CompanyId,
                companyName: selected.Name,
                tenantDbName: selected.DbName
            );

            _isLoggingIn = false;
            NavigationManager.NavigateTo("/dashboard");
        }
        else
        {
            ShowError = true;
        }
    }
}