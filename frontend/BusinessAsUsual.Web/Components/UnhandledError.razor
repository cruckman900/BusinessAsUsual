@using MudBlazor

<PageTitle>Something Went Wrong - Business As Usual</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-column align-center justify-center" Style="min-height: 70vh; text-align: center;">

    <!-- Animated Icon -->
    <div class="oops-icon-container mb-6">
        <MudIcon Icon="@Icons.Material.Filled.BugReport"
                 Color="Color.Error"
                 Style="font-size: 10rem; opacity: 0.3;"
                 Class="oops-icon" />
        <MudText Typo="Typo.h1"
                 Class="oops-number"
                 Style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-weight: 700; font-size: 6rem; background: linear-gradient(135deg, var(--mud-palette-error) 0%, var(--mud-palette-warning) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
            500
        </MudText>
    </div>

    <MudText Typo="Typo.h3" GutterBottom="true" Class="mb-2" Style="font-weight: 600;">
        Oops! Something Broke
    </MudText>

    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6" Style="max-width: 500px;">
        An unexpected error occurred while rendering this page. Our best guess is it's a bug,
        not you. Try going back, or head home and try again.
    </MudText>

    <MudPaper Elevation="0" Class="pa-4 mb-6" Style="background: transparent; border: 1px dashed var(--mud-palette-divider); border-radius: 8px; max-width: 600px; width: 100%;">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Home"
                           Href="/dashboard"
                           Size="Size.Large">
                    Go to Dashboard
                </MudButton>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="Reload"
                           Size="Size.Large">
                    Reload Page
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (ShowDetails)
    {
        <MudExpansionPanels Elevation="0" Style="max-width: 600px; width: 100%;">
            <MudExpansionPanel Text="Technical details">
                <MudText Typo="Typo.caption" Style="font-family: monospace; white-space: pre-wrap;">@Detail</MudText>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }

    <div class="oops-decoration">
        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Style="font-size: 2rem; opacity: 0.1; position: absolute; top: 10%; left: 10%;" />
        <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Style="font-size: 2.5rem; opacity: 0.1; position: absolute; bottom: 15%; right: 15%;" />
        <MudIcon Icon="@Icons.Material.Filled.Help" Color="Color.Info" Style="font-size: 1.8rem; opacity: 0.1; position: absolute; top: 20%; right: 20%;" />
    </div>

</MudContainer>

<style>
    .oops-icon-container {
        position: relative;
        width: 180px;
        height: 180px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .oops-icon {
        animation: float 3s ease-in-out infinite;
    }

    .oops-number {
        animation: pulse 2s ease-in-out infinite;
    }

    .oops-decoration {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        overflow: hidden;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-20px); }
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.6; }
    }

    @@media (max-width: 600px) {
        .oops-icon-container {
            width: 140px;
            height: 140px;
        }

        .oops-icon {
            font-size: 7rem !important;
        }

        .oops-number {
            font-size: 4rem !important;
        }
    }
</style>

@code {
    [Parameter] public string? Detail { get; set; }
    [Parameter] public bool ShowDetails { get; set; }

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private void Reload()
    {
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }
}
