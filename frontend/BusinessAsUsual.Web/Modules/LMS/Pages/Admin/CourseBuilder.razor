@page "/lms/admin/courses/{courseId:guid}/builder"
@rendermode InteractiveServer
@using BusinessAsUsual.Web.Components.Layout
@using BusinessAsUsual.Web.Modules._Shared
@using Platform.Web.Components.Shared
@using global::LMS.Domain.Repositories
@using global::LMS.Domain.Entities
@using BusinessAsUsual.Web.Modules.LMS.Components
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@layout MainLayout
@inherits LMSLandingBase
@inject ICourseRepository CourseRepository
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Course Builder - @(course?.Title ?? "Loading...")</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <PageBreadcrumb Items="_breadcrumbItems" />

    @if (course == null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Class="mt-2">Loading course builder...</MudText>
    }
    else
    {
        <MudPaper Elevation="2" Class="pa-4 mb-4">
            <MudText Typo="Typo.h4" Class="mb-2">
                🎨 Course Builder: @course.Title
            </MudText>
            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(course.Status)">
                @course.Status.ToString()
            </MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Info">
                @course.Difficulty.ToString()
            </MudChip>
        </MudPaper>

        <MudGrid>
            <!-- Left Panel - Course Structure -->
            <MudItem xs="12" md="4">
                <MudPaper Elevation="2" Class="pa-4" Style="height: 70vh; overflow-y: auto;">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudText Typo="Typo.h6">📋 Course Structure</MudText>
                        <MudButton Variant="Variant.Filled" 
                                  Color="Color.Primary" 
                                  Size="Size.Small"
                                  StartIcon="@Icons.Material.Filled.Add"
                                  OnClick="ShowAddModuleDialog">
                            Add Module
                        </MudButton>
                    </MudStack>
                    <MudText Typo="Typo.body2" Class="mb-2" Color="Color.Secondary">
                        @course.Modules.Count modules
                    </MudText>

                    @if (course.Modules?.Any() == true)
                    {
                        @foreach (var module in course.Modules.OrderBy(m => m.OrderIndex))
                        {
                            <MudPaper Elevation="1" Class="pa-3 mb-3">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                    <div style="flex: 1;">
                                        <MudText Typo="Typo.h6">@module.Title</MudText>
                                        <MudText Typo="Typo.body2" Class="mb-2">@module.Description</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Order: @module.OrderIndex
                                        </MudText>
                                    </div>
                                    <MudStack Row="true" Spacing="1">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                      Size="Size.Small" 
                                                      Color="Color.Primary"
                                                      OnClick="@(() => ShowEditModuleDialog(module))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                      Size="Size.Small" 
                                                      Color="Color.Error"
                                                      OnClick="@(() => DeleteModule(module))" />
                                    </MudStack>
                                </MudStack>

                                @if (module.Lessons?.Any() == true)
                                {
                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.caption" Color="Color.Primary">
                                        📖 @module.Lessons.Count lessons
                                    </MudText>
                                    @foreach (var lesson in module.Lessons.OrderBy(l => l.OrderIndex))
                                    {
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-1">
                                            <MudButton Variant="Variant.Text" Size="Size.Small" 
                                                      OnClick="@(() => SelectLesson(lesson))"
                                                      Style="flex: 1; justify-content: flex-start;"
                                                      Color="@(selectedLesson?.Id == lesson.Id ? Color.Primary : Color.Default)">
                                                @lesson.Title
                                            </MudButton>
                                            <MudStack Row="true" Spacing="0">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                              Size="Size.Small" 
                                                              Color="Color.Primary"
                                                              OnClick="@(() => ShowEditLessonDialog(lesson))" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                              Size="Size.Small" 
                                                              Color="Color.Error"
                                                              OnClick="@(() => DeleteLesson(lesson))" />
                                            </MudStack>
                                        </MudStack>
                                    }
                                }

                                <MudButton Variant="Variant.Text" 
                                          Color="Color.Success" 
                                          Size="Size.Small"
                                          StartIcon="@Icons.Material.Filled.Add"
                                          FullWidth="true"
                                          Class="mt-2"
                                          OnClick="@(() => ShowAddLessonDialog(module))">
                                    Add Lesson
                                </MudButton>
                            </MudPaper>
                        }
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">
                            No modules yet. Add your first module to get started!
                        </MudAlert>
                    }
                </MudPaper>
            </MudItem>

            <!-- Right Panel - Content Editor -->
            <MudItem xs="12" md="8">
                <MudPaper Elevation="2" Class="pa-4" Style="height: 70vh; overflow-y: auto;">
                    @if (selectedLesson != null)
                    {
                        <MudText Typo="Typo.h5" Class="mb-3">
                            ✏️ @selectedLesson.Title
                        </MudText>
                        <MudText Typo="Typo.body1" Class="mb-2">@selectedLesson.Description</MudText>
                        <MudDivider Class="my-3" />

                        <MudTabs Elevation="2" Rounded="true" PanelClass="pa-3" @bind-ActivePanelIndex="_activeTabIndex">
                            <MudTabPanel Text="Content Blocks" Icon="@Icons.Material.Filled.Article">


                        @if (selectedLesson.ContentBlocks?.Any() == true)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                                @selectedLesson.ContentBlocks.Count content blocks
                            </MudText>

                            @foreach (var block in selectedLesson.ContentBlocks.OrderBy(b => b.OrderIndex))
                            {
                                <ContentBlockEditor BlockType="@block.BlockType"
                                                   JsonContent="@block.JsonContent"
                                                   CourseId="@CourseId"
                                                   OnDelete="@(() => DeleteBlock(block))"
                                                   OnContentChanged="@((json) => UpdateBlockContent(block, json))" />
                            }

                            <MudStack Row="true" Spacing="2" Class="mt-3">
                                <MudButton Variant="Variant.Outlined" 
                                          Color="Color.Primary" 
                                          StartIcon="@Icons.Material.Filled.Add"
                                          Style="flex: 1;"
                                          OnClick="@(() => AddBlock(ContentBlockType.Text))">
                                    Add Text
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" 
                                          Color="Color.Primary" 
                                          StartIcon="@Icons.Material.Filled.Title"
                                          Style="flex: 1;"
                                          OnClick="@(() => AddBlock(ContentBlockType.Heading))">
                                    Add Heading
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" 
                                          Color="Color.Info" 
                                          StartIcon="@Icons.Material.Filled.Info"
                                          Style="flex: 1;"
                                          OnClick="@(() => AddBlock(ContentBlockType.Callout))">
                                    Add Callout
                                </MudButton>
                            </MudStack>

                            <MudStack Row="true" Spacing="2" Class="mt-2">
                                <MudButton Variant="Variant.Outlined" 
                                          Color="Color.Secondary" 
                                          StartIcon="@Icons.Material.Filled.Image"
                                          Style="flex: 1;"
                                          OnClick="@(() => AddBlock(ContentBlockType.Image))">
                                    Add Image
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" 
                                          Color="Color.Secondary" 
                                          StartIcon="@Icons.Material.Filled.VideoLibrary"
                                          Style="flex: 1;"
                                          OnClick="@(() => AddBlock(ContentBlockType.Video))">
                                    Add Video
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" 
                                          Color="Color.Secondary" 
                                          StartIcon="@Icons.Material.Filled.AttachFile"
                                          Style="flex: 1;"
                                          OnClick="@(() => AddBlock(ContentBlockType.File))">
                                    Add File
                                </MudButton>
                            </MudStack>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Class="mb-3">
                                No content blocks yet. Start building your lesson!
                            </MudAlert>

                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Filled" 
                                          Color="Color.Primary" 
                                          StartIcon="@Icons.Material.Filled.Add"
                                          Style="flex: 1;"
                                          OnClick="@(() => AddBlock(ContentBlockType.Text))">
                                    Add Text
                                </MudButton>
                                <MudButton Variant="Variant.Filled" 
                                          Color="Color.Primary" 
                                          StartIcon="@Icons.Material.Filled.Title"
                                          Style="flex: 1;"
                                          OnClick="@(() => AddBlock(ContentBlockType.Heading))">
                                    Add Heading
                                </MudButton>
                                <MudButton Variant="Variant.Filled" 
                                          Color="Color.Info" 
                                          StartIcon="@Icons.Material.Filled.Info"
                                          Style="flex: 1;"
                                          OnClick="@(() => AddBlock(ContentBlockType.Callout))">
                                    Add Callout
                                </MudButton>
                            </MudStack>

                            <MudStack Row="true" Spacing="2" Class="mt-2">
                                <MudButton Variant="Variant.Filled" 
                                          Color="Color.Secondary" 
                                          StartIcon="@Icons.Material.Filled.Image"
                                          Style="flex: 1;"
                                          OnClick="@(() => AddBlock(ContentBlockType.Image))">
                                    Add Image
                                </MudButton>
                                <MudButton Variant="Variant.Filled" 
                                          Color="Color.Secondary" 
                                          StartIcon="@Icons.Material.Filled.VideoLibrary"
                                          Style="flex: 1;"
                                          OnClick="@(() => AddBlock(ContentBlockType.Video))">
                                    Add Video
                                </MudButton>
                                <MudButton Variant="Variant.Filled" 
                                          Color="Color.Secondary" 
                                          StartIcon="@Icons.Material.Filled.AttachFile"
                                          Style="flex: 1;"
                                          OnClick="@(() => AddBlock(ContentBlockType.File))">
                                    Add File
                                </MudButton>
                            </MudStack>
                        }
                            </MudTabPanel>

                            <MudTabPanel Text="Quizzes" Icon="@Icons.Material.Filled.Quiz">
                                @if (selectedLesson.Quizzes?.Any() == true)
                                {
                                    @foreach (var quiz in selectedLesson.Quizzes.OrderBy(q => q.CreatedAt))
                                    {
                                        <QuizEditor Quiz="@quiz" 
                                                   OnDelete="@(() => DeleteQuiz(quiz))"
                                                   OnChange="@(() => _hasUnsavedChanges = true)" />
                                    }
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Info" Class="mb-3">
                                        No quizzes yet. Add a quiz to assess learner knowledge!
                                    </MudAlert>
                                }

                                <MudButton Variant="Variant.Filled" 
                                          Color="Color.Success" 
                                          StartIcon="@Icons.Material.Filled.Add"
                                          OnClick="AddQuiz">
                                    Add Quiz to Lesson
                                </MudButton>
                            </MudTabPanel>
                        </MudTabs>
                    }
                    else
                    {
                        <MudText Typo="Typo.h5" Align="Align.Center" Class="my-16" Color="Color.Secondary">
                            👈 Select a lesson from the left to view its content
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Elevation="2" Class="pa-4 mt-4">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="flex-grow: 1;">
                    💡 Use the rich-text editor to create and format course content.
                </MudText>
                @if (_hasUnsavedChanges)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">Unsaved Changes</MudChip>
                    <MudButton Variant="Variant.Filled" 
                              Color="Color.Primary" 
                              StartIcon="@Icons.Material.Filled.Save"
                              OnClick="@SaveChanges">
                        💾 Save Changes
                    </MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           OnClick="@(() => Navigation.NavigateTo("/lms/admin/courses"))">
                    Back to Course Management
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</MudContainer>

<!-- Module Dialog -->
<MudDialog @bind-Visible="_showModuleDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(_editingModule == null ? "Add Module" : "Edit Module")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_moduleTitle" 
                      Label="Module Title" 
                      Required="true" 
                      HelperText="Enter a descriptive title for this module"
                      Variant="Variant.Outlined" />
        <MudTextField @bind-Value="_moduleDescription" 
                      Label="Description" 
                      Lines="3"
                      HelperText="Provide a brief overview of what this module covers"
                      Variant="Variant.Outlined" 
                      Class="mt-3" />
        <MudNumericField @bind-Value="_moduleOrderIndex" 
                         Label="Order Index" 
                         HelperText="Position of this module in the course (0-based)"
                         Variant="Variant.Outlined" 
                         Min="0"
                         Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showModuleDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveModule">
            @(_editingModule == null ? "Add Module" : "Save Changes")
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Lesson Dialog -->
<MudDialog @bind-Visible="_showLessonDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(_editingLesson == null ? "Add Lesson" : "Edit Lesson")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_lessonTitle" 
                      Label="Lesson Title" 
                      Required="true" 
                      HelperText="Enter a descriptive title for this lesson"
                      Variant="Variant.Outlined" />
        <MudTextField @bind-Value="_lessonDescription" 
                      Label="Description" 
                      Lines="3"
                      HelperText="Provide a brief overview of what this lesson teaches"
                      Variant="Variant.Outlined" 
                      Class="mt-3" />
        <MudNumericField @bind-Value="_lessonOrderIndex" 
                         Label="Order Index" 
                         HelperText="Position of this lesson in the module (0-based)"
                         Variant="Variant.Outlined" 
                         Min="0"
                         Class="mt-3" />
        <MudNumericField @bind-Value="_lessonDuration" 
                         Label="Estimated Duration (minutes)" 
                         HelperText="How long should this lesson take to complete?"
                         Variant="Variant.Outlined" 
                         Min="1"
                         Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showLessonDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveLesson">
            @(_editingLesson == null ? "Add Lesson" : "Save Changes")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public Guid CourseId { get; set; }

    private Course? course;
    private Lesson? selectedLesson;
    private bool _hasUnsavedChanges = false;
    private int _activeTabIndex = 0;

    private List<PageBreadcrumb.BreadcrumbItem> _breadcrumbItems = new();

    private DialogOptions _dialogOptions = new() 
    { 
        MaxWidth = MaxWidth.Small, 
        FullWidth = true,
        CloseButton = true,
        CloseOnEscapeKey = true
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            course = await CourseRepository.GetWithFullStructureAsync(CourseId);

            _breadcrumbItems = new()
            {
                new() { Text = "Dashboard", Href = "/dashboard" },
                new() { Text = "Learning Management", Href = "/lms" },
                new() { Text = "Admin", Href = "/lms/admin" },
                new() { Text = "Courses", Href = "/lms/admin/courses" },
                new() { Text = course?.Title ?? "Builder", Href = null }
            };
        }
        catch (Exception ex)
        {
            // Handle error - could show a snackbar notification
            Snackbar.Add($"Failed to load course: {ex.Message}", Severity.Error);
            Console.WriteLine($"CourseBuilder error: {ex}");
        }
    }

    private void SelectLesson(Lesson lesson)
    {
        selectedLesson = lesson;
        StateHasChanged();
    }

    private void AddBlock(ContentBlockType blockType)
    {
        if (selectedLesson == null) return;

        var defaultContent = blockType switch
        {
            ContentBlockType.Heading => """{"content": "<h2>Your Heading Here</h2>"}""",
            ContentBlockType.Callout => """{"content": "<p>💡 Important information or tip...</p>"}""",
            ContentBlockType.Image => """{"url": "", "alt": "Image description", "caption": ""}""",
            ContentBlockType.Video => """{"url": "", "thumbnail": "", "duration": 0}""",
            ContentBlockType.File => """{"url": "", "filename": "document.pdf", "size": 0, "mimeType": "application/pdf"}""",
            _ => """{"content": "<p>Start typing your content here...</p>"}"""
        };

        var newBlock = new ContentBlock
        {
            Id = Guid.NewGuid(),
            LessonId = selectedLesson.Id,
            Lesson = selectedLesson,
            BlockType = blockType,
            OrderIndex = selectedLesson.ContentBlocks?.Count ?? 0,
            JsonContent = defaultContent,
            CreatedAt = DateTime.UtcNow,
            CreatedBy = "admin" // TODO: Get from auth context
        };

        selectedLesson.ContentBlocks ??= new List<ContentBlock>();
        selectedLesson.ContentBlocks.Add(newBlock);
        _hasUnsavedChanges = true;
        StateHasChanged();
    }

    private void DeleteBlock(ContentBlock block)
    {
        if (selectedLesson?.ContentBlocks == null) return;

        selectedLesson.ContentBlocks.Remove(block);
        _hasUnsavedChanges = true;
        StateHasChanged();
    }

    private void UpdateBlockContent(ContentBlock block, string json)
    {
        block.JsonContent = json;
        _hasUnsavedChanges = true;
    }

    private void AddQuiz()
    {
        if (selectedLesson == null) return;

        var newQuiz = new global::LMS.Domain.Entities.Quiz
        {
            Id = Guid.NewGuid(),
            LessonId = selectedLesson.Id,
            Lesson = selectedLesson,
            Title = "New Quiz",
            QuizType = global::LMS.Domain.Entities.QuizType.Practice,
            PassingScore = 70,
            ShowResultsImmediately = true,
            AllowReview = true,
            Questions = new List<global::LMS.Domain.Entities.Question>(),
            CreatedAt = DateTime.UtcNow,
            CreatedBy = "admin" // TODO: Get from auth context
        };

        selectedLesson.Quizzes ??= new List<global::LMS.Domain.Entities.Quiz>();
        selectedLesson.Quizzes.Add(newQuiz);
        _hasUnsavedChanges = true;
        StateHasChanged();
    }

    private void DeleteQuiz(global::LMS.Domain.Entities.Quiz quiz)
    {
        if (selectedLesson?.Quizzes == null) return;

        selectedLesson.Quizzes.Remove(quiz);
        _hasUnsavedChanges = true;
        StateHasChanged();
    }

    private async Task SaveChanges()
    {
        if (course == null) return;

        try
        {
            await CourseRepository.UpdateAsync(course);
            _hasUnsavedChanges = false;
            StateHasChanged();
            Snackbar.Add("✅ Course saved successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"❌ Save failed: {ex.Message}", Severity.Error);
        }
    }

    private Color GetStatusColor(CourseStatus status)
    {
        return status switch
        {
            CourseStatus.Published => Color.Success,
            CourseStatus.Draft => Color.Warning,
            CourseStatus.Archived => Color.Default,
            _ => Color.Info
        };
    }

    // Module Management
    private Module? _editingModule;
    private bool _showModuleDialog = false;
    private string _moduleTitle = "";
    private string _moduleDescription = "";
    private int _moduleOrderIndex = 0;

    private void ShowAddModuleDialog()
    {
        _editingModule = null;
        _moduleTitle = "";
        _moduleDescription = "";
        _moduleOrderIndex = course?.Modules?.Count ?? 0;
        _showModuleDialog = true;
        StateHasChanged();
    }

    private void ShowEditModuleDialog(Module module)
    {
        _editingModule = module;
        _moduleTitle = module.Title;
        _moduleDescription = module.Description ?? "";
        _moduleOrderIndex = module.OrderIndex;
        _showModuleDialog = true;
        StateHasChanged();
    }

    private void SaveModule()
    {
        if (string.IsNullOrWhiteSpace(_moduleTitle))
        {
            Snackbar.Add("Module title is required", Severity.Warning);
            return;
        }

        if (_editingModule != null)
        {
            // Edit existing module
            _editingModule.Title = _moduleTitle;
            _editingModule.Description = _moduleDescription;
            _editingModule.OrderIndex = _moduleOrderIndex;
        }
        else
        {
            // Create new module
            var newModule = new Module
            {
                Id = Guid.NewGuid(),
                CourseId = course!.Id,
                Course = course,
                Title = _moduleTitle,
                Description = _moduleDescription,
                OrderIndex = _moduleOrderIndex,
                Lessons = new List<Lesson>(),
                CreatedAt = DateTime.UtcNow,
                CreatedBy = "admin" // TODO: Get from auth context
            };

            course.Modules ??= new List<Module>();
            ((List<Module>)course.Modules).Add(newModule);
        }

        _hasUnsavedChanges = true;
        _showModuleDialog = false;
        StateHasChanged();
    }

    private void DeleteModule(Module module)
    {
        if (course?.Modules == null) return;

        ((List<Module>)course.Modules).Remove(module);
        if (selectedLesson?.ModuleId == module.Id)
        {
            selectedLesson = null;
        }
        _hasUnsavedChanges = true;
        StateHasChanged();
    }

    // Lesson Management
    private Module? _parentModule;
    private Lesson? _editingLesson;
    private bool _showLessonDialog = false;
    private string _lessonTitle = "";
    private string _lessonDescription = "";
    private int _lessonOrderIndex = 0;
    private int _lessonDuration = 15;

    private void ShowAddLessonDialog(Module module)
    {
        _parentModule = module;
        _editingLesson = null;
        _lessonTitle = "";
        _lessonDescription = "";
        _lessonOrderIndex = module.Lessons?.Count ?? 0;
        _lessonDuration = 15;
        _showLessonDialog = true;
        StateHasChanged();
    }

    private void ShowEditLessonDialog(Lesson lesson)
    {
        _parentModule = course?.Modules?.FirstOrDefault(m => m.Id == lesson.ModuleId);
        _editingLesson = lesson;
        _lessonTitle = lesson.Title;
        _lessonDescription = lesson.Description ?? "";
        _lessonOrderIndex = lesson.OrderIndex;
        _lessonDuration = lesson.EstimatedDurationMinutes;
        _showLessonDialog = true;
        StateHasChanged();
    }

    private void SaveLesson()
    {
        if (string.IsNullOrWhiteSpace(_lessonTitle))
        {
            Snackbar.Add("Lesson title is required", Severity.Warning);
            return;
        }

        if (_editingLesson != null)
        {
            // Edit existing lesson
            _editingLesson.Title = _lessonTitle;
            _editingLesson.Description = _lessonDescription;
            _editingLesson.OrderIndex = _lessonOrderIndex;
            _editingLesson.EstimatedDurationMinutes = _lessonDuration;
        }
        else if (_parentModule != null)
        {
            // Create new lesson
            var newLesson = new Lesson
            {
                Id = Guid.NewGuid(),
                ModuleId = _parentModule.Id,
                Module = _parentModule,
                Title = _lessonTitle,
                Description = _lessonDescription,
                OrderIndex = _lessonOrderIndex,
                EstimatedDurationMinutes = _lessonDuration,
                ContentBlocks = new List<ContentBlock>(),
                Quizzes = new List<global::LMS.Domain.Entities.Quiz>(),
                CreatedAt = DateTime.UtcNow,
                CreatedBy = "admin" // TODO: Get from auth context
            };

            _parentModule.Lessons ??= new List<Lesson>();
            ((List<Lesson>)_parentModule.Lessons).Add(newLesson);
        }

        _hasUnsavedChanges = true;
        _showLessonDialog = false;
        StateHasChanged();
    }

    private void DeleteLesson(Lesson lesson)
    {
        var module = course?.Modules?.FirstOrDefault(m => m.Id == lesson.ModuleId);
        if (module?.Lessons == null) return;

        ((List<Lesson>)module.Lessons).Remove(lesson);
        if (selectedLesson?.Id == lesson.Id)
        {
            selectedLesson = null;
        }
        _hasUnsavedChanges = true;
        StateHasChanged();
    }
}
