@page "/lms/my-courses"
@using BusinessAsUsual.Web.Components.Layout
@using BusinessAsUsual.Web.Modules._Shared
@using BusinessAsUsual.Web.Services
@using global::LMS.Domain.Entities
@using global::LMS.Domain.Repositories
@using Microsoft.AspNetCore.Components.Authorization
@using Platform.Web.Components.Shared
@layout MainLayout
@inherits LMSLandingBase
@inject IAssignmentRepository AssignmentRepository
@inject ILearnerProgressRepository ProgressRepository
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My Courses - Learning</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <PageBreadcrumb Items="_breadcrumbItems" />

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.School" Class="mr-2" />
                My Courses
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Track your learning progress and complete assigned courses</MudText>
        </div>
    </div>

@if (isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}
else
{
    @if (assignments.Any())
    {
        <MudGrid>
            @foreach (var assignment in assignments)
            {
                var progress = progressMap.GetValueOrDefault(assignment.CourseId);
                var progressPercent = (decimal)(progress?.ProgressPercentage ?? 0);

                <MudItem xs="12" md="6" lg="4">
                    <MudCard Class="mb-3" Elevation="3">
                        <MudCardContent>
                            <MudText Typo="Typo.h6" Class="mb-2">
                                @assignment.Course?.Title
                            </MudText>

                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                Assigned: @assignment.AssignedDate.ToString("MMM dd, yyyy")
                            </MudText>

                            @if (assignment.DueDate.HasValue)
                            {
                                var daysUntilDue = (assignment.DueDate.Value - DateTime.UtcNow).Days;
                                var dueDateColor = daysUntilDue < 7 ? Color.Error : (daysUntilDue < 14 ? Color.Warning : Color.Success);

                                <MudText Typo="Typo.body2" Color="@dueDateColor" Class="mb-3">
                                    <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Small" Class="mr-1" />
                                    Due: @assignment.DueDate.Value.ToString("MMM dd, yyyy") (@daysUntilDue days)
                                </MudText>
                            }

                            <MudProgressLinear 
                                Color="@GetProgressColor(progressPercent)" 
                                Value="@((double)progressPercent)" 
                                Class="my-2" 
                                Size="Size.Large">
                                <MudText Typo="Typo.body2">@progressPercent.ToString("F0")%</MudText>
                            </MudProgressLinear>

                            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(assignment.Status)" Class="mt-2">
                                @assignment.Status
                            </MudChip>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton 
                                Variant="Variant.Text" 
                                Color="Color.Primary" 
                                StartIcon="@Icons.Material.Filled.PlayArrow"
                                Href="@($"/lms/courses/{assignment.CourseId}")">
                                @(progressPercent > 0 ? "Continue" : "Start Course")
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else
    {
        <MudPaper Class="pa-6 text-center" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
            <MudText Typo="Typo.h6" Color="Color.Secondary">No Course Assignments</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                You don't have any assigned courses at the moment. Check back later or browse the course catalog.
            </MudText>
        </MudPaper>
    }
}
</MudContainer>

@code {
    private bool isLoading = true;
    private List<Assignment> assignments = new();
    private Dictionary<Guid, LearnerProgress> progressMap = new();

    private List<PageBreadcrumb.BreadcrumbItem> _breadcrumbItems = new()
    {
        new() { Text = "Dashboard", Href = "/dashboard" },
        new() 
        { 
            Text = "Learning", 
            Href = "/lms",
            Icon = Icons.Material.Filled.School
        },
        new() { Text = "My Courses", Href = "/lms/my-courses" }
    };

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.Identity?.Name ?? "demo-employee-1";

            // Load assignments from repository
            assignments = (await AssignmentRepository.GetByEmployeeIdAsync(userId)).ToList();

            // Load progress for each course
            foreach (var assignment in assignments)
            {
                var progress = await ProgressRepository.GetByEmployeeAndCourseAsync(userId, assignment.CourseId);
                if (progress != null)
                {
                    progressMap[assignment.CourseId] = progress;
                }
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private Color GetProgressColor(decimal percent)
    {
        if (percent >= 100) return Color.Success;
        if (percent >= 50) return Color.Info;
        if (percent >= 25) return Color.Warning;
        return Color.Default;
    }

    private Color GetStatusColor(AssignmentStatus status) => status switch
    {
        AssignmentStatus.Completed => Color.Success,
        AssignmentStatus.InProgress => Color.Info,
        AssignmentStatus.Overdue => Color.Error,
        _ => Color.Default
    };

    private string GetCourseUrl(Guid courseId)
    {
        return $"/lms/courses/{courseId}";
    }
}

