@* OLD HARDCODED PAGE - Route removed to avoid conflict with injected HR.Web module *@
@* @page "/hr/benefits" *@
@using BusinessAsUsual.Web.Modules.HR.Services
@using BusinessAsUsual.Web.Modules._Shared
@using Platform.Web.Components.Shared
@inherits HRLandingBase
@inject IHRService HRService

<PageTitle>Benefits Management - HR</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <PageBreadcrumb Items="_breadcrumbItems" />

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" Class="mr-2" />
                Benefits Management
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Manage employee benefits and enrollment</MudText>
        </div>
    </div>

<MudGrid>
    @foreach (var benefit in _benefits)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">@benefit.Name</MudText>
                    <MudSwitch T="bool" @bind-Value="benefit.Enabled" Color="Color.Primary" />
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
    </MudGrid>
</MudContainer>

@code {
    private IEnumerable<Benefit> _benefits = Enumerable.Empty<Benefit>();

    private List<PageBreadcrumb.BreadcrumbItem> _breadcrumbItems = new()
    {
        new() { Text = "Dashboard", Href = "/dashboard" },
        new() { Text = "Human Resources", Href = "/hr", Icon = Icons.Material.Filled.People },
        new() { Text = "Benefits Management", Href = "/hr/benefits" }
    };

    protected override async Task OnInitializedAsync()
    {
        _benefits = await HRService.GetBenefitsAsync();
    }
}
