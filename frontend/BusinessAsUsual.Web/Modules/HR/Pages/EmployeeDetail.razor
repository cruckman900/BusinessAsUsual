@page "/hr/employees/{id:guid}"
@page "/hr/employees/details/{id:guid}"
@using BusinessAsUsual.Web.Modules.HR.Services
@using BusinessAsUsual.Web.Modules._Shared
@using Platform.Web.Components.Shared
@inherits HRLandingBase
@inject IHRService HRService
@inject NavigationManager Navigation

<PageTitle>@(employee != null ? $"{employee.FirstName} {employee.LastName}" : "Employee Details") - HR</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <PageBreadcrumb Items="_breadcrumbItems" />

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" />
                @(employee != null ? $"{employee.FirstName} {employee.LastName}" : "Employee Details")
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">View employee information and activity</MudText>
        </div>
    </div>

@if (isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}
else if (employee == null)
{
    <MudAlert Severity="Severity.Error">Employee not found</MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3"
               OnClick="@(() => Navigation.NavigateTo("/hr/directory"))">
        Back to Directory
    </MudButton>
}
else
{
    <MudGrid Spacing="3">
        <!-- Personal Information Card -->
        <MudItem xs="12" md="6">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.h6" GutterBottom="true">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" />
                        @employee.FirstName @employee.LastName
                    </MudText>
                    <MudDivider Class="mb-3" />

                    <MudStack Spacing="2">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Department</MudText>
                            <MudText Typo="Typo.body1">@employee.Department</MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Email</MudText>
                            <MudText Typo="Typo.body1">@employee.Email</MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Employee ID</MudText>
                            <MudText Typo="Typo.body2" Style="font-family: monospace;">@employee.Id</MudText>
                        </div>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Quick Actions Card -->
        <MudItem xs="12" md="6">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.h6" GutterBottom="true">
                        <MudIcon Icon="@Icons.Material.Filled.Functions" Class="mr-2" />
                        Quick Actions
                    </MudText>
                    <MudDivider Class="mb-3" />

                    <MudStack Spacing="2">
                        <MudButton Variant="Variant.Outlined" 
                                   Color="Color.Primary" 
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   FullWidth="true"
                                   Disabled="true">
                            Edit Employee
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" 
                                   Color="Color.Info" 
                                   StartIcon="@Icons.Material.Filled.Schedule"
                                   FullWidth="true"
                                   Disabled="true">
                            View Schedule
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" 
                                   Color="Color.Success" 
                                   StartIcon="@Icons.Material.Filled.Assessment"
                                   FullWidth="true"
                                   Disabled="true">
                            Performance Review
                        </MudButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Recent Activity Card -->
        <MudItem xs="12">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.h6" GutterBottom="true">
                        <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" />
                        Recent Activity
                    </MudText>
                    <MudDivider Class="mb-3" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        No recent activity to display.
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Action Buttons -->
        <MudItem xs="12">
            <MudPaper Elevation="2" Class="pa-4">
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Text" Color="Color.Default" 
                               OnClick="@(() => Navigation.NavigateTo("/hr/directory"))">
                        Back to Directory
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
}
</MudContainer>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Employee? employee;
    private bool isLoading = true;

    private List<PageBreadcrumb.BreadcrumbItem> _breadcrumbItems = new();

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _breadcrumbItems = new()
        {
            new() { Text = "Dashboard", Href = "/dashboard" },
            new() { Text = "Human Resources", Href = "/hr", Icon = Icons.Material.Filled.People },
            new() { Text = "Employee Directory", Href = "/hr/directory" },
            new() { Text = "Employee Details", Href = $"/hr/employees/{Id}" }
        };
    }

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();
        await LoadEmployee();
    }

    private async Task LoadEmployee()
    {
        isLoading = true;
        try
        {
            employee = await HRService.GetEmployeeByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading employee: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
