@* OLD HARDCODED PAGE - Route removed to avoid conflict with injected HR.Web module *@
@* @page "/hr" *@
@using BusinessAsUsual.Web.Components.Layout
@using BusinessAsUsual.Web.Modules._Shared
@using Platform.Web.Components.Shared
@layout MainLayout
@inherits HRLandingBase

<PageTitle>Human Resources - BusinessAsUsual</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2 pa-0">
    <PageBreadcrumb Items="_breadcrumbItems" />

    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />
                Human Resources
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Manage employee onboarding, directory, and benefits</MudText>
        </div>
    </div>

<MudGrid>
    <MudItem xs="12" sm="6" md="4">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6">Onboard Employee</MudText>
                <MudText Typo="Typo.body2">Start the onboarding process for a new hire.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/hr/onboarding">
                    Open
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6">Employee Directory</MudText>
                <MudText Typo="Typo.body2">Browse and manage employee records.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/hr/directory">
                    Open
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6">Benefits</MudText>
                <MudText Typo="Typo.body2">Manage employee benefits and enrollment.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/hr/benefits">
                    Open
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>
</MudContainer>

@code {
    private List<PageBreadcrumb.BreadcrumbItem> _breadcrumbItems = new()
    {
        new() { Text = "Dashboard", Href = "/dashboard" },
        new() { Text = "Human Resources", Href = "/hr", Icon = Icons.Material.Filled.People }
    };
}
