<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Business As Usual Admin</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Theme CSS -->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />

    <style>
        /* Static Obsidian theme for splash */
        body {
            background-color: #0a0e27;
            color: #e0e0e0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .splash-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 2rem 0;
        }

        .splash-content {
            flex: 1;
        }

        .splash-footer {
            margin-top: auto;
            padding: 2rem 0;
            border-top: 1px solid #333;
            text-align: center;
            opacity: 0.7;
        }
    </style>
</head>
<body>
    <div class="splash-container">
        <div class="container splash-content">
            @RenderBody()
        </div>

        <footer class="splash-footer">
            <div class="container">
                <p class="mb-0">
                    <small>&copy; @DateTime.Now.Year Business As Usual - Admin Portal</small>
                </p>
            </div>
        </footer>
    </div>

    <!-- Login Modal -->
    @await Html.PartialAsync("_LoginModal")

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
