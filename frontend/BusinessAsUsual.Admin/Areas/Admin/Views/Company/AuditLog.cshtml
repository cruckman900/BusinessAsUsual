@model BusinessAsUsual.Admin.Areas.Admin.Models.AuditLogViewModel
@{
    ViewData["Title"] = $"Audit Log - {Model.CompanyName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Audit Log</h2>
        <p class="text-muted mb-0">
            <i class="fas fa-building me-1"></i>@Model.CompanyName
        </p>
    </div>
    <a asp-area="Admin" asp-controller="Company" asp-action="ViewCompanies" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to Companies
    </a>
</div>

<!-- Filters -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Company" asp-action="AuditLog" asp-route-id="@Model.CompanyId" method="get">
            <div class="row g-3">
                <div class="col-md-3">
                    <label for="eventTypeFilter" class="form-label fw-bold">Event Type</label>
                    <select name="eventTypeFilter" id="eventTypeFilter" class="form-select" asp-for="EventTypeFilter">
                        <option value="">All Events</option>
                        <option value="Created">Created</option>
                        <option value="Updated">Updated</option>
                        <option value="Archived">Archived</option>
                        <option value="Restored">Restored</option>
                        <option value="Merged">Merged</option>
                        <option value="Deleted">Deleted</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="startDate" class="form-label fw-bold">Start Date</label>
                    <input type="date" name="startDate" id="startDate" class="form-control" 
                           value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3">
                    <label for="endDate" class="form-label fw-bold">End Date</label>
                    <input type="date" name="endDate" id="endDate" class="form-control" 
                           value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="fas fa-filter me-1"></i>Filter
                    </button>
                    <a asp-area="Admin" asp-controller="Company" asp-action="AuditLog" asp-route-id="@Model.CompanyId" 
                       class="btn btn-outline-secondary">
                        <i class="fas fa-times me-1"></i>Clear
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Audit Entries -->
<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            <i class="fas fa-history me-2"></i>Audit History 
            <span class="badge bg-light text-dark ms-2">@Model.AuditEntries.Count entries</span>
        </h5>
    </div>
    <div class="card-body p-0">
        @if (Model.AuditEntries.Any())
        {
            <div class="timeline">
                @foreach (var entry in Model.AuditEntries)
                {
                    <div class="timeline-entry">
                        <div class="timeline-marker">
                            <i class="fas fa-circle"></i>
                        </div>
                        <div class="timeline-content">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge @entry.BadgeClass me-2">@entry.EventType</span>
                                    <strong>@entry.Description</strong>
                                </div>
                                <small class="text-muted">@entry.TimestampDisplay</small>
                            </div>
                            <p class="mb-1">
                                <i class="fas fa-user me-1"></i>
                                <span class="text-muted">Performed by:</span> @entry.PerformedBy
                            </p>
                            @if (!string.IsNullOrEmpty(entry.Details))
                            {
                                <details class="mt-2">
                                    <summary class="text-muted" style="cursor: pointer;">
                                        <i class="fas fa-info-circle me-1"></i>View Details
                                    </summary>
                                    <pre class="mt-2 p-2 bg-light border rounded"><code>@entry.Details</code></pre>
                                </details>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted">No audit entries found for the selected filters.</p>
                <a asp-area="Admin" asp-controller="Company" asp-action="AuditLog" asp-route-id="@Model.CompanyId" 
                   class="btn btn-sm btn-outline-primary">
                    <i class="fas fa-times me-1"></i>Clear Filters
                </a>
            </div>
        }
    </div>
</div>

<style>
    /* Theme-aware styling */
    .card {
        border-color: var(--border);
    }

    .card-body {
        background-color: var(--card-bg);
        color: var(--content-text);
    }

    .card-header {
        border-bottom: 1px solid var(--border);
    }

    .text-muted {
        color: var(--content-text) !important;
        opacity: 0.7;
    }

    /* Timeline styling */
    .timeline {
        position: relative;
        padding: 1.5rem;
    }

    .timeline::before {
        content: '';
        position: absolute;
        left: 2rem;
        top: 0;
        bottom: 0;
        width: 2px;
        background: var(--border);
    }

    .timeline-entry {
        position: relative;
        padding-left: 3rem;
        padding-bottom: 2rem;
        margin-left: 1rem;
    }

    .timeline-entry:last-child {
        padding-bottom: 0;
    }

    .timeline-marker {
        position: absolute;
        left: -0.4rem;
        top: 0.3rem;
        width: 1rem;
        height: 1rem;
        background: var(--card-bg);
        border: 2px solid var(--primary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .timeline-marker i {
        font-size: 0.4rem;
        color: var(--primary);
    }

    .timeline-content {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0.375rem;
        padding: 1rem;
        color: var(--content-text);
    }

    .timeline-content strong {
        color: var(--content-text);
    }

    .timeline-content p {
        color: var(--content-text);
    }

    .bg-light {
        background-color: var(--card-bg) !important;
        border-color: var(--border) !important;
        color: var(--content-text) !important;
    }

    details summary {
        user-select: none;
    }

    details[open] summary {
        margin-bottom: 0.5rem;
    }

    pre {
        margin: 0;
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    code {
        color: var(--content-text);
        background-color: var(--card-bg);
    }
</style>
