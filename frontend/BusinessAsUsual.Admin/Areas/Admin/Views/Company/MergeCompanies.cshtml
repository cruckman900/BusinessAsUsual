@model BusinessAsUsual.Admin.Areas.Admin.Models.MergeCompaniesViewModel
@{
    ViewData["Title"] = "Merge Companies";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Merge Companies</h2>
    <a asp-area="Admin" asp-controller="Company" asp-action="ViewCompanies" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to Companies
    </a>
</div>

<!-- Warning Banner -->
<div class="alert alert-danger shadow-sm mb-4" role="alert">
    <h5 class="alert-heading">
        <i class="fas fa-exclamation-triangle me-2"></i>Critical Operation
    </h5>
    <p class="mb-0">
        Merging companies is a <strong>permanent operation</strong> that cannot be undone. 
        All selected data and users will be transferred from the source company to the target company.
    </p>
</div>

<!-- Merge Form -->
<form asp-area="Admin" asp-controller="Company" asp-action="MergeCompanies" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <!-- Company Selection -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-building me-2"></i>Select Companies</h5>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-6">
                    <label asp-for="SourceCompanyId" class="form-label fw-bold">
                        Source Company
                        <small class="text-muted">(will be merged into target)</small>
                    </label>
                    <select asp-for="SourceCompanyId" class="form-select" required>
                        <option value="">-- Select Source Company --</option>
                        @foreach (var company in Model.AvailableCompanies)
                        {
                            <option value="@company.CompanyId">@company.Name (@company.BillingPlan)</option>
                        }
                    </select>
                    <span asp-validation-for="SourceCompanyId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TargetCompanyId" class="form-label fw-bold">
                        Target Company
                        <small class="text-muted">(will receive the merge)</small>
                    </label>
                    <select asp-for="TargetCompanyId" class="form-select" required>
                        <option value="">-- Select Target Company --</option>
                        @foreach (var company in Model.AvailableCompanies)
                        {
                            <option value="@company.CompanyId">@company.Name (@company.BillingPlan)</option>
                        }
                    </select>
                    <span asp-validation-for="TargetCompanyId" class="text-danger"></span>
                </div>
            </div>

            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Note:</strong> Only active companies are available for merging. 
                Archived companies must be restored before they can participate in a merge operation.
            </div>
        </div>
    </div>

    <!-- Merge Options -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="fas fa-cog me-2"></i>Merge Options</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="TransferUsers" class="form-check-input" type="checkbox" />
                    <label asp-for="TransferUsers" class="form-check-label fw-bold">
                        Transfer All Users
                    </label>
                </div>
                <small class="text-muted ms-4">
                    Move all user accounts from the source company to the target company.
                </small>
            </div>

            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="TransferData" class="form-check-input" type="checkbox" />
                    <label asp-for="TransferData" class="form-check-label fw-bold">
                        Transfer All Data
                    </label>
                </div>
                <small class="text-muted ms-4">
                    Move all tenant data (documents, records, settings) to the target company.
                </small>
            </div>

            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="ArchiveSource" class="form-check-input" type="checkbox" />
                    <label asp-for="ArchiveSource" class="form-check-label fw-bold">
                        Archive Source Company After Merge
                    </label>
                </div>
                <small class="text-muted ms-4">
                    Recommended: Prevents accidental access to the source company after merge.
                </small>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label fw-bold">Merge Notes</label>
                <textarea asp-for="Notes" class="form-control" rows="3" 
                          placeholder="Add any notes about this merge operation (optional)..."></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex justify-content-between mb-5">
        <a asp-area="Admin" asp-controller="Company" asp-action="ViewCompanies" class="btn btn-secondary btn-lg text-nowrap">
            <i class="fas fa-times me-2"></i>Cancel
        </a>
        <button type="submit" class="btn btn-danger btn-lg text-nowrap">
            <i class="fas fa-code-branch me-2"></i>Merge Companies
        </button>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        // Prevent selecting the same company for source and target
        document.getElementById('SourceCompanyId').addEventListener('change', function() {
            const sourceId = this.value;
            const targetSelect = document.getElementById('TargetCompanyId');

            Array.from(targetSelect.options).forEach(option => {
                if (option.value === sourceId && option.value !== '') {
                    option.disabled = true;
                } else {
                    option.disabled = false;
                }
            });
        });

        document.getElementById('TargetCompanyId').addEventListener('change', function() {
            const targetId = this.value;
            const sourceSelect = document.getElementById('SourceCompanyId');

            Array.from(sourceSelect.options).forEach(option => {
                if (option.value === targetId && option.value !== '') {
                    option.disabled = true;
                } else {
                    option.disabled = false;
                }
            });
        });
    </script>
}

<style>
    /* Theme-aware styling */
    .card {
        border-color: var(--border);
    }

    .card-body {
        background-color: var(--card-bg);
        color: var(--content-text);
    }

    .card-header {
        border-bottom: 1px solid var(--border);
    }

    .text-muted {
        color: var(--content-text) !important;
        opacity: 0.7;
    }

    .form-check-input[type="checkbox"] {
        cursor: pointer;
    }

    .form-check-label {
        cursor: pointer;
    }

    .alert {
        border-color: var(--border);
    }

    select.form-select option:disabled {
        color: #999;
        font-style: italic;
    }
</style>
