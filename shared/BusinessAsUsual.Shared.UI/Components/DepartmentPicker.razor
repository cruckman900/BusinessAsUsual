@using MudBlazor
@using HR.Application.Services
@using HR.Application.DTOs
@inject IDepartmentService DepartmentService

<MudAutocomplete T="DepartmentDto"
                 Value="@SelectedDepartment"
                 ValueChanged="@(async (DepartmentDto d) => await OnDepartmentSelected(d))"
                 SearchFunc="SearchDepartments"
                 ToStringFunc="@(d => d?.Name ?? "")"
                 Label="@Label"
                 Variant="@Variant"
                 Margin="@Margin"
                 Dense="@Dense"
                 Required="@Required"
                 RequiredError="@RequiredError"
                 Disabled="@Disabled"
                 ResetValueOnEmptyText="false"
                 CoerceText="false"
                 CoerceValue="false"
                 AdornmentIcon="@Icons.Material.Filled.Search"
                 AdornmentColor="Color.Primary"
                 Clearable="true"
                 DebounceInterval="300"
                 MinCharacters="0"
                 MaxItems="20"
                 ShowProgressIndicator="true">
    <ItemTemplate Context="department">
        <MudStack Spacing="0">
            <MudText Typo="Typo.body2"><b>@department.Name</b></MudText>
            @if (!string.IsNullOrWhiteSpace(department.Description))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@department.Description</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(department.Location))
            {
                <MudText Typo="Typo.caption" Color="Color.Info">
                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" /> @department.Location
                </MudText>
            }
        </MudStack>
    </ItemTemplate>
    <NoItemsTemplate>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @if (_departmentsLoaded && _allDepartments.Any())
            {
                <text>Type to search departments...</text>
            }
            else if (!_departmentsLoaded)
            {
                <text>Loading departments...</text>
            }
            else
            {
                <text>No departments available</text>
            }
        </MudText>
    </NoItemsTemplate>
</MudAutocomplete>

@code {
    [Parameter] public DepartmentDto? SelectedDepartment { get; set; }
    [Parameter] public EventCallback<DepartmentDto?> SelectedDepartmentChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Select Department";
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.Dense;
    [Parameter] public bool Dense { get; set; } = true;
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public string RequiredError { get; set; } = "Department is required";
    [Parameter] public bool Disabled { get; set; } = false;

    private List<DepartmentDto> _allDepartments = new();
    private bool _departmentsLoaded = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDepartmentsAsync();
    }

    private async Task OnDepartmentSelected(DepartmentDto? department)
    {
        SelectedDepartment = department;
        await SelectedDepartmentChanged.InvokeAsync(department);
    }

    private async Task LoadDepartmentsAsync()
    {
        if (_departmentsLoaded) return;

        try
        {
            var response = await DepartmentService.GetAllDepartmentsAsync();
            _allDepartments = response.ToList();
            _departmentsLoaded = true;
        }
        catch (Exception)
        {
            _allDepartments = new List<DepartmentDto>();
        }
    }

    private async Task<IEnumerable<DepartmentDto>> SearchDepartments(string? searchText, CancellationToken cancellationToken)
    {
        await LoadDepartmentsAsync();

        // Show top 20 if no search text or just clicked
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return _allDepartments
                .OrderBy(d => d.Name)
                .Take(20);
        }

        // Case-insensitive LIKE search across Name, Description, Location
        var search = searchText.Trim();
        return _allDepartments
            .Where(d => d.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                       (d.Description?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                       (d.Location?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false))
            .OrderBy(d => d.Name.StartsWith(search, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
            .ThenBy(d => d.Name)
            .Take(20)
            .ToList();
    }
}
